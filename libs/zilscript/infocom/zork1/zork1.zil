;"Settings"

<CONSTANT RELEASEID 1>
<VERSION ZIP>
<FREQUENT-WORDS?>
<SETG ZORK-NUMBER 1>

;"Default Property Values"

<PROPDEF SIZE 5>
<PROPDEF CAPACITY 0>
<PROPDEF VALUE 0>
<PROPDEF TVALUE 0>

;"Substrate"

<INSERT-FILE "main">
<INSERT-FILE "clock">
<INSERT-FILE "parser">
<INSERT-FILE "syntax">
<INSERT-FILE "macros">
<INSERT-FILE "verbs">
<INSERT-FILE "globals">

;"Script"

<INSERT-FILE "dungeon">
<INSERT-FILE "actions">
