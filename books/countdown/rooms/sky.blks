    <prefab source="characters/person" pos="250 -350 0" rot="0 0 35" pose="Panic" color="0.36 0.50 0.36" />
    <prefab source="characters/person" pos="250 700 0" rot="0 0 175" pose="Kneel" color="0.30 0.42 0.56" />
