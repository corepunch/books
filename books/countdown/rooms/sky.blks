  </group>
  <prefab source="characters/clark" name="Clark" pos="{CLARK_X} 0 {PARK}" />
  <prefab source="characters/lana" name="Lana" pos="{LANA_X} 0 {PARK}" />
  <prefab source="characters/superman" name="Superman" pos="{HERO_X} 0 {PARK}" />

  <!-- Brainiac's ship and its states, in the ship's own frame (origin at the hull centre, skull toward local -Y).
       Its pos and rot stay plain numbers: the anchors below inherit them in the book engine. -->
  <group name="ShipFrame" pos="600 11400 5000" rot="0 0 -20">
    <!-- The ship hovers by the story; the checker cannot see what holds it up. -->
    <prefab source="props/brainiac_ship" name="Ship" sanityIgnore="1" />
    <!-- Anchors on the ship: the skull's brow, the airlock lens and the front-right tentacle at its fifth link. -->
    <group name="Ship-Spot" pos="0 -2000 300" />
    <group name="Airlock" pos="0 0 -2090" />
    <group name="Tentacles" pos="1865 -773 -2380" />
    <!-- Camera-scoped states, stored at PARK below the ship. -->
    <group name="XrayShip" pos="40000 0 {PARK}"><prefab source="sky/ship_xray" /></group>
    <!-- The airlock opens: the iris glows through and a red light floods the tentacles. -->
    <group name="LockOpen" pos="32000 0 {PARK}">
      <cylinder pos="0 0 -2082" rot="90 0 0" radius="520" height="8" sides="48" material="sun_red" unlit="1" castShadow="0" />
      <light pos="0 0 -2300" color="1.0 0.22 0.12" intensity="2.2" radius="2600" castShadows="1" />
    </group>
    <!-- The emitter burst by heat vision: a charred plug over the iris, smoke and embers; and the glowing ring
         Superman is cutting in the hull's front-left flank. -->
    <group name="Breach" pos="24000 0 {PARK}">
      <group name="BurntLock">
      <cylinder pos="0 0 -2088" rot="90 0 0" radius="600" height="10" sides="40" material="char" />
      <sphere pos="120 -80 -2380" radius="240" rings="14" slices="18" material="smoke"><noise strength="0.18" seed="2" /></sphere>
      <sphere pos="-180 60 -2700" radius="300" rings="14" slices="18" material="smoke"><noise strength="0.22" seed="4" /></sphere>
      <sphere pos="40 -260 -3120" radius="360" rings="14" slices="18" material="smoke"><noise strength="0.26" seed="6" /></sphere>
      <sphere pos="200 100 -2120" radius="40" material="fire" unlit="1" castShadow="0" />
      <sphere pos="-150 -120 -2130" radius="30" material="fire" unlit="1" castShadow="0" />
      </group>
      <group rot="0 0 236"><group rot="0 26 0">
        <torus pos="{2000 + 6} 0 0" rot="0 0 90" majorRadius="170" minorRadius="16" majorSegments="40" material="heat" unlit="1" castShadow="0" />
        <cylinder pos="{2000 + 2} 0 0" rot="0 0 90" radius="150" height="10" sides="32" material="char" />
        <light pos="{2000 + 120} 0 0" color="1.0 0.50 0.20" intensity="1.2" radius="900" castShadows="0" />
      </group></group>
    </group>
  </group>

  <!-- The front tentacle's tip has Superman round the waist (ship-show-tentacles; his place is set by the
       camera at -115 8086 2515). -->
  <group name="Grip" pos="0 0 {PARK}">
    <torus pos="-115 8086 2620" rot="90 0 0" majorRadius="30" minorRadius="13" material="tentacle" />
    <torus pos="-115 8086 2644" rot="84 0 30" majorRadius="31" minorRadius="12" material="tentacle" />
