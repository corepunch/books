    <cylinder pos="301 11166 2150" rot="-90.0 0 -0.0" radius="7" height="1480" sides="10" material="beam_red" unlit="1" castShadow="0" />
    <cylinder pos="476 11094 2150" rot="-90.0 0 -0.0" radius="5" height="1480" sides="10" material="beam_red" unlit="1" castShadow="0" />
    <cylinder pos="653 11024 2150" rot="-90.0 0 -0.0" radius="7" height="1480" sides="10" material="beam_red" unlit="1" castShadow="0" />
    <cylinder pos="803 11140 2150" rot="-90.0 0 -0.0" radius="5" height="1480" sides="10" material="beam_red" unlit="1" castShadow="0" />
    <cylinder pos="952 11258 2150" rot="-90.0 0 -0.0" radius="7" height="1480" sides="10" material="beam_red" unlit="1" castShadow="0" />
    <torus pos="600 11400 2610" rot="90 0 0" majorRadius="360" minorRadius="6" majorSegments="40" minorSegments="6" material="beam_red" unlit="1" castShadow="0" />
    <torus pos="600 11400 2160" rot="90 0 0" majorRadius="360" minorRadius="6" majorSegments="40" minorSegments="6" material="beam_red" unlit="1" castShadow="0" />
    <torus pos="600 11400 1660" rot="90 0 0" majorRadius="360" minorRadius="6" majorSegments="40" minorSegments="6" material="beam_red" unlit="1" castShadow="0" />
    <light pos="600 11400 2460" color="1.0 0.20 0.10" intensity="2.4" radius="1400" castShadows="1" />
  </group>

  <!-- Ending: the guns' starbolts strike the embankment, where two apartment blocks burn (ship-starbolts). -->
  <group name="Starbolts" pos="48000 0 {PARK}">
    <cylinder pos="-2168 11713 2433" rot="-55.2 0 31.7" radius="22" height="9582" sides="10" material="starbolt" unlit="1" castShadow="0" />
