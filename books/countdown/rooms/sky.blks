  <!-- The red-sun beam: a cage of red light from the airlock lens down past Superman (ship-red-beam). -->
  <group name="RedBeam" pos="16000 0 {PARK}">
    <cylinder pos="927 11446 2150" rot="-90.0 0 -0.0" radius="5" height="1480" sides="10" material="beam_red" unlit="1" castShadow="0" />
