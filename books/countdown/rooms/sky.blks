  <!-- People. Each crowd state is its own group: the Star Watch couples stand on the lawn by default; the
       fleeing crowd and the listening crowd are stored at PARK until their cameras raise them. Clark, Lana
       and Superman are stored at PARK unrotated, so every camera's transform gives their world offset and
       facing directly. -->
  <group name="Couples">
    <prefab source="characters/person" attach="BenchWest:place_a" pose="Sit" color="0.52 0.30 0.30" />
    <prefab source="characters/person" attach="BenchWest:place_b" pose="Sit" color="0.70 0.62 0.40" />
    <prefab source="characters/person" attach="BenchEast:place_a" pose="Sit" color="0.36 0.50 0.36" />
    <prefab source="characters/person" attach="BenchEast:place_b" pose="Sit" color="0.60 0.36 0.56" />
    <prefab source="characters/person" pos="463 1180 0" rot="0 0 190" pose="Crouch" color="0.30 0.42 0.56" />
    <prefab source="characters/person" pos="750 1350 0" rot="0 0 200" pose="Point" color="0.78 0.74 0.66" />
    <prefab source="characters/person" pos="2050 3050 0" rot="0 0 215" color="0.46 0.34 0.24" />
  </group>
  <group name="Panic" pos="0 0 {PARK}">
    <prefab source="characters/person" pos="-1000 -650 0" rot="0 0 -15" pose="Panic" color="0.52 0.30 0.30" />
