  </group>

  <!-- Far off, the ship is a falling star over the city (obs-show-lana only). -->
  <group name="FallingStar" pos="0 0 {PARK}">
    <sphere pos="9000 60000 18000" radius="360" color="1.0 0.94 0.80" unlit="1" castShadow="0" />
    <cylinder pos="{9000 - 3000*sin(rad(28))} 60000 {18000 + 3000*cos(rad(28))}" rot="90 -28 0" radius="90" height="6000" sides="10" color="1.0 0.80 0.56" unlit="1" castShadow="0"><taper amount="-0.85" /></cylinder>
  </group>
  <!-- Heat vision: two beams from Superman's eyes to the ring in the hull (ship-breach). Filled in below. -->
  <group name="HeatVision" pos="56000 0 {PARK}">
    <cylinder pos="-1581 9628 4121" rot="-0.4 0 -44.4" radius="2.2" height="2028" sides="10" material="heat" unlit="1" castShadow="0" />
    <cylinder pos="-1571 9619 4127" rot="-0.0 0 -45.6" radius="2.2" height="2028" sides="10" material="heat" unlit="1" castShadow="0" />
