    <prefab source="characters/person" pos="500 2200 0" rot="0 0 5" pose="Panic" color="0.40 0.40 0.62" />
  </group>
  <group name="Calm" pos="20000 0 {PARK}">
    <prefab source="characters/person" pos="-850 1150 0" rot="0 0 121" color="0.52 0.30 0.30" />
