<?xml version='1.0' encoding='UTF-8'?>
<!-- Обратный отсчёт: Mt. Royal Observatory above Metropolis at 8 P.M., and the sky over the city when Brainiac's
     ship arrives. Z up, cm, X east, Y north.
     Resident story: the observatory holds its charity Star Watch tonight. Volunteers carried telescopes out onto
     the hilltop lawn (z=0) by the lookout parapet, the park lamps are lit, couples sit on the benches and the big
     refractor looks out of the dome's open slit. Below the lookout the hill falls 30 m to the river road; across
     the river (north bank from y=13000) Metropolis rises, the Daily Planet's globe among its towers.
     Brainiac's ship is a 40 m sphere whose belly hangs 60 m over the river, its centre (ShipFrame) at
     600 11400 5000, its skull turned 20 degrees west of south toward the hill. Far off (the FallingStar group)
     it is a streak in the north-east sky.
     Key light is the moon, low in the west-south-west; a warm shadowless glow from the city lights the
     undersides; the park lamps, the observatory porch and the ship's red airlock are practicals.
     Camera-scoped sets: actors and alternative crowds are stored 200 m underground (z = PARK) where nothing can
     see them, and each camera's transforms bring its own set up to the lawn or the sky. Cameras and anchors
     use plain numbers because the book engine reads them without evaluating expressions. -->
<scene up="z" ambient="0.15 0.16 0.24" background="0.05 0.07 0.16">
  <let name="CITY" value="-3000" />      <!-- street level of Metropolis -->
  <let name="RIVER_S" value="9600" />    <!-- south bank of the river -->
  <let name="RIVER_N" value="13000" />   <!-- north bank -->
  <let name="WATER" value="CITY - 220" /> <!-- river surface -->
  <let name="HILL_R" value="9200" />     <!-- hill foot radius -->
  <let name="LAWN_R" value="4300" />     <!-- lawn plateau radius -->
  <let name="PARK" value="-20000" />     <!-- storage depth for camera-scoped sets -->
  <let name="CLARK_X" value="60000" />   <!-- storage spots of the actors, PARK deep -->
  <let name="LANA_X" value="70000" />
  <let name="HERO_X" value="80000" />

  <!-- Cameras. Lawn shots look north-north-east from the south-west of the lawn; sky shots stay on the
       hill's side of the ship so the skull, the airlock and the city share a frame. -->
  <camera name="obs-show-lana" comment="The Star Watch: at the lookout parapet Lana takes Clark's arm and points at a falling star in the sky over the city" pos="-1080 3000 135" look="-300 5200 680" fov="50" textRect="0.04 0.035 0.92 0.26" textScale="1">
    <transform target="Clark" pos="{-760 - CLARK_X} 3655 {-PARK}" rot="0 0 170" />
    <transform target="Lana" pos="{-880 - LANA_X} 3630 {-PARK}" rot="0 0 172" />
    <use-pose instance="Lana" name="StarPoint" />
    <transform target="ShipFrame" pos="0 0 -70000" />
    <transform target="FallingStar" pos="0 0 {-PARK}" />
  </camera>
  <camera name="obs-show-ship" comment="The ship hangs over Metropolis, tentacles down, skull turned to the hill; on the lawn the stargazers run, one has fallen by a telescope; Clark stands by the middle telescope with Lana pointing; the observatory on the left" pos="-800 -1700 160" look="-200 9000 2600" fov="66" textRect="0.04 0.035 0.92 0.22" textScale="1">
    <transform target="Couples" pos="0 0 {PARK}" />
    <transform target="Panic" pos="0 0 {-PARK}" />
    <transform target="Clark" pos="{180 - CLARK_X} 1420 {-PARK}" rot="0 0 175" />
    <transform target="Lana" pos="{380 - LANA_X} 1560 {-PARK}" rot="0 0 172" />
    <use-pose instance="Lana" name="Point" />
  </camera>
  <camera name="obs-calm" comment="Clark stands on a bench and calls to the crowd; the people stop and turn to him, Lana amazed" pos="-380 400 95" look="-330 1500 330" fov="58" textRect="0.04 0.035 0.92 0.26" textScale="1">
    <transform target="Couples" pos="0 0 {PARK}" />
    <transform target="Calm" pos="-20000 0 {-PARK}" />
    <transform target="Clark" pos="{-350 - CLARK_X} 1450 {46 - PARK}" rot="0 0 10" />
    <use-pose instance="Clark" name="Wave" />
    <transform target="Lana" pos="{0 - LANA_X} 1150 {-PARK}" rot="0 0 -131" />
    <use-pose instance="Lana" name="Reveal" />
  </camera>
  <camera name="ship-show-belly" comment="X-ray vision over Clark's shoulder: the ship turned to pale hoops, the airlock lens and above it the Red Sun Room with the red globe burning" pos="-905 3470 112" look="600 11400 4300" fov="34" textRect="0.04 0.035 0.92 0.26" textScale="1">
    <transform target="Clark" pos="{-930 - CLARK_X} 3610 {-PARK}" rot="0 0 168" />
    <transform target="Ship" pos="0 0 {PARK}" />
    <transform target="XrayShip" pos="-40000 0 {-PARK}" />
  </camera>
  <camera name="ship-show-tentacles" comment="Under the ship: the front tentacle has Superman round the waist and he pries at the coil; the other tentacles hang and lash, the airlock opens red, the city lies far below" pos="-500 7500 2300" look="700 10500 3150" fov="62" textRect="0.04 0.035 0.92 0.24" textScale="1">
    <transform target="Superman" pos="{-115 - HERO_X} 8086 {2515 - PARK}" rot="0 0 -30" />
    <use-pose instance="Superman" name="HandsOnHips" />
    <use-pose instance="Ship" name="ShipGrip" />
    <transform target="Grip" pos="0 0 {-PARK}" />
    <transform target="LockOpen" pos="-32000 0 {-PARK}" />
  </camera>
  <camera name="ship-tentacles" comment="Superman has torn the front tentacle in two and holds the stump over his head; the severed end falls away toward the river" pos="143 8753 2172" look="900 9700 2700" fov="66" textRect="0.04 0.035 0.92 0.24" textScale="1">
    <transform target="Superman" pos="{703 - HERO_X} 9165 {2290 - PARK}" rot="0 0 -30" />
    <use-pose instance="Superman" name="Lift" />
    <use-pose instance="Ship" name="ShipTorn" />
    <transform target="Torn" pos="-8000 0 {-PARK}" />
    <transform target="LockOpen" pos="-32000 0 {-PARK}" />
  </camera>
  <camera name="ship-red-beam" comment="The red-sun beam pours from the airlock; Superman hangs limp in it, on his back, and is drawn up" pos="50 10850 1750" look="600 11400 2600" fov="70" textRect="0.04 0.035 0.92 0.24" textScale="1">
    <transform target="Superman" pos="{647 - HERO_X} 11317 {2160 - PARK}" rot="-90 0 30" />
    <use-pose instance="Superman" name="Float" />
    <transform target="RedBeam" pos="-16000 0 {-PARK}" />
    <transform target="LockOpen" pos="-32000 0 {-PARK}" />
  </camera>
  <camera name="ship-breach" comment="From a distance Superman's heat vision has burst the red emitter under the airlock (smoke, a charred plug) and now cuts a glowing ring in the hull's flank" pos="-2700 7900 4250" look="-1100 10300 3800" fov="58" textRect="0.04 0.035 0.92 0.24" textScale="1">
    <transform target="Superman" pos="{-2300 - HERO_X} 8900 {3950 - PARK}" rot="0 0 135" />
    <use-pose instance="Superman" name="HandsOnHips" />
    <transform target="Breach" pos="-24000 0 {-PARK}" />
    <transform target="HeatVision" pos="-56000 0 {-PARK}" />
  </camera>
  <camera name="ship-starbolts" comment="Ending: the ship's guns fire on the embankment and its blocks burn by the river while Superman flies away west over the hill" pos="-5200 -2600 1400" look="1000 12000 2000" fov="58" textRect="0.04 0.035 0.92 0.24" textScale="1">
    <transform target="Starbolts" pos="-48000 0 {-PARK}" />
    <transform target="Superman" pos="{-5050 - HERO_X} -1650 {1580 - PARK}" rot="90 0 -70" />
    <use-pose instance="Superman" name="Fly" />
  </camera>

  <!-- Poses used only here. ShipGrip swings the front tentacle out toward the hill to hold Superman;
       ShipTorn tears the same tentacle after its fifth link, the severed end dropping away. -->
  <pose name="ShipGrip">
    <joint target="tentacle_2" aim="0 -10" />
  </pose>
  <pose name="ShipTorn">
    <joint target="tentacle_2_6" pos="0 0 -520" rot="12 0 25" />
  </pose>
  <pose name="StarPoint">
    <ik limb="left_arm" offset="-6 -44 70" bend="150 -30" />
    <ik limb="right_arm" offset="-16 -22 32" bend="-150 -40" />
    <joint target="head" rot="-22 0 6" />
  </pose>

  <material id="grass" color="0.24 0.38 0.20" shininess="3" />
  <material id="gravel" color="0.58 0.54 0.46" shininess="4" />
  <material id="parapet_stone" color="0.56 0.53 0.48" shininess="6" />
  <material id="coping_stone" color="0.68 0.65 0.58" shininess="8" />
  <material id="plinth_stone" color="0.44 0.42 0.40" shininess="8" />
  <material id="limestone" color="0.76 0.73 0.66" shininess="8" />
  <material id="cornice_stone" color="0.66 0.63 0.57" shininess="8" />
  <material id="dome_metal" color="0.80 0.82 0.84" shininess="70" />
  <material id="slit_dark" color="0.42 0.28 0.16" shininess="2" />
  <material id="door_wood" color="0.34 0.22 0.14" shininess="12" />
  <material id="window_lit" color="1.0 0.82 0.50" shininess="2" />
  <material id="brass" color="0.72 0.56 0.26" shininess="60" />
  <material id="bench_iron" color="0.14 0.15 0.16" shininess="40" />
  <material id="bench_wood" color="0.50 0.34 0.20" shininess="10" />
  <material id="tripod_wood" color="0.56 0.40 0.24" shininess="14" />
  <material id="scope_tube" color="0.86 0.86 0.84" shininess="60" />
  <material id="bark" color="0.26 0.20 0.15" shininess="4" />
  <material id="foliage" color="0.16 0.30 0.16" shininess="4" />
  <material id="street" color="0.20 0.20 0.22" shininess="6" />
  <material id="river" color="0.07 0.11 0.20" shininess="120" />
  <material id="quay" color="0.40 0.38 0.36" shininess="6" />
  <material id="street_light" color="1.0 0.78 0.46" shininess="1" />
  <material id="tower_facade" color="0.30 0.32 0.38" shininess="12" />
  <material id="tower_band" color="0.50 0.50 0.52" shininess="14" />
  <material id="glass_dark" color="0.10 0.14 0.22" shininess="90" />
  <material id="roof_dark" color="0.20 0.20 0.22" shininess="8" />
  <material id="beacon_red" color="1.0 0.16 0.10" shininess="1" />
  <material id="planet_globe" color="0.80 0.66 0.30" shininess="70" />
  <material id="planet_ring" color="0.62 0.50 0.24" shininess="60" />
  <material id="star" color="0.94 0.96 1.0" shininess="1" />
  <material id="haze" color="0.10 0.11 0.22" shininess="1" />
  <material id="haze_low" color="0.17 0.15 0.24" shininess="1" />
  <material id="xray_line" color="0.66 0.90 1.0" shininess="1" />
  <material id="xray_dim" color="0.36 0.56 0.72" shininess="1" />
  <material id="sun_red" color="1.0 0.16 0.08" shininess="1" />
  <material id="beam_red" color="1.0 0.28 0.16" shininess="1" />
  <material id="fire" color="1.0 0.56 0.18" shininess="1" />
  <material id="starbolt" color="0.70 0.92 1.0" shininess="1" />
  <material id="heat" color="1.0 0.36 0.10" shininess="1" />
  <material id="char" color="0.06 0.05 0.05" shininess="4" />
  <material id="smoke" color="0.30 0.30 0.32" shininess="2" />
  <material id="tentacle" color="0.30 0.36 0.33" shininess="45" />

  <!-- The moon, low in the west-south-west, is the key; the city's glow lights undersides from below. -->
  <sun dir="0.74 0.27 -0.62" color="0.72 0.80 1.0" intensity="1.15" castShadows="1" />
  <sun dir="-0.15 -0.35 1" color="1.0 0.62 0.36" intensity="0.30" castShadows="0" />
  <sphere name="Moon" pos="-66600 -24200 55800" radius="1500" color="0.96 0.95 0.88" unlit="1" castShadow="0" />
  <prefab source="sky/starfield" />
  <!-- Horizon glow over the city lights: two open bands far out, a boundary of the composed sky. -->
  <group name="Horizon">
    <cylinder pos="0 0 {CITY + 3100}" rot="90 0 0" radius="96000" height="6000" tube="10" sides="96" material="haze_low" unlit="1" castShadow="0" />
    <cylinder pos="0 0 {CITY + 9600}" rot="90 0 0" radius="96000" height="7000" tube="10" sides="96" material="haze" unlit="1" castShadow="0" />
  </group>

  <!-- The ground of Metropolis at street level, the river between its quays, and two bridges. One unit: the
       piers stand in the water. -->
  <group name="River">
    <box pos="0 {(RIVER_S - 60000)/2} {CITY - 200}" size="120000 {RIVER_S + 60000} 400" material="street" />
    <box pos="0 {(RIVER_N + 95000)/2} {CITY - 200}" size="120000 {95000 - RIVER_N} 400" material="street" />
    <box pos="0 {(RIVER_S + RIVER_N)/2} {(WATER + CITY - 400)/2}" size="120000 {RIVER_N - RIVER_S} {WATER - CITY + 400}" material="river" />
    <box pos="-7600 {(RIVER_S + RIVER_N)/2} {CITY + 60}" size="1500 {RIVER_N - RIVER_S + 800} 120" material="quay" />
    <box pos="-7600 {(RIVER_S + RIVER_N)/2 - 900} {CITY - 190}" size="900 500 380" material="quay" />
    <box pos="-7600 {(RIVER_S + RIVER_N)/2 + 900} {CITY - 190}" size="900 500 380" material="quay" />
    <box pos="9800 {(RIVER_S + RIVER_N)/2} {CITY + 60}" size="1500 {RIVER_N - RIVER_S + 800} 120" material="quay" />
    <box pos="9800 {(RIVER_S + RIVER_N)/2 - 900} {CITY - 190}" size="900 500 380" material="quay" />
    <box pos="9800 {(RIVER_S + RIVER_N)/2 + 900} {CITY - 190}" size="900 500 380" material="quay" />
  </group>
  <!-- Street lights: both quays, both bridges and the avenues running north from the river. -->
  <group name="StreetLights">
    <sphere pos="-40000 {RIVER_N + 260} {CITY + 520}" radius="70" rings="4" slices="6" material="street_light" unlit="1" castShadow="0"><array count="81" translation="1000 0 0" /></sphere>
    <sphere pos="-40000 {RIVER_S - 260} {CITY + 520}" radius="70" rings="4" slices="6" material="street_light" unlit="1" castShadow="0"><array count="81" translation="1000 0 0" /></sphere>
    <sphere pos="-8300 {RIVER_S - 400} {CITY + 560}" radius="70" rings="4" slices="6" material="street_light" unlit="1" castShadow="0"><array count="6" translation="0 840 0" /></sphere>
    <sphere pos="-6900 {RIVER_S - 400} {CITY + 560}" radius="70" rings="4" slices="6" material="street_light" unlit="1" castShadow="0"><array count="6" translation="0 840 0" /></sphere>
    <sphere pos="9100 {RIVER_S - 400} {CITY + 560}" radius="70" rings="4" slices="6" material="street_light" unlit="1" castShadow="0"><array count="6" translation="0 840 0" /></sphere>
    <sphere pos="10500 {RIVER_S - 400} {CITY + 560}" radius="70" rings="4" slices="6" material="street_light" unlit="1" castShadow="0"><array count="6" translation="0 840 0" /></sphere>
    <sphere pos="-17000 {RIVER_N + 3000} {CITY + 520}" radius="60" rings="4" slices="6" material="street_light" unlit="1" castShadow="0"><array count="24" translation="0 1100 0" /></sphere>
    <sphere pos="-7600 {RIVER_N + 3000} {CITY + 520}" radius="60" rings="4" slices="6" material="street_light" unlit="1" castShadow="0"><array count="24" translation="0 1100 0" /></sphere>
    <sphere pos="1600 {RIVER_N + 3000} {CITY + 520}" radius="60" rings="4" slices="6" material="street_light" unlit="1" castShadow="0"><array count="24" translation="0 1100 0" /></sphere>
    <sphere pos="9800 {RIVER_N + 3000} {CITY + 520}" radius="60" rings="4" slices="6" material="street_light" unlit="1" castShadow="0"><array count="24" translation="0 1100 0" /></sphere>
    <sphere pos="18500 {RIVER_N + 3000} {CITY + 520}" radius="60" rings="4" slices="6" material="street_light" unlit="1" castShadow="0"><array count="24" translation="0 1100 0" /></sphere>
    <sphere pos="-40000 {RIVER_N + 17600} {CITY + 520}" radius="60" rings="4" slices="6" material="street_light" unlit="1" castShadow="0"><array count="80" translation="1000 0 0" /></sphere>
  </group>

  <!-- Mt. Royal: a lathed hill whose flat top is the lawn, its brow falling north to the river road. -->
  <shape id="hill_profile" closed="0">
    <v x="0" y="0" />
    <v x="{HILL_R}" y="0" />
    <v x="{HILL_R - 500}" y="180" />
    <v x="{HILL_R - 1500}" y="650" />
    <v x="{HILL_R - 2700}" y="1400" />
    <v x="{LAWN_R + 1300}" y="2300" />
    <v x="{LAWN_R + 500}" y="{-CITY - 180}" />
    <v x="{LAWN_R + 150}" y="{-CITY - 40}" />
    <v x="{LAWN_R}" y="{-CITY}" />
    <v x="0" y="{-CITY}" />
  </shape>
  <group name="Hill">
    <lathe shape="hill_profile" segments="72" pos="0 0 {CITY}" rot="90 0 0" material="grass" />
    <!-- Gravel walks: from the car park up the south slope to the lookout, and a branch west to the porch. -->
    <box pos="-500 -500 0.1" rot="0 0 6" size="260 7400 1" material="gravel" />
    <box pos="-1250 600 0.05" size="1300 220 1" material="gravel" />
  </group>

  <!-- The lawn: the lookout parapet on the brow, the observatory on the west side with its door to the lawn,
       benches facing the view, the volunteers' telescopes, park lamps and the old oaks round the edge. -->
  <prefab source="sky/lookout" />
  <prefab source="sky/observatory" name="Observatory" pos="-2700 600 0" rot="0 0 90" />
  <prefab source="sky/bench" name="BenchWest" pos="-1900 2250 0" rot="0 0 170" />
  <prefab source="sky/bench" name="BenchMid" pos="-350 1500 0" rot="0 0 180" />
  <prefab source="sky/bench" name="BenchEast" pos="1100 1900 0" rot="0 0 200" />
  <prefab source="sky/telescope" name="ScopeWest" pos="-1450 3250 0" rot="0 0 172" />
  <prefab source="sky/telescope" name="ScopeMid" pos="450 1250 0" rot="0 0 190" />
  <prefab source="sky/telescope" name="ScopeEast" pos="1700 2900 0" rot="0 0 205" />
  <prefab source="sky/lamp_post" pos="-1450 1150 0" />
  <prefab source="sky/lamp_post" pos="450 450 0" />
  <prefab source="sky/lamp_post" pos="2500 2000 0" />
  <prefab source="sky/tree" pos="-3900 -900 0" rot="0 0 20" />
  <prefab source="sky/tree" pos="-2600 -2900 0" rot="0 0 110" scale="0.9 0.9 0.9" />
  <prefab source="sky/tree" pos="3500 -1700 0" rot="0 0 200" />
  <prefab source="sky/tree" pos="-1000 -3700 0" rot="0 0 290" scale="1.1 1.1 1.1" />
  <prefab source="sky/tree" pos="1200 -3600 0" rot="0 0 60" scale="0.95 0.95 0.95" />
  <prefab source="sky/tree" pos="3700 600 0" rot="0 0 150" scale="0.85 0.85 0.85" />
  <!-- Metropolis. -->
  <!-- North bank: the embankment row of apartment blocks facing the river. -->
  <prefab source="sky/towers/block" pos="-26000 {RIVER_N + 1500 + 371} {CITY}" rot="0 0 90" scale="1.0 1.0 0.8" />
  <prefab source="sky/towers/block" pos="-22673 {RIVER_N + 1500 + 66} {CITY}" rot="0 0 0" scale="1.1 1.1 1.0" />
  <prefab source="sky/towers/block" pos="-18981 {RIVER_N + 1500 + 48} {CITY}" rot="0 0 90" scale="1.0 1.0 0.8" />
  <prefab source="sky/towers/block" pos="-15682 {RIVER_N + 1500 + 262} {CITY}" rot="0 0 180" scale="0.9 0.9 0.8" />
  <prefab source="sky/towers/block" pos="-12974 {RIVER_N + 1500 + 323} {CITY}" rot="0 0 90" scale="0.9 0.9 1.0" />
  <prefab source="sky/towers/block" pos="-10072 {RIVER_N + 1500 + 194} {CITY}" rot="0 0 180" scale="0.9 0.9 1.4" />
  <prefab source="sky/towers/block" pos="-3607 {RIVER_N + 1500 + 240} {CITY}" rot="0 0 0" scale="0.9 0.9 1.0" />
  <prefab source="sky/towers/block" pos="-669 {RIVER_N + 1500 + 181} {CITY}" rot="0 0 0" scale="0.9 0.9 0.8" />
  <prefab source="sky/towers/block" pos="5533 {RIVER_N + 1500 + 313} {CITY}" rot="0 0 90" scale="0.8 0.8 1.0" />
  <prefab source="sky/towers/block" pos="8125 {RIVER_N + 1500 + 21} {CITY}" rot="0 0 90" scale="1.1 1.1 0.8" />
  <prefab source="sky/towers/block" pos="11633 {RIVER_N + 1500 + 328} {CITY}" rot="0 0 180" scale="0.8 0.8 1.4" />
  <prefab source="sky/towers/block" pos="14074 {RIVER_N + 1500 + 374} {CITY}" rot="0 0 0" scale="0.9 0.9 0.8" />
  <prefab source="sky/towers/block" pos="17282 {RIVER_N + 1500 + 131} {CITY}" rot="0 0 90" scale="1.1 1.1 1.4" />
  <prefab source="sky/towers/block" pos="20878 {RIVER_N + 1500 + 216} {CITY}" rot="0 0 180" scale="1.1 1.1 0.8" />
  <prefab source="sky/towers/block" pos="24575 {RIVER_N + 1500 + 172} {CITY}" rot="0 0 0" scale="1.1 1.1 1.0" />
  <!-- Downtown: towers rising behind the embankment, the Daily Planet among them. -->
  <prefab source="sky/towers/planet" pos="-5200 23500 {CITY}" rot="0 0 20" scale="1.0 1.0 1.0" />
  <prefab source="sky/towers/setback" pos="14568 36125 {CITY}" rot="0 0 180" scale="1.15 1.15 0.6" />
  <prefab source="sky/towers/slab" pos="22300 36313 {CITY}" rot="0 0 0" scale="0.85 0.85 0.9" />
  <prefab source="sky/towers/setback" pos="-19254 22609 {CITY}" rot="0 0 15" scale="1.0 1.0 0.75" />
  <prefab source="sky/towers/slab" pos="-24904 36295 {CITY}" rot="0 0 -20" scale="1.0 1.0 0.9" />
  <prefab source="sky/towers/slab" pos="7793 33166 {CITY}" rot="0 0 180" scale="0.85 0.85 0.9" />
  <prefab source="sky/towers/slab" pos="12158 24978 {CITY}" rot="0 0 0" scale="1.0 1.0 0.7" />
  <prefab source="sky/towers/slab" pos="-10265 21635 {CITY}" rot="0 0 -20" scale="1.15 1.15 0.6" />
  <prefab source="sky/towers/block" pos="-20346 41281 {CITY}" rot="0 0 90" scale="1.15 1.15 1.3" />
  <prefab source="sky/towers/block" pos="-1084 39052 {CITY}" rot="0 0 -20" scale="0.85 0.85 1.0" />
  <prefab source="sky/towers/slab" pos="-24851 42436 {CITY}" rot="0 0 90" scale="1.0 1.0 0.9" />
  <prefab source="sky/towers/block" pos="-13809 21456 {CITY}" rot="0 0 -90" scale="1.15 1.15 1.0" />
  <prefab source="sky/towers/slab" pos="5948 28067 {CITY}" rot="0 0 -90" scale="1.15 1.15 0.9" />
  <prefab source="sky/towers/slab" pos="25179 44906 {CITY}" rot="0 0 -20" scale="1.0 1.0 0.9" />
  <prefab source="sky/towers/setback" pos="16298 21127 {CITY}" rot="0 0 -20" scale="0.85 0.85 0.9" />
  <prefab source="sky/towers/block" pos="-13948 41714 {CITY}" rot="0 0 15" scale="0.85 0.85 1.6" />
