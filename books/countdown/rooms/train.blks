  <prefab source="characters/person" name="Wirth" pos="{CB + 67} {-WI/2 + 30} 9" rot="0 0 -90" pose="Sit" color="0.38 0.30 0.52">
    <ik limb="left_leg" offset="0 -40 -6" />
    <ik limb="right_leg" offset="0 -40 -6" />
  </prefab>
  <prefab source="characters/person" name="Passenger1" pos="{CB + 159} {WI/2 - 75} 9" rot="0 0 -90" pose="Read" color="0.70 0.30 0.28">
