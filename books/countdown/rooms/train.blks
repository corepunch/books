  </prefab>
  <prefab source="characters/person" name="Conductor" pos="200 0 0" rot="0 0 -90" pose="Stand" color="0.14 0.18 0.32" />

  <!-- ===== Camera-scoped props and actors. Each is stored 1000 cm below its place, under the ground and the
       track, and the cameras that show it lift it by 1000 (z is unaffected by its yaw). ===== -->
  <!-- Superman, in the aisle where Clark stood (train-exposed). -->
  <prefab source="characters/superman" name="Superman" pos="-400 0 -1000" rot="0 0 96" pose="HandsOnHips" />
  <!-- Clark's suit, shirt, tie and glasses on his seat (train-exposed). -->
  <prefab source="train/discarded_suit" name="ClarkClothes" attach="ClarkSeat:place_b" pos="0 -27 -1000" />
  <!-- The S-shield and blue suit under Clark's opened shirt (train-restroom-change). -->
  <group name="ClarkShield" pos="-636.5 -108 -854.2" rot="0 0 125" sanityIgnore="1">
    <ellipsoid radii="11 1.6 14" color="0.12 0.30 0.78" />
    <rect pos="0 -1.2 1" rot="90 45 0" size="13 13" color="0.80 0.10 0.10"><extrude amount="1.2" /></rect>
    <rect pos="0 -1.9 1" rot="90 45 0" size="9 9" color="0.95 0.78 0.18"><extrude amount="0.6" /></rect>
    <box pos="0 -2.3 1.6" rot="0 -30 0" size="7 0.5 2" color="0.80 0.10 0.10" />
