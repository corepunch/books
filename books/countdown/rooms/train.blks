    <ik limb="right_leg" offset="0 -40 -6" />
  </prefab>
  <prefab source="characters/person" name="Passenger3" pos="{CB + 343} {WI/2 - 30} 9" rot="0 0 -90" pose="Sit" color="0.82 0.78 0.52">
    <ik limb="left_leg" offset="0 -40 -6" />
    <ik limb="right_leg" offset="0 -40 -6" />
  </prefab>
  <prefab source="characters/person" name="Passenger4" pos="{CB + 435} {WI/2 - 75} 8" rot="0 0 -90" pose="Sit" color="0.28 0.40 0.56" />
  <prefab source="characters/person" name="Passenger5" pos="{CB + 159} {-WI/2 + 75} 8" rot="0 0 -90" pose="Sit" color="0.52 0.32 0.30" />
  <prefab source="characters/person" name="Passenger6" pos="{CB + 527} {WI/2 - 75} 9" rot="0 0 -90" pose="Sit" color="0.30 0.44 0.62">
