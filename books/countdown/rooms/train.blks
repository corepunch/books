    <box pos="11.5 -0.6 -1" rot="0 0 -28" size="7 1 30" color="0.93 0.93 0.89" />
    <box pos="13 -2.2 -2" rot="0 8 -28" size="3 0.8 24" color="0.70 0.12 0.12" />
  </group>

