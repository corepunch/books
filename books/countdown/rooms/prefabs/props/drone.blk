<!-- One of Brainiac's scanning drones: a card-pack-sized flying box, 18 x 12 x 6, with a scanning lens on
     its front (local -Y) and two thruster rings. Origin at its centre. -->
<prefab>
  <box size="18 12 6" material="drone" />
  <cylinder pos="0 -6.5 0" rot="0 0 0" radius="2.4" height="2" color="0.40 1.0 0.80" unlit="1" castShadow="0" />
  <torus pos="-9 0 0" rot="0 0 90" majorRadius="3" minorRadius="0.8" material="drone" />
  <torus pos="9 0 0" rot="0 0 90" majorRadius="3" minorRadius="0.8" material="drone" />
</prefab>
