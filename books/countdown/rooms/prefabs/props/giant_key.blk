<!-- The giant golden key of the Fortress of Solitude, about 530 cm long along local X with the bit at
     +X, cast so heavy that no ordinary person could lift it. Origin on the shaft axis at the key's
     middle; the bow ring stands in the local XZ plane and the wards hang below the shaft (-Z).
     Front (the bit, the end that goes into the lock) is +X. Z up. Self-contained materials. -->
<prefab up="z" front="+x">
  <material id="key_gold" color="0.92 0.70 0.24" shininess="70" />
  <material id="key_gold_dark" color="0.66 0.46 0.14" shininess="50" />
  <let name="SR" value="16" />
  <let name="BOWX" value="-190" />
  <let name="BOWR" value="70" />
  <let name="BOWT" value="18" />
  <let name="SH0" value="BOWX + BOWR" />
  <let name="SH1" value="250" />
  <!-- Bow: a heavy ring with a diamond boss at its heart, joined to the shaft by a collar. -->
  <torus pos="{BOWX} 0 0" majorRadius="{BOWR}" minorRadius="{BOWT}" majorSegments="32" material="key_gold" />
  <box pos="{BOWX} 0 0" rot="0 45 0" size="{(BOWR - BOWT)*1.3} 12 {(BOWR - BOWT)*1.3}" material="key_gold_dark" />
  <cylinder pos="{SH0 + 14} 0 0" rot="0 0 90" radius="{SR + 14}" height="28" material="key_gold_dark" />
  <cylinder pos="{SH0 + 50} 0 0" rot="0 0 90" radius="{SR + 8}" height="12" material="key_gold" />
  <!-- Shaft. -->
  <cylinder pos="{(SH0 + 20 + SH1)/2} 0 0" rot="0 0 90" radius="{SR}" height="{SH1 - SH0 - 20}" material="key_gold" />
  <sphere pos="{SH1} 0 0" radius="{SR}" material="key_gold" />
  <!-- Bit: three wards of different depths below the shaft. -->
  <box pos="165 0 {-SR - 30}" size="26 14 60" material="key_gold" />
  <box pos="200 0 {-SR - 20}" size="24 14 40" material="key_gold" />
  <box pos="232 0 {-SR - 32}" size="22 14 64" material="key_gold" />
</prefab>
