<!-- A tall tape-drive cabinet, 120 wide (local X), 70 deep, 210 tall; doors face local -Y. Origin on
     the floor under the middle of the front. -->
<prefab>
  <box pos="0 35 105" size="120 70 210" material="cabinet" />
  <cylinder pos="-28 -1 150" rot="90 0 0" radius="18" height="2" material="dark_metal" />
  <cylinder pos="28 -1 150" rot="90 0 0" radius="18" height="2" material="dark_metal" />
  <box pos="0 -1 70" size="100 2 60" material="dark_metal" />
</prefab>
