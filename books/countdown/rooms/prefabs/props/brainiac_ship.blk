  <group rot="0 0 0"><group rot="0 52 0"><box pos="{R + 4} 0 0" size="24 220 200" material="bs_plate" /><box pos="{R + 18} 0 0" size="8 160 20" material="bs_rib" /></group></group>
  <group rot="0 0 175"><group rot="0 52 0"><box pos="{R + 4} 0 0" size="24 220 160" material="bs_plate" /><box pos="{R + 18} 0 0" size="8 160 20" material="bs_rib" /></group></group>
  <group rot="0 0 40"><group rot="0 52 0"><box pos="{R + 4} 0 0" size="24 220 240" material="bs_plate" /><box pos="{R + 18} 0 0" size="8 160 20" material="bs_rib" /></group></group>
  <!-- The Brain Net: a purple glass dome under a net of ribs, its collar and a sensor spire. -->
  <sphere pos="0 0 {NET_Z}" radius="{NET}" scale="1 1 {NET_S}" rings="24" slices="40" material="bs_net" />
  <torus pos="0 0 1650" rot="90 0 0" majorRadius="1135" minorRadius="70" majorSegments="56" material="bs_plate" />
  <torus pos="0 0 1880" rot="90 0 0" majorRadius="{NET*sqrt(1 - pow((1880 - NET_Z)/(NET*NET_S), 2)) + 4}" minorRadius="14" majorSegments="48" material="bs_rib" />
  <torus pos="0 0 2100" rot="90 0 0" majorRadius="{NET*sqrt(1 - pow((2100 - NET_Z)/(NET*NET_S), 2)) + 4}" minorRadius="14" majorSegments="48" material="bs_rib" />
  <torus pos="0 0 {NET_Z}" rot="0 0 0" scale="1 1 {NET_S}" majorRadius="{NET + 6}" minorRadius="14" majorSegments="64" material="bs_rib" />
  <torus pos="0 0 {NET_Z}" rot="0 0 45" scale="1 1 {NET_S}" majorRadius="{NET + 6}" minorRadius="14" majorSegments="64" material="bs_rib" />
  <torus pos="0 0 {NET_Z}" rot="0 0 90" scale="1 1 {NET_S}" majorRadius="{NET + 6}" minorRadius="14" majorSegments="64" material="bs_rib" />
  <torus pos="0 0 {NET_Z}" rot="0 0 135" scale="1 1 {NET_S}" majorRadius="{NET + 6}" minorRadius="14" majorSegments="64" material="bs_rib" />
  <cylinder pos="0 0 {NET_Z + NET*NET_S + 140}" rot="90 0 0" radius="20" height="320" sides="8" material="bs_rib" />
  <sphere pos="0 0 {NET_Z + NET*NET_S + 310}" radius="42" material="bs_glow" unlit="1" castShadow="0" />

  <!-- The skull face: brow ridges over deep eye sockets with red sensor eyes, a nose cavity, and a jaw of
       metal teeth under the mouth slot. -->
  <group name="skull">
    <ellipsoid pos="-560 -1700 690" rot="-20 0 -12" radii="520 230 150" material="bs_plate" />
    <ellipsoid pos="560 -1700 690" rot="-20 0 12" radii="520 230 150" material="bs_plate" />
    <ellipsoid pos="-580 -1760 300" radii="360 220 300" material="bs_dark" />
    <ellipsoid pos="580 -1760 300" radii="360 220 300" material="bs_dark" />
    <sphere pos="-580 -1880 300" radius="140" material="bs_glow" unlit="1" castShadow="0" />
    <sphere pos="580 -1880 300" radius="140" material="bs_glow" unlit="1" castShadow="0" />
