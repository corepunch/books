  <!-- Hatches and access plates on the panels (azimuth, latitude); each is a plate laid on the hull. -->
  <group rot="0 0 15"><group rot="0 -28 0"><box pos="{R + 4} 0 0" size="24 300 200" material="bs_plate" /><box pos="{R + 18} 0 0" size="8 240 20" material="bs_rib" /></group></group>
  <group rot="0 0 60"><group rot="0 -52 0"><box pos="{R + 4} 0 0" size="24 300 200" material="bs_plate" /><box pos="{R + 18} 0 0" size="8 240 20" material="bs_rib" /></group></group>
