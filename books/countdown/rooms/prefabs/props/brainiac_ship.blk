      <torus pos="0 -870 0" majorRadius="66" minorRadius="22" material="bs_plate" />
      <cylinder pos="0 -892 0" radius="36" height="6" color="0.70 0.92 1.0" unlit="1" castShadow="0" />
    </group>
  </group>
  <group pos="0 {-sqrt(R*R - 0*0 - 1260*1260) + 40} 1260">
