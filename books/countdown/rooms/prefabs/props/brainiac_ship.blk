  </group>
  <group rot="0 0 180">
    <sphere pos="1250 0 -1880" radius="190" material="ship_rib" />
    <cylinder pos="1330 0 -2760" rot="-90 -10 0" radius="30" height="1800" material="ship_rib"><taper amount="-2.4" /></cylinder>
