    <ellipsoid pos="0 -1660 -900" rot="-28 0 0" radii="640 260 170" material="bs_rib" />
  </group>

  <!-- Three starbolt guns on the brow, raised 12 degrees, muzzles ringed and charged. -->
  <group pos="-560 {-sqrt(R*R - -560*-560 - 1180*1180) + 40} 1180">
