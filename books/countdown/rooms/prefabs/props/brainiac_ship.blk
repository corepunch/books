<?xml version="1.0" encoding="UTF-8"?>
<!-- Brainiac's starship: a 40 m sphere of plated green metal (R = 2000 cm). Latitude bands and meridian ribs
     divide the hull into panels with hatches; an equatorial belt carries a ring of lit ports. The front (local -Y)
     is a skull: brow ridges over dark eye sockets with red sensor eyes, a nose cavity and a mouth of
     metal teeth; three starbolt guns stand on the brow. On top a purple glass dome, the Brain Net, under a net
     of ribs. Underneath, a plated collar holds the red-sun airlock: a closed iris with a red-glowing seam and a
     red light below it. Eight segmented tentacles (bones tentacle_1..8, links _2.._9, 22 m long) hang from ball
     sockets round the lower hull; tentacle_1 hangs below the face on its local -X side, the rest follow
     counter-clockwise seen from above.
     Origin at the hull's centre; the ship hovers, so it has no ground baseline. Front -Y (the skull face);
     rot="0 0 180" faces +Y. The airlock centre is at (0 0 -2080), the eyes at (+-580 -1880 300).
     Materials are defined here (bs_*) so every scene that places the ship gets the same look. -->
<prefab up="z" front="-y">
  <material id="bs_hull" color="0.40 0.52 0.46" shininess="50" />
  <material id="bs_plate" color="0.54 0.64 0.58" shininess="60" />
  <material id="bs_rib" color="0.24 0.30 0.28" shininess="60" />
  <material id="bs_dark" color="0.07 0.08 0.08" shininess="30" />
  <material id="bs_net" color="0.58 0.30 0.74" shininess="90" />
  <material id="bs_tent" color="0.30 0.36 0.33" shininess="45" />
  <material id="bs_glow" color="1.0 0.20 0.10" shininess="1" />
  <material id="bs_port" color="0.70 1.0 0.78" shininess="1" />
  <let name="R" value="2000" />        <!-- hull radius -->
  <let name="BAND" value="36" />       <!-- latitude band tube radius -->
  <let name="BELT" value="R + 40" />   <!-- equatorial belt radius -->
  <let name="BELT_H" value="360" />
  <let name="NET" value="1150" />      <!-- Brain Net dome radius -->
  <let name="NET_Z" value="1450" />    <!-- Brain Net centre -->
  <let name="NET_S" value="0.75" />    <!-- Brain Net vertical squash -->
  <let name="LOCK" value="620" />      <!-- airlock collar radius -->
  <let name="SOCK_EL" value="-50" />   <!-- tentacle socket latitude -->
  <let name="TL" value="2200" />       <!-- tentacle length -->
  <attach name="airlock" pos="0 0 -2080" />
  <attach name="brain_net" pos="0 0 {NET_Z + NET*NET_S}" />

  <sphere radius="{R}" rings="40" slices="56" material="bs_hull" />

  <!-- Latitude bands. -->
  <torus pos="0 0 {R*sin(rad(-64))}" rot="90 0 0" majorRadius="{R*cos(rad(-64))}" minorRadius="{BAND}" majorSegments="64" minorSegments="10" material="bs_rib" />
  <torus pos="0 0 {R*sin(rad(-40))}" rot="90 0 0" majorRadius="{R*cos(rad(-40))}" minorRadius="{BAND}" majorSegments="64" minorSegments="10" material="bs_rib" />
  <torus pos="0 0 {R*sin(rad(-17))}" rot="90 0 0" majorRadius="{R*cos(rad(-17))}" minorRadius="{BAND}" majorSegments="64" minorSegments="10" material="bs_rib" />
  <torus pos="0 0 {R*sin(rad(17))}" rot="90 0 0" majorRadius="{R*cos(rad(17))}" minorRadius="{BAND}" majorSegments="64" minorSegments="10" material="bs_rib" />
  <torus pos="0 0 {R*sin(rad(40))}" rot="90 0 0" majorRadius="{R*cos(rad(40))}" minorRadius="{BAND}" majorSegments="64" minorSegments="10" material="bs_rib" />
  <!-- Equatorial belt with its edge rails and the ring of lit ports (none across the face). -->
  <cylinder rot="90 0 0" radius="{BELT}" height="{BELT_H}" sides="64" material="bs_plate" />
  <torus pos="0 0 {BELT_H/2}" rot="90 0 0" majorRadius="{BELT}" minorRadius="22" majorSegments="64" material="bs_rib" />
  <torus pos="0 0 {-BELT_H/2}" rot="90 0 0" majorRadius="{BELT}" minorRadius="22" majorSegments="64" material="bs_rib" />
  <box pos="{(BELT + 4)*cos(rad(0))} {(BELT + 4)*sin(rad(0))} 0" rot="0 0 0" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(10))} {(BELT + 4)*sin(rad(10))} 0" rot="0 0 10" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(20))} {(BELT + 4)*sin(rad(20))} 0" rot="0 0 20" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(30))} {(BELT + 4)*sin(rad(30))} 0" rot="0 0 30" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(40))} {(BELT + 4)*sin(rad(40))} 0" rot="0 0 40" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(50))} {(BELT + 4)*sin(rad(50))} 0" rot="0 0 50" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(60))} {(BELT + 4)*sin(rad(60))} 0" rot="0 0 60" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(70))} {(BELT + 4)*sin(rad(70))} 0" rot="0 0 70" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(80))} {(BELT + 4)*sin(rad(80))} 0" rot="0 0 80" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(90))} {(BELT + 4)*sin(rad(90))} 0" rot="0 0 90" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(100))} {(BELT + 4)*sin(rad(100))} 0" rot="0 0 100" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(110))} {(BELT + 4)*sin(rad(110))} 0" rot="0 0 110" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(120))} {(BELT + 4)*sin(rad(120))} 0" rot="0 0 120" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(130))} {(BELT + 4)*sin(rad(130))} 0" rot="0 0 130" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(140))} {(BELT + 4)*sin(rad(140))} 0" rot="0 0 140" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(150))} {(BELT + 4)*sin(rad(150))} 0" rot="0 0 150" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(160))} {(BELT + 4)*sin(rad(160))} 0" rot="0 0 160" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(170))} {(BELT + 4)*sin(rad(170))} 0" rot="0 0 170" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(180))} {(BELT + 4)*sin(rad(180))} 0" rot="0 0 180" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(190))} {(BELT + 4)*sin(rad(190))} 0" rot="0 0 190" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(200))} {(BELT + 4)*sin(rad(200))} 0" rot="0 0 200" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(210))} {(BELT + 4)*sin(rad(210))} 0" rot="0 0 210" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(220))} {(BELT + 4)*sin(rad(220))} 0" rot="0 0 220" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(320))} {(BELT + 4)*sin(rad(320))} 0" rot="0 0 320" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(330))} {(BELT + 4)*sin(rad(330))} 0" rot="0 0 330" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(340))} {(BELT + 4)*sin(rad(340))} 0" rot="0 0 340" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <box pos="{(BELT + 4)*cos(rad(350))} {(BELT + 4)*sin(rad(350))} 0" rot="0 0 350" size="12 90 150" material="bs_port" unlit="1" castShadow="0" />
  <!-- Meridian ribs from the lowest band up to the Brain Net collar, clear of the face: each rib is a chain of
       straight 8-degree plates laid on the hull. -->
  <group rot="0 0 0">
    <box pos="{(R + 8)*cos(rad(-60))} 0 {(R + 8)*sin(rad(-60))}" rot="0 60 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-52))} 0 {(R + 8)*sin(rad(-52))}" rot="0 52 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-44))} 0 {(R + 8)*sin(rad(-44))}" rot="0 44 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-36))} 0 {(R + 8)*sin(rad(-36))}" rot="0 36 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-28))} 0 {(R + 8)*sin(rad(-28))}" rot="0 28 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-20))} 0 {(R + 8)*sin(rad(-20))}" rot="0 20 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-12))} 0 {(R + 8)*sin(rad(-12))}" rot="0 12 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-4))} 0 {(R + 8)*sin(rad(-4))}" rot="0 4 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(4))} 0 {(R + 8)*sin(rad(4))}" rot="0 -4 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(12))} 0 {(R + 8)*sin(rad(12))}" rot="0 -12 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(20))} 0 {(R + 8)*sin(rad(20))}" rot="0 -20 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(28))} 0 {(R + 8)*sin(rad(28))}" rot="0 -28 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(36))} 0 {(R + 8)*sin(rad(36))}" rot="0 -36 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(44))} 0 {(R + 8)*sin(rad(44))}" rot="0 -44 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(52))} 0 {(R + 8)*sin(rad(52))}" rot="0 -52 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
  </group>
  <group rot="0 0 40">
    <box pos="{(R + 8)*cos(rad(-60))} 0 {(R + 8)*sin(rad(-60))}" rot="0 60 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-52))} 0 {(R + 8)*sin(rad(-52))}" rot="0 52 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-44))} 0 {(R + 8)*sin(rad(-44))}" rot="0 44 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-36))} 0 {(R + 8)*sin(rad(-36))}" rot="0 36 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-28))} 0 {(R + 8)*sin(rad(-28))}" rot="0 28 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-20))} 0 {(R + 8)*sin(rad(-20))}" rot="0 20 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-12))} 0 {(R + 8)*sin(rad(-12))}" rot="0 12 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-4))} 0 {(R + 8)*sin(rad(-4))}" rot="0 4 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(4))} 0 {(R + 8)*sin(rad(4))}" rot="0 -4 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(12))} 0 {(R + 8)*sin(rad(12))}" rot="0 -12 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(20))} 0 {(R + 8)*sin(rad(20))}" rot="0 -20 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(28))} 0 {(R + 8)*sin(rad(28))}" rot="0 -28 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(36))} 0 {(R + 8)*sin(rad(36))}" rot="0 -36 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(44))} 0 {(R + 8)*sin(rad(44))}" rot="0 -44 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(52))} 0 {(R + 8)*sin(rad(52))}" rot="0 -52 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
  </group>
  <group rot="0 0 80">
    <box pos="{(R + 8)*cos(rad(-60))} 0 {(R + 8)*sin(rad(-60))}" rot="0 60 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-52))} 0 {(R + 8)*sin(rad(-52))}" rot="0 52 0" size="44 68 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
    <box pos="{(R + 8)*cos(rad(-44))} 0 {(R + 8)*sin(rad(-44))}" rot="0 44 0" size="48 62 {2*(R + 8)*tan(rad(4)) + 4}" material="bs_rib" />
