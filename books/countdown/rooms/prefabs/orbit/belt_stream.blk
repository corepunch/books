<?xml version='1.0' encoding='UTF-8'?>
<!-- The far reaches of Brainiac's meteorite belt: 30 brown rocks strung along the orbit ahead of and
     behind the near cluster, from 25 m to 700 m away. Origin at the belt centre; local +Y runs along
     the orbit (front +y), +Z points away from the Earth and the orbit curves down round a ball of radius
     RB (keep it equal to the scene's RE + ALT); SINK makes the orbit decay ahead. Rock k sits at arc
     length S_k, spread sideways and up by golden-angle sines. Every rock is tint="1", so an instance
     colour repaints the lot (the X-ray belt). Materials from the scene: meteor. -->
<prefab up="z" front="+y">
  <let name="RB" value="170000"/>
  <let name="SINK" value="0.10"/>
  <group><let name="S" value="2600"/>
    <sphere pos="{(300 + abs(S)*0.06)*sin(rad(0*137.5))} {RB*sin(S/RB)} {RB*(cos(S/RB) - 1) - S*SINK + (120 + abs(S)*0.02)*cos(rad(0*97.3))}" rot="0 0 0" scale="1.15 1 0.85" radius="94" rings="5" slices="7" material="meteor" tint="1"><twist angle="20" axis="z"/><skew amount="0.2" axis="x"/></sphere></group>
  <group><let name="S" value="3500"/>
    <sphere pos="{(300 + abs(S)*0.06)*sin(rad(1*137.5))} {RB*sin(S/RB)} {RB*(cos(S/RB) - 1) - S*SINK + (120 + abs(S)*0.02)*cos(rad(1*97.3))}" rot="47 31 73" scale="1.15 1 0.85" radius="181" rings="6" slices="8" material="meteor" tint="1"><twist angle="33" axis="z"/><skew amount="0.2" axis="x"/></sphere></group>
