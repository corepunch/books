<?xml version='1.0' encoding='UTF-8'?>
<!-- Stars: 110 small self-lit points spread evenly over a sphere of radius RS round the origin
     (a Fibonacci spiral: star k sits at height 1 - (2k+1)/N, turned k golden angles round Z). Keep
     every camera within 1000 m of every star you want drawn (Scener's far clip); stars behind the
     Earth are simply hidden by it. No orientation. -->
<prefab up="z">
  <let name="RS" value="78000"/>
  <let name="N" value="110"/>
  <let name="GOLD" value="137.508"/>
  <sphere pos="{RS*sqrt(1 - (1 - (2*0+1)/N)^2)*cos(rad(0*GOLD))} {RS*sqrt(1 - (1 - (2*0+1)/N)^2)*sin(rad(0*GOLD))} {RS*(1 - (2*0+1)/N)}" radius="110" rings="4" slices="6" color="1.0 1.0 1.0" unlit="1" castShadow="0"/>
  <sphere pos="{RS*sqrt(1 - (1 - (2*1+1)/N)^2)*cos(rad(1*GOLD))} {RS*sqrt(1 - (1 - (2*1+1)/N)^2)*sin(rad(1*GOLD))} {RS*(1 - (2*1+1)/N)}" radius="260" rings="4" slices="6" color="0.92 0.94 1.0" unlit="1" castShadow="0"/>
  <sphere pos="{RS*sqrt(1 - (1 - (2*2+1)/N)^2)*cos(rad(2*GOLD))} {RS*sqrt(1 - (1 - (2*2+1)/N)^2)*sin(rad(2*GOLD))} {RS*(1 - (2*2+1)/N)}" radius="190" rings="4" slices="6" color="1.0 0.92 0.80" unlit="1" castShadow="0"/>
