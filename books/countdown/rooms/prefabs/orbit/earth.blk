<?xml version='1.0' encoding='UTF-8'?>
<!-- The Earth at storybook scale, authored as a unit globe of radius 1000 round its centre (origin); the
     scene scales it up. Local +Z (front +z) is the point under Brainiac's belt, mid-Atlantic: blue ocean
     with a strung island chain, a desert-and-green coast to the east, another continent past the far
     horizon, white cloud fields and one cyclone. Land rises a little above the sea, clouds float a
     little higher so the sun throws their shadows on the water. Materials from the scene: earth_sea,
     earth_land, earth_desert, cloud. -->
<prefab up="z" front="+z">
  <let name="RE" value="1000"/>
  <let name="LAND" value="1.6"/>   <!-- land relief above the sea -->
  <let name="CLOUD" value="1.4"/>  <!-- cloud deck above the sea -->
  <let name="CT" value="0.5"/>    <!-- cloud half-thickness -->
  <sphere radius="{RE}" rings="160" slices="256" material="earth_sea"/>
  <!-- Land: lens ellipsoids sunk so their rims dip under the curved sea and only a low relief shows. -->
  <group rot="0 17 40"><let name="T" value="LAND + 150*150/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 60" radii="150 70 {T}" rings="10" slices="28" material="earth_land"/></group>
  <group rot="0 21 58"><let name="T" value="LAND + 170*170/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 20" radii="170 95 {T}" rings="10" slices="28" material="earth_desert"/></group>
  <group rot="0 25 30"><let name="T" value="LAND + 160*160/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 80" radii="160 90 {T}" rings="10" slices="28" material="earth_land"/></group>
  <group rot="0 14 62"><let name="T" value="LAND + 70*70/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 35" radii="70 40 {T}" rings="10" slices="28" material="earth_land"/></group>
  <group rot="0 24 75"><let name="T" value="LAND + 120*120/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 10" radii="120 80 {T}" rings="10" slices="28" material="earth_desert"/></group>
  <group rot="0 9 170"><let name="T" value="LAND + 26*26/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 30" radii="26 14 {T}" rings="10" slices="28" material="earth_land"/></group>
  <group rot="0 11 182"><let name="T" value="LAND + 18*18/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 70" radii="18 10 {T}" rings="10" slices="28" material="earth_land"/></group>
  <group rot="0 12.5 192"><let name="T" value="LAND + 12*12/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 10" radii="12 8 {T}" rings="10" slices="28" material="earth_land"/></group>
  <group rot="0 24 230"><let name="T" value="LAND + 180*180/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 50" radii="180 90 {T}" rings="10" slices="28" material="earth_land"/></group>
  <group rot="0 20 250"><let name="T" value="LAND + 90*90/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 75" radii="90 45 {T}" rings="10" slices="28" material="earth_land"/></group>
  <group rot="0 60 0"><let name="T" value="LAND + 300*300/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 20" radii="300 160 {T}" rings="10" slices="28" material="earth_land"/></group>
  <group rot="0 75 120"><let name="T" value="LAND + 260*260/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 70" radii="260 200 {T}" rings="10" slices="28" material="earth_desert"/></group>
  <group rot="0 100 220"><let name="T" value="LAND + 320*320/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 10" radii="320 180 {T}" rings="10" slices="28" material="earth_land"/></group>
  <group rot="0 130 300"><let name="T" value="LAND + 240*240/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 40" radii="240 140 {T}" rings="10" slices="28" material="earth_land"/></group>
  <group rot="0 55 160"><let name="T" value="LAND + 200*200/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 0" radii="200 120 {T}" rings="10" slices="28" material="earth_land"/></group>
  <group rot="0 90 60"><let name="T" value="LAND + 180*180/(2*RE) + 2"/><ellipsoid pos="0 0 {RE + LAND - T}" rot="0 0 30" radii="180 110 {T}" rings="10" slices="28" material="earth_land"/></group>
  <!-- Cloud fields: clusters of small flat puffs a little above the sea, each puff turned and bent
     differently (puff j of a field sits j golden angles round its centre, and 0.45 higher than puff j-1 so overlapping
     puffs never share a plane). -->
  <group rot="0 3.15 0.0">
    <ellipsoid pos="{3.2} {0.0} {RE + CLOUD + 0.00}" rot="0 0 0" radii="7.2 3.6 {CT}" rings="6" slices="22" material="cloud"><bend angle="-30" axis="x"/></ellipsoid>
    <ellipsoid pos="{-4.1} {3.7} {RE + CLOUD + 0.45}" rot="0 0 61" radii="8.5 5.3 {CT}" rings="6" slices="22" material="cloud"><bend angle="7" axis="x"/></ellipsoid>
    <ellipsoid pos="{0.6} {-7.1} {RE + CLOUD + 0.90}" rot="0 0 122" radii="11.5 8.5 {CT}" rings="6" slices="22" material="cloud"><bend angle="-16" axis="x"/></ellipsoid>
    <ellipsoid pos="{5.1} {6.7} {RE + CLOUD + 1.35}" rot="0 0 3" radii="7.0 6.0 {CT}" rings="6" slices="22" material="cloud"><bend angle="21" axis="x"/></ellipsoid>
    <ellipsoid pos="{-9.4} {-1.7} {RE + CLOUD + 1.80}" rot="0 0 64" radii="10.0 5.0 {CT}" rings="6" slices="22" material="cloud"><bend angle="-2" axis="x"/></ellipsoid>
    <ellipsoid pos="{8.9} {-5.7} {RE + CLOUD + 2.25}" rot="0 0 125" radii="5.5 3.4 {CT}" rings="6" slices="22" material="cloud"><bend angle="-25" axis="x"/></ellipsoid>
  </group>
