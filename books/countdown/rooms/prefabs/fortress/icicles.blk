<!-- A cluster of four hexagonal ice points hanging from the hall's roof, 160 to 420 long, about 200
     across. Origin at the ceiling at the cluster's middle; it hangs down (-Z). No front (declared
     -Y). Self-contained materials (the hall's own override them). -->
<prefab up="z" front="-y">
  <material id="fortress_crystal" color="0.80 0.93 0.98" shininess="140" />
  <material id="fortress_ice_deep" color="0.46 0.62 0.78" shininess="90" />
  <cone pos="0 0 -210" rot="-90 0 0" radius="56" height="420" sides="6" material="fortress_crystal" />
  <cone pos="70 30 -131" rot="-90 0 20" radius="40" height="260" sides="6" material="fortress_ice_deep" />
  <cone pos="-60 50 -91" rot="-90 0 40" radius="34" height="180" sides="6" material="fortress_crystal" />
  <cone pos="-10 -76 -81" rot="-90 0 10" radius="30" height="160" sides="6" material="fortress_ice_deep" />
</prefab>
