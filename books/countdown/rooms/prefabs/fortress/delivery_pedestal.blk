<!-- The computer's delivery pedestal beside the console: a hexagonal ice-steel column 110 tall that
     rises from the floor with whatever the machine has made standing on its top, a glowing collar
     under the top plate and a soft cyan light in that collar to show the delivery. About 150
     across. Origin on the floor at its axis; the delivered thing stands on attach top_surface.
     No front (declared -Y). Self-contained materials (the hall's own override them). -->
<prefab up="z" front="-y">
  <material id="fortress_metal" color="0.24 0.30 0.38" shininess="70" />
  <material id="fortress_crystal" color="0.80 0.93 0.98" shininess="140" />
  <material id="fortress_glow" color="0.55 0.95 1.0" shininess="5" />
  <let name="H" value="110" />
  <attach name="top_surface" pos="0 0 {H}" />
  <cone pos="0 0 12" rot="90 0 0" radius="75" radiusTop="58" height="24" sides="6" material="fortress_metal" />
  <prism pos="0 0 {(24 + H - 26)/2}" rot="90 0 0" radius="44" height="{H - 26 - 24}" sides="6" material="fortress_crystal" />
  <prism pos="0 0 {H - 20}" rot="90 0 0" radius="50" height="12" sides="6" material="fortress_glow" unlit="1" castShadow="0" />
  <prism pos="0 0 {H - 7}" rot="90 0 0" radius="66" height="14" sides="6" material="fortress_metal" />
  <light pos="0 0 {H - 20}" color="0.55 0.92 1.0" intensity="0.5" radius="220" castShadows="0" />
</prefab>
