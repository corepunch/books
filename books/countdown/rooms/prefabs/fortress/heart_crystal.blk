<!-- The Fortress's sun crystal, the hall's key light: a hexagonal ice stalk hanging from the roof with
     a long glowing double-pointed crystal at its end and three dark ice points round it. The glowing
     crystal is an unlit emitter with the shadow-casting point light at its middle, below the stalk.
     About 260 across and 640 long. Origin at the ceiling where the stalk is rooted; it hangs down
     (-Z). No front (declared -Y). Self-contained materials (the hall's own override them). -->
<prefab up="z" front="-y">
  <material id="fortress_ice_deep" color="0.46 0.62 0.78" shininess="90" />
  <material id="fortress_crystal" color="0.80 0.93 0.98" shininess="140" />
  <let name="ST" value="300" />
  <let name="GL" value="300" />
  <attach name="light" pos="0 0 {-ST - GL/2}" />
  <cone pos="0 0 -20" rot="-90 0 0" radius="90" radiusTop="50" height="40" sides="6" material="fortress_ice_deep" />
  <prism pos="0 0 {-40 - (ST - 40)/2}" rot="90 0 0" radius="40" height="{ST - 40}" sides="6" material="fortress_crystal" />
  <!-- Three dark points hanging round the stalk. -->
  <cone pos="90 0 {-40 - 110}" rot="-90 0 0" radius="34" height="220" sides="6" material="fortress_ice_deep" />
  <cone pos="-50 80 {-40 - 90}" rot="-90 0 0" radius="30" height="180" sides="6" material="fortress_ice_deep" />
  <cone pos="-50 -80 {-40 - 130}" rot="-90 0 0" radius="32" height="260" sides="6" material="fortress_ice_deep" />
  <!-- The sun crystal and its light. -->
  <group name="glow">
    <cone pos="0 0 {-ST - GL/4}" rot="-90 0 0" radius="62" height="{GL/2}" sides="6" color="0.92 0.98 1.0" unlit="1" castShadow="0" />
    <cone pos="0 0 {-ST - 3*GL/4}" rot="90 0 0" radius="62" height="{GL/2}" sides="6" color="0.92 0.98 1.0" unlit="1" castShadow="0" />
  </group>
  <light pos="0 0 {-ST - GL/2}" color="0.86 0.94 1.0" intensity="1.7" radius="2600" castShadows="1" />
</prefab>
