<!-- A mainframe cabinet of the 1980s (the Star 7's diagnostic banks): 70 wide x 80 deep x 185 tall, beige
     with a blue band under the top, a dark front panel of indicator lamps and a louvred lower door.
     Baseline z=0; origin on the floor under the middle of the front face; front faces local -Y, the cabinet
     runs back to y=80. Materials: beige_dark, rack_blue, dark_metal, lamp_green, lamp_amber, lamp_red. -->
<prefab up="z" front="-y">
  <let name="W" value="70" />
  <let name="D" value="80" />
  <let name="H" value="185" />
  <box pos="0 {D/2} {H/2}" size="{W} {D} {H}" material="beige_dark" />
  <box pos="0 {D/2} {H - 14}" size="{W + 1} {D + 1} 12" material="rack_blue" />
  <box pos="0 -0.5 128" size="{W - 14} 1 58" material="dark_metal" />
  <box pos="-24 -1.2 106" size="3 0.4 3" material="lamp_green" unlit="1" castShadow="0"><array count="7" translation="8 0 0" /><array count="3" translation="0 0 16" /></box>
  <box pos="-20 -1.2 114" size="3 0.4 3" material="lamp_amber" unlit="1" castShadow="0"><array count="6" translation="8 0 0" /><array count="3" translation="0 0 16" /></box>
  <box pos="-24 -1.2 150" size="3 0.4 3" material="lamp_red" unlit="1" castShadow="0"><array count="2" translation="40 0 0" /></box>
  <box pos="0 -0.5 52" size="{W - 14} 1 80" material="beige" />
  <box pos="0 -1.4 22" size="{W - 22} 0.8 2" material="dark_metal"><array count="10" translation="0 0 6" /></box>
</prefab>
