<!-- A broadleaf campus tree (maple), about 7.5 m tall: a tapering trunk and three overlapping leafy masses.
     Footprint a circle of radius ~260 at the crown; baseline z=0 at the foot of the trunk. Materials: bark, leaves. -->
<prefab up="z">
  <cylinder pos="0 0 170" rot="90 0 0" radius="16" height="340" material="bark"><taper amount="-0.35" /></cylinder>
  <sphere pos="0 0 520" radius="220" scale="1 1 0.9" material="leaves"><noise strength="0.18" seed="3" /></sphere>
  <sphere pos="90 60 430" radius="150" material="leaves"><noise strength="0.14" seed="5" /></sphere>
  <sphere pos="-100 -50 450" radius="140" material="leaves"><noise strength="0.14" seed="8" /></sphere>
</prefab>
