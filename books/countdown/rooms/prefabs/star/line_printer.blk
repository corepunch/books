<!-- A 1980s band line printer: a beige cabinet 150 x 70 x 92 with a smoked acoustic lid, a lamp panel and
     fanfold paper feeding out of its top slot down into a stack in the tray on the floor before it.
     Baseline z=0; origin on the floor under the middle of the front face; front faces local -Y, the cabinet
     runs back to y=70 and the paper stack sits in front to y=-36. Materials: beige, beige_dark, smoked,
     dark_metal, paper, lamp_green. -->
<prefab up="z" front="-y">
  <let name="W" value="150" />
  <let name="D" value="70" />
  <let name="H" value="92" />
  <box pos="0 {D/2} {H/2}" size="{W} {D} {H}" material="beige" />
  <box pos="0 {D/2 + 4} {H + 9}" size="{W - 10} {D - 8} 18" material="smoked" />
  <box pos="40 -0.5 {H - 14}" size="44 1 14" material="dark_metal" />
  <box pos="26 -1.2 {H - 14}" size="4 0.4 3" material="lamp_green" unlit="1" castShadow="0"><array count="4" translation="9 0 0" /></box>
  <box pos="-30 -0.5 40" size="60 1 50" material="beige_dark" />
  <!-- Fanfold paper: the sheet leaving the slot at the front of the lid, and the folded stack in its tray. -->
  <box pos="-30 -20 4" size="44 32 8" material="dark_metal" />
  <box pos="-30 -20 15" size="38 28 14" material="paper" />
  <box pos="-30 -8.5 {(22 + H)/2}" rot="{-deg(atan2(15, H - 22))} 0 0" size="38 0.4 {hypot(15, H - 22)}" material="paper" />
</prefab>
