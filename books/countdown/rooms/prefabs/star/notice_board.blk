<!-- A cork notice board 120 x 80 with pinned memos and a shift rota, hung on the wall. Origin on the wall
     face at the board's centre; it faces local -Y. Materials: cork, trim, paper, memo_yellow. -->
<prefab up="z" front="-y">
  <box pos="0 -1.5 0" size="120 3 80" material="trim" />
  <box pos="0 -3.1 0" size="112 0.2 72" material="cork" />
  <box pos="-36 -3.3 12" rot="0 4 0" size="22 0.2 30" material="paper" />
  <box pos="-8 -3.3 18" rot="0 -3 0" size="21 0.2 28" material="paper" />
  <box pos="26 -3.3 8" rot="0 2 0" size="36 0.2 24" material="paper" />
  <box pos="-20 -3.3 -20" rot="0 -6 0" size="14 0.2 14" material="memo_yellow" />
  <box pos="18 -3.3 -22" rot="0 5 0" size="26 0.2 18" material="paper" />
</prefab>
