<?xml version="1.0" encoding="UTF-8"?>
<!-- A Metropolis setback skyscraper in three tiers (2000 x 1800, 1400 x 1200 and 800 x 700 cm) with lit windows on every face and a spire with a red beacon. Baseline z=0 on the street; tier roofs at 4260, 7820 and 9300 cm, spire tip 10580 cm. Origin on the street at the centre of the footprint. Front -Y (all faces alike). Materials from the scene: tower_facade, tower_band, glass_dark, window_lit, roof_dark, beacon_red. -->
<prefab up="z" front="-y">
  <let name="AW" value="2000" />
  <let name="AD" value="1800" />
  <let name="AZ" value="0" />
  <let name="AH" value="4200" />
  <box pos="0 0 {AZ + AH/2}" size="{AW} {AD} {AH}" material="tower_facade" />
  <group rot="0 0 0">
    <box pos="0 {-AD/2 - 4} {AZ + 350}" size="{AW - 40} 4 40" material="tower_band"><array count="11" translation="0 0 350" /></box>
    <box pos="{-(9 - 1)*200/2 + 0*200} {-AD/2 - 2} {AZ + AH/2}" size="110 3 {AH - 120}" material="glass_dark" />
