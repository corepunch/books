<?xml version="1.0" encoding="UTF-8"?>
<!-- A Metropolis office slab, sixteen storeys: glass columns, spandrel bands and scattered lit windows on all faces, a roof slab and a mast with a red warning beacon. Footprint 1600 x 1200 cm, baseline z=0 on the street, roof 5680 cm, beacon 6335 cm. Origin on the street at the centre of the footprint. Front -Y (all faces alike). Materials from the scene: tower_facade, tower_band, glass_dark, window_lit, roof_dark, beacon_red. -->
<prefab up="z" front="-y">
  <let name="W" value="1600" />
  <let name="D" value="1200" />
  <let name="Z" value="0" />
  <let name="H" value="5600" />
  <box pos="0 0 {Z + H/2}" size="{W} {D} {H}" material="tower_facade" />
  <group rot="0 0 0">
    <box pos="0 {-D/2 - 4} {Z + 350}" size="{W - 40} 4 40" material="tower_band"><array count="15" translation="0 0 350" /></box>
    <box pos="{-(7 - 1)*200/2 + 0*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(7 - 1)*200/2 + 1*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(7 - 1)*200/2 + 2*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(7 - 1)*200/2 + 3*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(7 - 1)*200/2 + 3*200} {-D/2 - 4.8} {Z + 2*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="5" translation="0 0 1050" /></box>
    <box pos="{-(7 - 1)*200/2 + 4*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(7 - 1)*200/2 + 4*200} {-D/2 - 4.8} {Z + 1*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="5" translation="0 0 700" /></box>
    <box pos="{-(7 - 1)*200/2 + 5*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(7 - 1)*200/2 + 5*200} {-D/2 - 4.8} {Z + 0*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="15" translation="0 0 350" /></box>
    <box pos="{-(7 - 1)*200/2 + 6*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
  </group>
  <group rot="0 0 90">
    <box pos="0 {-W/2 - 4} {Z + 350}" size="{D - 40} 4 40" material="tower_band"><array count="15" translation="0 0 350" /></box>
    <box pos="{-(5 - 1)*200/2 + 0*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(5 - 1)*200/2 + 0*200} {-W/2 - 4.8} {Z + 3*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="3" translation="0 0 1400" /></box>
    <box pos="{-(5 - 1)*200/2 + 1*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(5 - 1)*200/2 + 1*200} {-W/2 - 4.8} {Z + 5*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="2" translation="0 0 1400" /></box>
    <box pos="{-(5 - 1)*200/2 + 2*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(5 - 1)*200/2 + 2*200} {-W/2 - 4.8} {Z + 0*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="8" translation="0 0 350" /></box>
    <box pos="{-(5 - 1)*200/2 + 3*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(5 - 1)*200/2 + 3*200} {-W/2 - 4.8} {Z + 1*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="4" translation="0 0 1400" /></box>
    <box pos="{-(5 - 1)*200/2 + 4*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(5 - 1)*200/2 + 4*200} {-W/2 - 4.8} {Z + 2*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="4" translation="0 0 1400" /></box>
  </group>
  <group rot="0 0 180">
    <box pos="0 {-D/2 - 4} {Z + 350}" size="{W - 40} 4 40" material="tower_band"><array count="15" translation="0 0 350" /></box>
    <box pos="{-(7 - 1)*200/2 + 0*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(7 - 1)*200/2 + 1*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(7 - 1)*200/2 + 1*200} {-D/2 - 4.8} {Z + 2*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="4" translation="0 0 1050" /></box>
    <box pos="{-(7 - 1)*200/2 + 2*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(7 - 1)*200/2 + 2*200} {-D/2 - 4.8} {Z + 1*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="5" translation="0 0 1050" /></box>
    <box pos="{-(7 - 1)*200/2 + 3*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(7 - 1)*200/2 + 3*200} {-D/2 - 4.8} {Z + 1*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="3" translation="0 0 1050" /></box>
    <box pos="{-(7 - 1)*200/2 + 4*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(7 - 1)*200/2 + 5*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(7 - 1)*200/2 + 5*200} {-D/2 - 4.8} {Z + 4*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="1" translation="0 0 1400" /></box>
    <box pos="{-(7 - 1)*200/2 + 6*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(7 - 1)*200/2 + 6*200} {-D/2 - 4.8} {Z + 0*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="14" translation="0 0 350" /></box>
  </group>
  <group rot="0 0 -90">
    <box pos="0 {-W/2 - 4} {Z + 350}" size="{D - 40} 4 40" material="tower_band"><array count="15" translation="0 0 350" /></box>
    <box pos="{-(5 - 1)*200/2 + 0*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(5 - 1)*200/2 + 0*200} {-W/2 - 4.8} {Z + 2*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="7" translation="0 0 700" /></box>
    <box pos="{-(5 - 1)*200/2 + 1*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(5 - 1)*200/2 + 1*200} {-W/2 - 4.8} {Z + 2*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="7" translation="0 0 700" /></box>
    <box pos="{-(5 - 1)*200/2 + 2*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(5 - 1)*200/2 + 2*200} {-W/2 - 4.8} {Z + 4*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="2" translation="0 0 1050" /></box>
    <box pos="{-(5 - 1)*200/2 + 3*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(5 - 1)*200/2 + 3*200} {-W/2 - 4.8} {Z + 2*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="8" translation="0 0 350" /></box>
    <box pos="{-(5 - 1)*200/2 + 4*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
  </group>
  <box pos="0 0 {Z + H + 40}" size="{W + 20} {D + 20} 80" material="roof_dark" />
  <cylinder pos="-400 0 {Z + H + 79 + 300}" rot="90 0 0" radius="8" height="600" sides="8" material="roof_dark" />
  <sphere pos="-400 0 {Z + H + 80 + 610}" radius="45" material="beacon_red" unlit="1" castShadow="0" />
</prefab>
