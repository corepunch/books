<?xml version="1.0" encoding="UTF-8"?>
<!-- A Metropolis riverside apartment block, six storeys: glass columns between spandrel bands and warm lit windows on all four faces, a roof slab and a stair house. Footprint 2000 x 1400 cm, baseline z=0 on the street, roof 2190 cm. Origin on the street at the centre of the footprint. Front -Y (all faces are dressed alike). Materials from the scene: tower_facade, tower_band, glass_dark, window_lit, roof_dark, beacon_red. -->
<prefab up="z" front="-y">
  <let name="W" value="2000" />
  <let name="D" value="1400" />
  <let name="Z" value="0" />
  <let name="H" value="2100" />
  <box pos="0 0 {Z + H/2}" size="{W} {D} {H}" material="tower_facade" />
  <group rot="0 0 0">
    <box pos="0 {-D/2 - 4} {Z + 350}" size="{W - 40} 4 40" material="tower_band"><array count="5" translation="0 0 350" /></box>
    <box pos="{-(9 - 1)*200/2 + 0*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 0*200} {-D/2 - 4.8} {Z + 3*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="1" translation="0 0 1050" /></box>
    <box pos="{-(9 - 1)*200/2 + 1*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 1*200} {-D/2 - 4.8} {Z + 1*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="1" translation="0 0 1050" /></box>
    <box pos="{-(9 - 1)*200/2 + 2*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 3*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 3*200} {-D/2 - 4.8} {Z + 1*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="1" translation="0 0 1050" /></box>
    <box pos="{-(9 - 1)*200/2 + 4*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 4*200} {-D/2 - 4.8} {Z + 0*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="3" translation="0 0 700" /></box>
    <box pos="{-(9 - 1)*200/2 + 5*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 6*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 6*200} {-D/2 - 4.8} {Z + 2*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="3" translation="0 0 350" /></box>
    <box pos="{-(9 - 1)*200/2 + 7*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 8*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 8*200} {-D/2 - 4.8} {Z + 1*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="1" translation="0 0 1050" /></box>
  </group>
  <group rot="0 0 90">
    <box pos="0 {-W/2 - 4} {Z + 350}" size="{D - 40} 4 40" material="tower_band"><array count="5" translation="0 0 350" /></box>
    <box pos="{-(6 - 1)*200/2 + 0*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(6 - 1)*200/2 + 1*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(6 - 1)*200/2 + 1*200} {-W/2 - 4.8} {Z + 0*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="4" translation="0 0 350" /></box>
    <box pos="{-(6 - 1)*200/2 + 2*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(6 - 1)*200/2 + 2*200} {-W/2 - 4.8} {Z + 2*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="2" translation="0 0 1050" /></box>
    <box pos="{-(6 - 1)*200/2 + 3*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(6 - 1)*200/2 + 3*200} {-W/2 - 4.8} {Z + 1*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="3" translation="0 0 700" /></box>
    <box pos="{-(6 - 1)*200/2 + 4*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(6 - 1)*200/2 + 4*200} {-W/2 - 4.8} {Z + 2*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="2" translation="0 0 350" /></box>
    <box pos="{-(6 - 1)*200/2 + 5*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(6 - 1)*200/2 + 5*200} {-W/2 - 4.8} {Z + 3*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="1" translation="0 0 700" /></box>
  </group>
  <group rot="0 0 180">
    <box pos="0 {-D/2 - 4} {Z + 350}" size="{W - 40} 4 40" material="tower_band"><array count="5" translation="0 0 350" /></box>
    <box pos="{-(9 - 1)*200/2 + 0*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 0*200} {-D/2 - 4.8} {Z + 1*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="3" translation="0 0 700" /></box>
    <box pos="{-(9 - 1)*200/2 + 1*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 1*200} {-D/2 - 4.8} {Z + 2*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="2" translation="0 0 350" /></box>
    <box pos="{-(9 - 1)*200/2 + 2*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 2*200} {-D/2 - 4.8} {Z + 3*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="1" translation="0 0 700" /></box>
    <box pos="{-(9 - 1)*200/2 + 3*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 4*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 5*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 5*200} {-D/2 - 4.8} {Z + 0*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="2" translation="0 0 700" /></box>
    <box pos="{-(9 - 1)*200/2 + 6*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 6*200} {-D/2 - 4.8} {Z + 3*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="1" translation="0 0 1400" /></box>
    <box pos="{-(9 - 1)*200/2 + 7*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 7*200} {-D/2 - 4.8} {Z + 1*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="2" translation="0 0 1400" /></box>
    <box pos="{-(9 - 1)*200/2 + 8*200} {-D/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(9 - 1)*200/2 + 8*200} {-D/2 - 4.8} {Z + 2*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="1" translation="0 0 700" /></box>
  </group>
  <group rot="0 0 -90">
    <box pos="0 {-W/2 - 4} {Z + 350}" size="{D - 40} 4 40" material="tower_band"><array count="5" translation="0 0 350" /></box>
    <box pos="{-(6 - 1)*200/2 + 0*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(6 - 1)*200/2 + 1*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(6 - 1)*200/2 + 2*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(6 - 1)*200/2 + 2*200} {-W/2 - 4.8} {Z + 0*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="1" translation="0 0 700" /></box>
    <box pos="{-(6 - 1)*200/2 + 3*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(6 - 1)*200/2 + 3*200} {-W/2 - 4.8} {Z + 1*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="1" translation="0 0 1050" /></box>
    <box pos="{-(6 - 1)*200/2 + 4*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(6 - 1)*200/2 + 4*200} {-W/2 - 4.8} {Z + 1*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="2" translation="0 0 700" /></box>
    <box pos="{-(6 - 1)*200/2 + 5*200} {-W/2 - 2} {Z + H/2}" size="110 3 {H - 120}" material="glass_dark" />
    <box pos="{-(6 - 1)*200/2 + 5*200} {-W/2 - 4.8} {Z + 1*350 + 350/2 + 10}" size="92 3 220" material="window_lit" unlit="1" castShadow="0"><array count="5" translation="0 0 350" /></box>
  </group>
  <box pos="0 0 {Z + H + 30}" size="{W + 20} {D + 20} 60" material="roof_dark" />
  <box pos="300 200 {Z + H + 60 + 70}" size="260 260 140" material="roof_dark" />
</prefab>
