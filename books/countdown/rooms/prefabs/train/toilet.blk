<?xml version="1.0" encoding="UTF-8"?>
<!-- A railway stainless-steel toilet: flared pedestal, oval bowl rim, closed seat lid and the flush unit
     against the wall with its push button. Footprint 40 x 52 cm, lid at 43 cm, flush unit 52 cm high.
     Origin on the floor under the middle of the bowl. Front -Y: the user faces local -Y; the flush unit
     stands against a wall whose face is at y=+30. Materials from the scene: steel, seat_shell. -->
<prefab up="z" front="-y">
  <let name="RIM" value="38" />
  <let name="OV" value="1.15" />   <!-- oval stretch along Y -->
  <let name="BACK" value="30" />
  <cone pos="0 0 {RIM/2 - 1}" rot="90 0 0" scale="1 1 {OV}" radius="13" radiusTop="17" height="{RIM - 2}" material="steel" />
  <torus pos="0 0 {RIM}" rot="90 0 0" scale="1 1 {OV}" majorRadius="15" minorRadius="3" material="steel" />
  <cylinder pos="0 -1 {RIM + 4}" rot="90 0 0" scale="1 1 {OV}" radius="18" height="2" material="seat_shell" />
  <box pos="0 {BACK - 7} 26" size="40 14 52" material="steel" />
  <cylinder pos="0 {BACK - 7} 53" rot="90 0 0" radius="3" height="2" color="0.20 0.20 0.22" />
</prefab>
