<?xml version="1.0" encoding="UTF-8"?>
<!-- The restroom washbasin unit: a laminate vanity cabinet with a steel counter and basin, a swan-neck tap,
     a soap dispenser and the mirror above it, all fixed to one wall. Footprint 46 x 36 cm, counter at
     80 cm, mirror up to 167 cm. Origin on the floor at the wall face, under the middle of the unit.
     Front -Y: the unit projects from the wall (y=0) into the room along local -Y.
     Materials from the scene: restroom_panel, steel, mirror. -->
<prefab up="z" front="-y">
  <let name="CT" value="80" />  <!-- counter top -->
  <box pos="0 -16 {(CT - 4)/2}" size="44 32 {CT - 4}" material="restroom_panel" />
  <box pos="0 -18 {CT - 2}" size="46 36 4" material="steel" />
  <cylinder pos="0 -20 {CT + 0.3}" rot="90 0 0" radius="13" height="1" color="0.30 0.31 0.33" shininess="70" />
  <cylinder pos="0 -4 {CT + 6}" rot="90 0 0" radius="1.3" height="12" material="steel" />
  <box pos="0 -8.5 {CT + 11}" size="2 9 2" material="steel" />
  <box pos="17 -3 {CT + 26}" size="8 6 12" color="0.82 0.82 0.78" />
  <box pos="0 -0.5 {CT + 60}" size="44 1 54" material="steel" />
  <box pos="0 -0.9 {CT + 60}" size="40 1 50" material="mirror" />
</prefab>
