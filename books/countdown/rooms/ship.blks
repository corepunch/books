<?xml version='1.0' encoding='UTF-8'?>
<!-- Обратный отсчёт: inside Brainiac's ship. Z up, cm, X east, Y north.
     The Red Sun Room (floor z=0): 1800 square, 900 high, lined with lead plates. A 300 cm red globe hangs
     from the ceiling over the round Red Solar Generator; between them a column of red light holds its
     prisoner floating 150 cm up, over the restraint bed. Round the walls: the computer relay (NW), the
     holographic projector (NE) with the screen beside it, the drone bank (N), the bent particle
     accelerator (S), the lead-doored kryptonite vault (SW alcove) and the elevator tube to the command
     level (SE). Brainiac's demonstration canister stands on a stand near the generator. Four energy
     cannons fold into the ceiling. The command level (floor z=3000): a round deck, 1800 across, the
     throne facing the great viewscreen (N), the seeding tanks and their valves (W) that pump Bacteria to
     the nozzles under the hull, a rack of canisters (E), the elevator (S). Superman is authored 50 m
     below; camera transforms give world positions. -->
<scene up="z" ambient="0.20 0.12 0.14" background="0.02 0.02 0.03">
  <camera name="red-show-brainiac" comment="Brainiac stands over the floating Superman, a canister in his claw; drones swarm, scanning him" pos="-420 -420 420" look="160 60 180" fov="62" textRect="0.04 0.035 0.92 0.28" textScale="1">
    <transform target="Superman" pos="95 0 5200" rot="-90 0 90" />
    <use-pose instance="Superman" name="Float" />
    <transform target="Brainiac" pos="0 0 3000" />
    <transform target="StandCanister" pos="0 0 -3000" />
  </camera>
  <camera name="red-show-room" comment="Alone: Superman floats in the red light; drones buzz within reach; the canister on its stand; the vault in the corner" pos="700 600 560" look="-200 -300 200" fov="70" textRect="0.03 0.04 0.40 0.66" textScale="1">
    <transform target="Superman" pos="95 0 5200" rot="-90 0 90" />
    <use-pose instance="Superman" name="Float" />
  </camera>
  <camera name="red-catch" comment="Close: Superman's fingers close on a drone; its thrusters whine" pos="-260 -320 260" look="40 60 150" fov="58" textRect="0.04 0.035 0.92 0.28" textScale="1">
    <transform target="Superman" pos="95 0 5200" rot="-90 0 90" />
    <use-pose instance="Superman" name="Float" />
    <transform target="HeldDrone" pos="0 0 3000" />
    <transform target="NearDrone" pos="0 0 -3000" />
  </camera>
  <camera name="red-chaos" comment="The canister's nozzle spews purple; drones crash, screens flash, the red globe gutters and Superman falls free" pos="-640 -330 560" look="160 180 190" fov="62" textRect="0.04 0.035 0.92 0.28" textScale="1">
    <transform target="Superman" pos="0 -60 5040" rot="-60 20 120" />
    <use-pose instance="Superman" name="Float" />
    <transform target="Spew" pos="0 0 3000" />
    <transform target="Drones" pos="0 0 -3000" />
    <transform target="Crashed" pos="0 0 3000" />
    <transform target="RedOn" pos="0 0 -3000" />
    <transform target="RedOff" pos="0 0 3000" />
  </camera>
  <camera name="red-show-free" comment="In the dark room Superman stands up, strong again; the vault's lead door, the elevator tube, the hull wall" pos="650 650 650" look="-150 -300 150" fov="76" textRect="0.04 0.035 0.92 0.28" textScale="1">
    <transform target="Superman" pos="60 -160 5000" rot="0 0 150" />
    <use-pose instance="Superman" name="HandsOnHips" />
    <transform target="Drones" pos="0 0 -3000" />
    <transform target="Crashed" pos="0 0 3000" />
    <transform target="RedOn" pos="0 0 -3000" />
    <transform target="RedOff" pos="0 0 3000" />
    <transform target="Emergency" pos="0 0 3000" />
  </camera>
  <camera name="red-drain" comment="Ending: four cannons drop from the ceiling and pour white beams into the floating Superman" pos="-640 -330 560" look="160 180 250" fov="62" textRect="0.04 0.035 0.92 0.28" textScale="1">
    <transform target="Superman" pos="95 0 5200" rot="-90 0 90" />
    <use-pose instance="Superman" name="Float" />
    <transform target="Cannons" pos="0 0 3000" />
    <transform target="Drones" pos="0 0 -3000" />
  </camera>
  <camera name="red-kryptonite" comment="Ending: the vault's lead door torn open; green light pours out and Superman sinks to his knees" pos="420 -780 420" look="-500 -300 150" fov="62" textRect="0.04 0.035 0.92 0.28" textScale="1">
    <transform target="Superman" pos="-380 -500 5000" rot="0 0 -110" />
    <use-pose instance="Superman" name="Kneel" />
    <transform target="VaultDoor" pos="0 0 -3000" />
    <transform target="VaultOpen" pos="0 0 3000" />
    <transform target="Drones" pos="0 0 -3000" />
    <transform target="Crashed" pos="0 0 3000" />
    <transform target="RedOn" pos="0 0 -3000" />
    <transform target="RedOff" pos="0 0 3000" />
    <transform target="Emergency" pos="0 0 3000" />
  </camera>
  <camera name="cmd-show-brainiac" comment="The command level: Brainiac turns in his throne, fingers in the control slots; the viewscreen shows Earth; the seeding tanks and the canister rack" pos="0 -800 3430" look="0 250 3200" fov="72" textRect="0.04 0.035 0.92 0.28" textScale="1">
    <transform target="Superman" pos="-150 -100 8000" rot="0 0 157" />
    <use-pose instance="Superman" name="HandsOnHips" />
  </camera>
  <camera name="cmd-spray" comment="Superman sprays the antidote into the open intake of the seeding tanks" pos="150 -420 3320" look="-650 0 3150" fov="64" textRect="0.04 0.035 0.92 0.28" textScale="1">
    <transform target="Superman" pos="-470 180 8000" rot="0 0 -90" />
    <use-pose instance="Superman" name="Hold" />
    <transform target="Spray" pos="0 0 20000" />
    <transform target="CarriedSprayer" pos="0 0 20000" />
  </camera>
  <camera name="cmd-essence" comment="Ending: Brainiac's skull cracks; a glowing knot of light escapes up through the dome" pos="0 -800 3430" look="0 250 3300" fov="72" textRect="0.04 0.035 0.92 0.28" textScale="1">
    <transform target="Superman" pos="160 -160 8000" rot="0 0 160" />
    <use-pose instance="Superman" name="Point" />
    <transform target="Brainiac2" rot="0 30 0" />
    <transform target="Essence" pos="0 0 20000" />
  </camera>
  <camera name="cmd-frozen" comment="Ending: Brainiac sits frozen, crusted purple with his own Bacteria; on the viewscreen purple clouds still drift over Earth" pos="0 -800 3430" look="0 250 3200" fov="72" textRect="0.04 0.035 0.92 0.28" textScale="1">
    <transform target="Superman" pos="160 -160 8000" rot="0 0 160" />
    <use-pose instance="Superman" name="HandsOnHips" />
    <transform target="Crust" pos="0 0 20000" />
    <transform target="PurpleEarth" pos="0 0 20000" />
  </camera>
  <camera name="cmd-victory" comment="Ending: Brainiac frozen in his throne, the empty canister at Superman's feet, the viewscreen Earth clean and blue" pos="0 -800 3430" look="0 250 3200" fov="72" textRect="0.04 0.035 0.92 0.28" textScale="1">
    <transform target="Superman" pos="160 -160 8000" rot="0 0 160" />
    <use-pose instance="Superman" name="HandsOnHips" />
    <transform target="Crust" pos="0 0 20000" />
    <transform target="Empty" pos="0 0 20000" />
  </camera>

  <material id="lead" color="0.30 0.31 0.33" shininess="20" />
  <material id="lead_dark" color="0.20 0.21 0.23" shininess="20" />
  <material id="ship_hull" color="0.46 0.56 0.50" shininess="60" />
  <material id="ship_rib" color="0.30 0.36 0.34" shininess="50" />
  <material id="ship_dark" color="0.12 0.14 0.14" shininess="40" />
  <material id="brain_net" color="0.62 0.30 0.72" shininess="90" />
  <material id="drone" color="0.56 0.60 0.62" shininess="80" />
  <material id="canister" color="0.70 0.72 0.74" shininess="90" />
  <material id="gunmetal" color="0.14 0.14 0.16" shininess="60" />
  <material id="screen" color="0.06 0.08 0.10" shininess="40" />
  <material id="glass" color="0.50 0.62 0.70" shininess="90" />
  <material id="bacteria" color="0.62 0.28 0.74" shininess="40" />
  <material id="earth" color="0.20 0.42 0.74" shininess="40" />
  <material id="land" color="0.30 0.56 0.30" shininess="10" />

  <!-- The Red Sun Room. -->
  <box pos="0 0 -10" size="1840 1840 20" material="lead_dark" />
  <box pos="0 0 910" size="1840 1840 20" material="lead_dark" />
  <box pos="0 920 450" size="1840 40 900" material="lead" />
  <box pos="0 -920 450" size="1840 40 900" material="lead" />
  <box pos="-920 0 450" size="40 1840 900" material="lead" />
  <box pos="920 0 450" size="40 1840 900" material="lead" />
  <box pos="0 898 200" size="1800 4 6" material="lead_dark"><array count="6" translation="0 0 120" /></box>
  <box pos="-898 0 200" size="4 1800 6" material="lead_dark"><array count="6" translation="0 0 120" /></box>
  <box pos="898 0 200" size="4 1800 6" material="lead_dark"><array count="6" translation="0 0 120" /></box>
  <box pos="0 -898 200" size="1800 4 6" material="lead_dark"><array count="6" translation="0 0 120" /></box>
  <!-- The generator, the globe and the light between them; and the same, burnt out. -->
  <cylinder pos="0 0 30" rot="90 0 0" radius="160" height="60" material="ship_dark" />
  <cylinder pos="0 0 64" rot="90 0 0" radius="120" height="8" material="ship_rib" />
  <cylinder pos="0 0 880" rot="90 0 0" radius="60" height="60" material="ship_dark" />
  <group name="RedOn">
    <sphere pos="0 0 740" radius="150" color="1.0 0.16 0.08" unlit="1" castShadow="0" />
    <light pos="0 0 560" color="1.0 0.22 0.14" intensity="1.6" radius="1600" castShadows="1" />
    <cylinder pos="110 0 400" rot="90 0 0" radius="3" height="620" color="1.0 0.25 0.12" unlit="1" castShadow="0" />
    <cylinder pos="-110 0 400" rot="90 0 0" radius="3" height="620" color="1.0 0.25 0.12" unlit="1" castShadow="0" />
    <cylinder pos="0 110 400" rot="90 0 0" radius="3" height="620" color="1.0 0.25 0.12" unlit="1" castShadow="0" />
    <cylinder pos="0 -110 400" rot="90 0 0" radius="3" height="620" color="1.0 0.25 0.12" unlit="1" castShadow="0" />
  </group>
  <group name="RedOff" pos="0 0 -3000">
    <sphere pos="0 0 740" radius="150" color="0.24 0.08 0.06" />
  </group>
  <group name="Emergency" pos="0 0 -3000">
    <light pos="300 -500 850" color="0.70 0.80 1.0" intensity="0.7" radius="1500" castShadows="1" />
  </group>
  <!-- The restraint bed under the light, with its open straps. -->
  <box pos="-20 0 35" size="230 100 70" material="ship_rib" />
  <box pos="-20 -55 72" size="12 12 4" material="gunmetal"><array count="3" translation="80 0 0" /></box>
  <!-- Round the walls. -->
  <box name="Relay" pos="-750 750 250" size="260 260 500" material="ship_dark" />
  <box pos="-750 618 260" size="200 4 200" color="0.40 1.0 0.80" unlit="1" castShadow="0" />
  <box name="Projector" pos="700 720 200" size="360 300 400" material="ship_rib" />
  <box pos="898 300 420" size="4 500 300" material="screen" />
  <box pos="0 860 150" size="600 100 300" material="ship_dark" />
  <box pos="0 808 150" size="520 4 60" material="gunmetal"><array count="3" translation="0 0 70" /></box>
  <box name="Accelerator" pos="250 -560 120" rot="0 0 -30" size="800 120 120" material="ship_rib" />
  <box pos="-90 -480 120" rot="0 0 60" size="300 120 120" material="ship_rib" />
  <!-- The kryptonite vault in the SW alcove: lead walls and a lead door facing east. -->
  <box pos="-560 -720 300" size="20 380 600" material="lead_dark" />
  <box pos="-730 -550 300" size="360 20 600" material="lead_dark" />
  <group name="VaultDoor"><box pos="-560 -720 250" size="24 240 500" material="lead" /><box pos="-545 -720 250" size="10 30 80" material="gunmetal" /></group>
  <group name="VaultOpen" pos="0 0 -3000">
    <box pos="-450 -620 250" rot="0 0 70" size="24 240 500" material="lead" />
    <prism pos="-760 -760 60" rot="90 0 0" radius="40" height="120" sides="6" color="0.30 1.0 0.40" unlit="1" castShadow="0" />
    <prism pos="-700 -800 50" rot="80 0 30" radius="28" height="90" sides="6" color="0.30 1.0 0.40" unlit="1" castShadow="0" />
    <light pos="-600 -720 200" color="0.40 1.0 0.40" intensity="1.4" radius="1200" castShadows="0" />
  </group>
  <!-- The elevator tube in the SE corner. -->
  <cylinder pos="720 -720 450" rot="90 0 0" radius="130" height="900" tube="8" material="glass" />
  <box pos="720 -588 150" size="140 6 300" material="ship_dark" />
  <!-- The demonstration canister on its stand by the generator. -->
  <box pos="380 260 50" size="70 70 100" material="ship_dark" />
  <group name="StandCanister"><prefab source="props/canister" pos="380 260 100" /></group>
  <!-- Drones round Superman; one within reach, one in his hand; drones crashed after the gas. -->
  <group name="Drones">
    <prefab source="props/drone" pos="-180 -120 240" rot="0 0 30" />
    <prefab source="props/drone" pos="160 -140 260" rot="0 0 -40" />
    <prefab source="props/drone" pos="220 120 320" rot="0 0 120" />
    <prefab source="props/drone" pos="-240 160 200" rot="0 0 200" />
    <prefab source="props/drone" pos="40 -220 330" rot="0 0 10" />
    <prefab source="props/drone" pos="-80 220 300" rot="0 0 160" />
    <group name="NearDrone"><prefab source="props/drone" pos="10 -130 165" rot="0 0 -20" /></group>
  </group>
  <group name="HeldDrone" pos="0 0 -3000"><prefab source="props/drone" pos="18 -80 172" rot="0 0 -20" /></group>
  <group name="Crashed" pos="0 0 -3000">
    <prefab source="props/drone" pos="-200 -300 3" rot="0 8 30" />
    <prefab source="props/drone" pos="260 -200 3" rot="0 -6 80" />
    <prefab source="props/drone" pos="120 300 3" rot="0 4 140" />
    <prefab source="props/drone" pos="-320 120 3" rot="0 0 200" />
    <prefab source="props/canister" pos="300 160 14" rot="0 90 30" />
  </group>
  <group name="Spew" pos="0 0 -3000">
    <sphere pos="340 200 180" radius="120" scale="1.4 1 0.8" material="bacteria" castShadow="0" />
    <sphere pos="200 100 320" radius="160" scale="1.6 1.2 0.6" material="bacteria" castShadow="0" />
    <sphere pos="0 260 520" radius="200" scale="1.8 1.2 0.5" material="bacteria" castShadow="0" />
  </group>
  <group name="Cannons" pos="0 0 -3000">
    <cylinder pos="-400 -400 800" rot="45 0 -45" radius="30" height="200" material="ship_dark" />
    <cylinder pos="400 -400 800" rot="45 0 45" radius="30" height="200" material="ship_dark" />
    <cylinder pos="-400 400 800" rot="-45 0 45" radius="30" height="200" material="ship_dark" />
    <cylinder pos="400 400 800" rot="-45 0 -45" radius="30" height="200" material="ship_dark" />
    <cylinder pos="-200 -200 480" rot="45 0 -45" radius="8" height="520" color="0.95 0.97 1.0" unlit="1" castShadow="0" />
    <cylinder pos="200 -200 480" rot="45 0 45" radius="8" height="520" color="0.95 0.97 1.0" unlit="1" castShadow="0" />
    <cylinder pos="-200 200 480" rot="-45 0 45" radius="8" height="520" color="0.95 0.97 1.0" unlit="1" castShadow="0" />
    <cylinder pos="200 200 480" rot="-45 0 -45" radius="8" height="520" color="0.95 0.97 1.0" unlit="1" castShadow="0" />
  </group>
  <group name="Brainiac" pos="0 0 -3000">
    <prefab source="characters/brainiac" pos="240 -260 0" rot="0 0 -50" pose="Point" />
    <prefab source="props/canister" pos="196 -318 104" rot="0 0 -50" />
  </group>

  <!-- The command level, 30 m above. -->
  <group name="Command" pos="0 0 3000">
    <cylinder pos="0 0 -10" rot="90 0 0" radius="920" height="20" material="ship_dark" />
    <cylinder pos="0 0 350" rot="90 0 0" radius="920" height="700" tube="30" material="ship_rib" castShadow="0" />
    <sphere pos="0 0 700" radius="920" scale="1 1 0.35" material="brain_net" castShadow="0" />
    <box pos="0 870 380" size="1100 30 520" material="screen" />
    <box pos="0 852 380" size="1040 4 470" color="0.04 0.06 0.10" unlit="1" castShadow="0" />
    <prefab source="props/throne" pos="0 260 0" />
    <cylinder pos="-760 400 250" rot="90 0 0" radius="110" height="500" material="ship_rib" />
    <cylinder pos="-760 100 250" rot="90 0 0" radius="110" height="500" material="ship_rib" />
    <box pos="-640 260 150" size="60 380 40" material="gunmetal" />
    <box pos="-600 260 150" size="20 60 60" color="0.70 0.30 0.86" />
    <box pos="780 200 150" size="120 500 20" material="ship_dark"><array count="2" translation="0 0 90" /></box>
    <prefab source="props/canister" pos="780 40 160" />
    <prefab source="props/canister" pos="780 200 160" />
    <prefab source="props/canister" pos="780 360 160" />
    <prefab source="props/canister" pos="780 120 250" />
    <prefab source="props/canister" pos="780 280 250" />
    <cylinder pos="0 -860 300" rot="90 0 0" radius="130" height="600" tube="8" material="glass" />
    <box pos="-700 650 600" rot="0 0 40" size="80 120 60" material="ship_dark" />
    <box pos="700 650 600" rot="0 0 -40" size="80 120 60" material="ship_dark" />
    <light pos="250 -250 600" color="0.80 0.90 1.0" intensity="1.4" radius="1800" castShadows="1" />
    <light pos="0 820 380" color="0.40 0.60 1.0" intensity="0.4" radius="900" castShadows="0" />
    <!-- Earth on the viewscreen; the purple version for the seeding that went on. -->
    <sphere pos="0 860 380" radius="190" scale="1 0.08 1" material="earth" unlit="1" castShadow="0" />
    <sphere pos="-40 852 420" radius="90" scale="1.3 0.06 1" material="land" unlit="1" castShadow="0" />
    <prefab source="characters/brainiac" name="Brainiac2" pos="0 255 50" pose="Throne" />
  </group>
  <group name="Spray" pos="0 0 -20000">
    <cone pos="-600 240 3150" rot="0 0 -90" radius="30" radiusTop="6" height="70" color="0.40 0.90 0.50" unlit="1" castShadow="0" />
  </group>
  <group name="CarriedSprayer" pos="0 0 -20000"><prefab source="props/sprayer" pos="-440 240 3000" rot="0 0 180" /></group>
  <group name="Essence" pos="0 0 -20000">
    <sphere pos="0 250 3330" radius="50" color="0.90 0.70 1.0" unlit="1" castShadow="0" />
    <sphere pos="20 240 3440" radius="30" color="0.90 0.70 1.0" unlit="1" castShadow="0" />
    <cylinder pos="10 245 3420" rot="90 0 0" radius="6" height="240" color="0.90 0.70 1.0" unlit="1" castShadow="0" />
  </group>
  <group name="Crust" pos="0 0 -20000">
    <sphere pos="0 230 3130" radius="38" scale="1 1 1.6" material="bacteria" castShadow="0" />
    <sphere pos="0 240 3240" radius="20" material="bacteria" castShadow="0" />
    <sphere pos="-40 200 3080" radius="16" material="bacteria" castShadow="0" />
    <sphere pos="40 200 3080" radius="16" material="bacteria" castShadow="0" />
  </group>
  <group name="PurpleEarth" pos="0 0 -20000">
    <sphere pos="60 848 3400" radius="120" scale="1.4 0.05 0.8" material="bacteria" unlit="1" castShadow="0" />
  </group>
  <group name="Empty" pos="0 0 -20000"><prefab source="props/canister" pos="160 -230 3014" rot="0 90 60" /></group>

  <prefab source="characters/superman" name="Superman" pos="0 0 -5000" />

  <!-- Anchors. -->
  <group name="Drone" pos="10 -130 165" />
  <group name="Globe" pos="0 0 740" />
  <group name="Stand-Canister" pos="380 260 200" />
  <group name="Vault" pos="-560 -720 250" />
  <group name="Elevator" pos="720 -620 160" />
  <group name="Hull-Wall" pos="-900 200 300" />
  <group name="Brainiac-Throne" pos="0 255 3170" />
  <group name="Canister" pos="780 200 3200" />
  <group name="Seeding-Tanks" pos="-680 260 3150" />
</scene>
