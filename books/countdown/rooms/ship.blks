<?xml version='1.0' encoding='UTF-8'?>
<!-- Обратный отсчёт: inside Brainiac's ship. Z up, centimetres, X east, Y north.

     Resident story. Brainiac built this ship to drink suns and seed worlds. The Red Sun Room is his
     laboratory and his trap: a lead-lined cube 1800 square and 900 high in which a red globe, 300
     across, hangs over the Red Solar Generator and holds a prisoner in its beam while the room's
     cannons drain him. His drones (the size of a pack of cards) charge in the bank on the north wall
     and swarm to scan whatever the beam holds; the computer relay stands on the north wall beside the vault,
     a console on the south wall; a viewscreen on the east wall shows the world below; the kryptonite he keeps for Superman
     sits in a lead vault in the north-west corner, its door facing east. The west wall is the outer
     hull. A glass elevator in the south-east quarter rises to the command deck directly above.
     The command deck is an octagon 1720 across under a purple Brain-Net dome. Brainiac sits on a dais
     in his throne, fingers in its control slots, turned from the great viewscreen (north) toward the
     elevator; three seeding tanks on the north-west wall pump his Bacteria to the nozzles under the
     hull, a rack of canisters stands on the north-east wall, consoles line the north and east walls, the
     deck's relay stands on the west wall, and light bars on the south-west walls are the key light.

     Camera state. Every alternative moment is a named group. Groups not shown by default are stored
     in numbered parking lots below the ship (z = PZ, x = k * LOT, inside the scene's ground plane, so
     the checker accepts them as stored, not floating); a camera brings one in with a transform that
     undoes its lot offset, or parks a default group in its own lot. The two actors are wrapped in
     unrotated groups: <Name>At translates (a world delta), <Name>Yaw turns about Z, SupermanTilt lays
     him on his back (-90 about X) or stands him up (+90 back). Rotations about one axis compose
     cleanly, which a single rotated instance does not.

     Checker exceptions (sanityIgnore): SupermanAt, because in the Red Sun Room the red beam holds
     him floating 150 cm over the generator (in the deck cameras he stands on the floor); the
     hovering drones (Drones, NearDrone, HeldDrone, Falling), which fly on their thruster jets. -->
<scene up="z" ambient="0.17 0.15 0.18" background="0.01 0.01 0.02">
  <!-- Room dimensions. -->
  <let name="RS" value="1800" />
  <let name="HALF" value="RS / 2" />
  <let name="RH" value="900" />
  <let name="WT" value="40" />
  <let name="CEIL" value="40" />
  <let name="FT" value="40" />
  <let name="CZ" value="RH + CEIL + FT" />
  <let name="CIN" value="860" />
  <let name="CWT" value="40" />
  <let name="CWH" value="560" />
  <let name="OCT" value="tan(rad(22.5))" />
  <!-- The globe, the elevator shaft and the throne. -->
  <let name="GZ" value="700" />
  <let name="GR" value="150" />
  <let name="EX" value="510" />
  <let name="EY" value="-510" />
  <let name="TX" value="0" />
  <let name="TY" value="120" />
  <let name="DAIS" value="16" />
  <!-- Actor homes: Superman floats in the beam (his feet at SM, head north); Brainiac sits in his throne. -->
  <let name="SMX" value="0" />
  <let name="SMY" value="-95" />
  <let name="SMZ" value="215" />
  <let name="SMYAW" value="0" />
  <let name="BRX" value="TX" />
  <let name="BRY" value="TY" />
  <let name="BRZ" value="CZ + DAIS" />
  <let name="BRYAW" value="20" />
  <!-- Parking lots for camera state. -->
  <let name="LOT" value="2500" />
  <let name="PZ" value="-3000" />

  <!-- ============================== Red Sun Room cameras ==============================
       Camera pos/look/fov/textRect are literal numbers: the book engine reads them without expressions.
       Transforms inside a camera are Scener-only and use the lets above. -->
  <camera name="red-show-brainiac" comment="Brainiac sets his canister on its stand beside the generator and looks down at Superman floating helpless in the red beam; drones swarm round him, scanning" pos="650 -250 120" look="-250 -200 210" fov="54" textRect="0.04 0.035 0.92 0.26" textScale="1">
    <transform target="BrainiacAt" pos="{-30 - BRX} {-470 - BRY} {0 - BRZ}" />
    <transform target="BrainiacYaw" rot="0 0 {176 - BRYAW}" />
    <use-pose instance="Brainiac" name="SetCanister" />
  </camera>
  <camera name="red-show-room" comment="Alone: Superman floats in the red beam over the generator; drones buzz within reach, one by his hand; the canister on its stand; the lead-doored vault in the corner; the caged globe hums overhead" pos="820 -150 300" look="-200 0 430" fov="64" textRect="0.03 0.04 0.37 0.44" textScale="1" />
  <camera name="red-catch" comment="Close: Superman's fingers close on a drone; its thrusters whine; the red globe above" pos="230 -60 290" look="40 40 235" fov="45" textRect="0.04 0.035 0.92 0.26" textScale="1">
    <transform target="NearDrone" pos="{4 * LOT} 0 {PZ}" />
    <transform target="HeldDrone" pos="{-5 * LOT} 0 {-PZ}" />
    <use-pose instance="Superman" name="FloatCatch" />
  </camera>
  <camera name="red-chaos" comment="The knocked-off nozzle spews purple Bacteria into the machines; drones crash, screens flash, the red globe gutters and Superman tumbles free of the beam" pos="650 200 260" look="-300 -300 300" fov="62" textRect="0.03 0.04 0.46 0.36" textScale="1">
    <transform target="SupermanAt" pos="0 -40 -60" />
    <transform target="SupermanTilt" rot="35 0 0" />
    <transform target="RedOn" pos="{20 * LOT} 0 {PZ}" />
    <transform target="RedDim" pos="{-2 * LOT} 0 {-PZ}" />
    <transform target="Drones" pos="{21 * LOT} 0 {PZ}" />
    <transform target="NearDrone" pos="{4 * LOT} 0 {PZ}" />
    <transform target="Falling" pos="{-6 * LOT} 0 {-PZ}" />
    <transform target="Crashed" pos="{-26 * LOT} 0 {-PZ}" />
    <transform target="Spew" pos="{-7 * LOT} 0 {-PZ}" />
    <transform target="Glitch" pos="{-8 * LOT} 0 {-PZ}" />
  </camera>
  <camera name="red-show-free" comment="In the dark room, by emergency light, Superman stands strong again beside the dead generator; round him the vault's lead door, the elevator cage and the hull wall" pos="760 760 520" look="-250 -200 230" fov="72" textRect="0.04 0.035 0.92 0.26" textScale="1">
    <transform target="SupermanAt" pos="{330 - SMX} {380 - SMY} {0 - SMZ}" />
    <transform target="SupermanTilt" rot="90 0 0" />
    <transform target="SupermanYaw" rot="0 0 {150 - SMYAW}" />
    <use-pose instance="Superman" name="HandsOnHips" />
    <transform target="RedOn" pos="{20 * LOT} 0 {PZ}" />
    <transform target="RedOff" pos="{-1 * LOT} 0 {-PZ}" />
    <transform target="Emergency" pos="{-3 * LOT} 0 {-PZ}" />
    <transform target="Drones" pos="{21 * LOT} 0 {PZ}" />
    <transform target="NearDrone" pos="{4 * LOT} 0 {PZ}" />
    <transform target="Crashed" pos="{-26 * LOT} 0 {-PZ}" />
  </camera>
  <camera name="red-drain" comment="Ending: four cannons drop from the ceiling and pour white beams into the floating Superman; on the east screen the Earth shrinks" pos="-300 -780 300" look="100 150 420" fov="70" textRect="0.04 0.76 0.92 0.21" textScale="1">
    <transform target="CannonsOut" pos="{-10 * LOT} 0 {-PZ}" />
    <transform target="Earth" pos="{22 * LOT} 0 {PZ}" />
    <transform target="EarthSmall" pos="{-19 * LOT} 0 {-PZ}" />
  </camera>
  <camera name="red-kryptonite" comment="Ending: the vault's lead door torn off and thrown down; green light pours out of the niche and Superman sinks to his knees before it" pos="-60 700 260" look="-440 520 130" fov="60" textRect="0.04 0.035 0.92 0.26" textScale="1">
    <transform target="SupermanAt" pos="{-420 - SMX} {690 - SMY} {0 - SMZ}" />
    <transform target="SupermanTilt" rot="90 0 0" />
    <transform target="SupermanYaw" rot="0 0 {-90 - SMYAW}" />
    <use-pose instance="Superman" name="Kneel" />
    <transform target="VaultDoor" pos="{23 * LOT} 0 {PZ}" />
    <transform target="VaultOpen" pos="{-9 * LOT} 0 {-PZ}" />
    <transform target="RedOn" pos="{20 * LOT} 0 {PZ}" />
    <transform target="RedOff" pos="{-1 * LOT} 0 {-PZ}" />
    <transform target="Emergency" pos="{-3 * LOT} 0 {-PZ}" />
    <transform target="Drones" pos="{21 * LOT} 0 {PZ}" />
    <transform target="NearDrone" pos="{4 * LOT} 0 {PZ}" />
    <transform target="Crashed" pos="{-26 * LOT} 0 {-PZ}" />
  </camera>

  <!-- ============================== Command deck cameras (deck floor z = 980) ============================== -->
  <camera name="cmd-show-brainiac" comment="The command deck: Brainiac turns in his throne, fingers in the control slots, toward Superman stepping from the elevator; behind him the viewscreen shows Earth; the seeding tanks glow on the left, the canister rack stands on the right" pos="120 -640 1190" look="-40 300 1150" fov="62" textRect="0.04 0.035 0.92 0.26" textScale="1">
    <transform target="SupermanAt" pos="{150 - SMX} {-380 - SMY} {CZ - SMZ}" />
    <transform target="SupermanTilt" rot="90 0 0" />
    <transform target="SupermanYaw" rot="0 0 {-163 - SMYAW}" />
    <use-pose instance="Superman" name="HandsOnHips" />
  </camera>
  <camera name="cmd-spray" comment="Superman holds the antidote sprayer to the opened intake of a seeding tank and a green jet pours in; the purple brew pales; Brainiac jerks round in his throne" pos="-650 -150 1250" look="-300 420 1120" fov="60" textRect="0.04 0.035 0.92 0.26" textScale="1">
    <transform target="SupermanAt" pos="{-350.7 - SMX} {350.7 - SMY} {CZ - SMZ}" />
    <transform target="SupermanTilt" rot="90 0 0" />
    <transform target="SupermanYaw" rot="0 0 {-135 - SMYAW}" />
    <use-pose instance="Superman" name="HoldSprayer" />
    <transform target="HeldSprayer" pos="{-18 * LOT} 0 {-PZ}" />
    <transform target="Spray" pos="{-13 * LOT} 0 {-PZ}" />
    <transform target="IntakeShut" pos="{24 * LOT} 0 {PZ}" />
    <transform target="IntakeOpen" pos="{-12 * LOT} 0 {-PZ}" />
    <transform target="Brew" pos="{25 * LOT} 0 {PZ}" />
    <transform target="BrewPale" pos="{-11 * LOT} 0 {-PZ}" />
  </camera>
  <camera name="cmd-essence" comment="Ending: one blow and Brainiac's skull cracks; a glowing knot of light, his mind, escapes up through the dome while Superman stands over the slumped machine" pos="250 -520 1060" look="0 120 1400" fov="70" textRect="0.04 0.035 0.92 0.26" textScale="1">
    <transform target="SupermanAt" pos="{-150 - SMX} {-60 - SMY} {CZ - SMZ}" />
    <transform target="SupermanTilt" rot="90 0 0" />
    <transform target="SupermanYaw" rot="0 0 {140 - SMYAW}" />
    <use-pose instance="Superman" name="Point" />
    <use-pose instance="Brainiac" name="Slumped" />
    <transform target="Essence" pos="{-16 * LOT} 0 {-PZ}" />
  </camera>
  <camera name="cmd-frozen" comment="Ending: Brainiac sits frozen in his throne, crusted purple with his own Bacteria, the canister jammed in his cracked shell; on the viewscreen behind him purple clouds still drift over Earth" pos="280 -480 1220" look="-20 250 1190" fov="56" textRect="0.04 0.035 0.92 0.26" textScale="1">
    <transform target="SupermanAt" pos="{210 - SMX} {-210 - SMY} {CZ - SMZ}" />
    <transform target="SupermanTilt" rot="90 0 0" />
    <transform target="SupermanYaw" rot="0 0 {-130 - SMYAW}" />
    <use-pose instance="Superman" name="HandsOnHips" />
    <transform target="Crust" pos="{-15 * LOT} 0 {-PZ}" />
    <transform target="PurpleEarth" pos="{-14 * LOT} 0 {-PZ}" />
    <transform target="JammedCanister" pos="{-27 * LOT} 0 {-PZ}" />
  </camera>
  <camera name="cmd-victory" comment="Ending: Brainiac frozen in his throne, crusted with his own Bacteria; the empty canister lies at Superman's feet; the tanks are pale and the viewscreen Earth is clean and blue" pos="-320 -560 1110" look="60 150 1220" fov="62" textRect="0.04 0.035 0.92 0.26" textScale="1">
    <transform target="SupermanAt" pos="{190 - SMX} {-230 - SMY} {CZ - SMZ}" />
    <transform target="SupermanTilt" rot="90 0 0" />
    <transform target="SupermanYaw" rot="0 0 {-160 - SMYAW}" />
    <use-pose instance="Superman" name="HandsOnHips" />
    <transform target="Crust" pos="{-15 * LOT} 0 {-PZ}" />
    <transform target="EmptyCanister" pos="{-17 * LOT} 0 {-PZ}" />
    <transform target="Brew" pos="{25 * LOT} 0 {PZ}" />
    <transform target="BrewPale" pos="{-11 * LOT} 0 {-PZ}" />
  </camera>

  <!-- ============================== Poses for this scene ============================== -->
  <pose name="SetCanister">
    <ik limb="right_arm" target="8 -427 165" bend="-150 -40" />
    <ik limb="left_arm" offset="-4 -24 24" bend="150 -60" />
    <joint target="head" rot="22 0 0" />
  </pose>
  <pose name="FloatCatch">
    <ik limb="left_arm" target="72 50 234" bend="0 -90" />
    <ik limb="right_arm" offset="-40 4 42" bend="0 -90" />
    <ik limb="left_leg" offset="10 0 4" />
    <ik limb="right_leg" offset="-8 0 10" />
    <joint target="head" rot="-12 0 24" />
  </pose>
  <pose name="HoldSprayer">
    <ik limb="left_arm" offset="-4 -40 44" bend="150 -60" />
    <ik limb="right_arm" offset="4 -40 44" bend="-150 -60" />
    <joint target="head" rot="8 0 0" />
  </pose>
  <pose name="Slumped">
    <joint target="pelvis" pos="0 0 -44" />
    <ik limb="left_leg" offset="0 -40 2" />
    <ik limb="right_leg" offset="0 -40 2" />
    <ik limb="left_arm" offset="6 -34 -16" bend="150 -30" />
    <ik limb="right_arm" offset="-6 -34 -16" bend="-150 -30" />
    <joint target="neck" rot="25 0 10" />
    <joint target="head" rot="25 0 15" />
  </pose>

  <!-- ============================== Materials ============================== -->
  <material id="sh_lead" color="0.36 0.38 0.42" shininess="24" />
  <material id="sh_lead_dark" color="0.22 0.23 0.26" shininess="20" />
  <material id="sh_deck" color="0.30 0.31 0.33" shininess="40" />
  <material id="sh_hull" color="0.40 0.48 0.44" shininess="50" />
  <material id="sh_rib" color="0.30 0.36 0.35" shininess="50" />
  <material id="sh_dark" color="0.12 0.13 0.14" shininess="40" />
  <material id="sh_trim" color="0.58 0.64 0.62" shininess="80" />
  <material id="sh_glass" color="0.60 0.74 0.80" shininess="120" />
  <material id="sh_net" color="0.46 0.24 0.58" shininess="70" />
  <material id="gunmetal" color="0.15 0.15 0.17" shininess="60" />
  <material id="bacteria" color="0.62 0.28 0.78" shininess="30" />
  <material id="bacteria_light" color="0.78 0.48 0.90" shininess="30" />
  <material id="bacteria_pale" color="0.80 0.76 0.84" shininess="30" />
  <material id="dead_globe" color="0.26 0.10 0.08" shininess="60" />

  <!-- The command dome's profile: an octagonal shell (lathed with 8 segments), inner then outer arc. -->
  <let name="RI" value="CIN / cos(rad(22.5))" />
  <let name="RO" value="(CIN + CWT) / cos(rad(22.5))" />
  <let name="DHI" value="380" />
  <let name="DHO" value="420" />
  <shape id="dome" closed="0">
    <v x="0" y="{DHI}" />
    <v x="{RI * cos(rad(75))}" y="{DHI * sin(rad(75))}" />
    <v x="{RI * cos(rad(60))}" y="{DHI * sin(rad(60))}" />
    <v x="{RI * cos(rad(45))}" y="{DHI * sin(rad(45))}" />
    <v x="{RI * cos(rad(30))}" y="{DHI * sin(rad(30))}" />
    <v x="{RI * cos(rad(15))}" y="{DHI * sin(rad(15))}" />
    <v x="{RI}" y="0" />
    <v x="{RO}" y="0" />
    <v x="{RO * cos(rad(15))}" y="{DHO * sin(rad(15))}" />
    <v x="{RO * cos(rad(30))}" y="{DHO * sin(rad(30))}" />
    <v x="{RO * cos(rad(45))}" y="{DHO * sin(rad(45))}" />
    <v x="{RO * cos(rad(60))}" y="{DHO * sin(rad(60))}" />
    <v x="{RO * cos(rad(75))}" y="{DHO * sin(rad(75))}" />
    <v x="0" y="{DHO}" />
  </shape>

  <!-- ============================== The Red Sun Room (floor z = 0) ============================== -->
  <group name="RedRoomShell">
    <floor rot="90 0 0" width="{RS + 2 * WT}" depth="{RS + 2 * WT}" thickness="20" style="hexes" tileWidth="110" gap="2" material="sh_deck" colorVariation="0.10" seed="5" groutColor="0.06 0.06 0.07" />
    <wall pos="0 {HALF + WT / 2} 0" rot="90 0 0" length="{RS + 2 * WT}" height="{RH}" thickness="{WT}" lowerHeight="240" lowerMaterial="sh_lead_dark" upperMaterial="sh_lead" />
    <wall pos="0 {-HALF - WT / 2} 0" rot="90 0 180" length="{RS + 2 * WT}" height="{RH}" thickness="{WT}" lowerHeight="240" lowerMaterial="sh_lead_dark" upperMaterial="sh_lead" />
    <wall pos="{HALF + WT / 2} 0 0" rot="90 0 -90" length="{RS}" height="{RH}" thickness="{WT}" lowerHeight="240" lowerMaterial="sh_lead_dark" upperMaterial="sh_lead" />
    <!-- The west wall is the outer hull. -->
    <wall pos="{-HALF - WT / 2} 0 0" rot="90 0 90" length="{RS}" height="{RH}" thickness="{WT}" lowerHeight="240" lowerMaterial="sh_rib" upperMaterial="sh_hull" />
  </group>
  <box name="RedCeiling" pos="0 0 {RH + CEIL / 2}" size="{RS + 2 * WT} {RS + 2 * WT} {CEIL}" material="sh_lead_dark" />
  <!-- Wall ribs: lead pilasters floor to ceiling, and the hull's heavier frames on the west wall. -->
  <group name="RedRibs">
    <box pos="-140 {HALF - 10} {RH / 2}" size="30 20 {RH}" material="sh_lead_dark" />
    <box pos="460 {HALF - 10} {RH / 2}" size="30 20 {RH}" material="sh_lead_dark" />
    <box pos="740 {HALF - 10} {RH / 2}" size="30 20 {RH}" material="sh_lead_dark" />
    <box pos="60 {-HALF + 10} {RH / 2}" size="30 20 {RH}" material="sh_lead_dark" />
    <box pos="330 {-HALF + 10} {RH / 2}" size="30 20 {RH}" material="sh_lead_dark" />
    <box pos="{HALF - 10} -260 {RH / 2}" size="20 30 {RH}" material="sh_lead_dark" />
    <box pos="{HALF - 10} 620 {RH / 2}" size="20 30 {RH}" material="sh_lead_dark" />
  </group>
  <group name="HullFrames">
    <box pos="{-HALF + 15} -660 {RH / 2}" size="30 44 {RH}" material="sh_rib" />
    <box pos="{-HALF + 15} -330 {RH / 2}" size="30 44 {RH}" material="sh_rib" />
    <box pos="{-HALF + 15} 20 {RH / 2}" size="30 44 {RH}" material="sh_rib" />
    <box pos="{-HALF + 15} 370 {RH / 2}" size="30 44 {RH}" material="sh_rib" />
  </group>

  <!-- The Red Solar Generator, the globe's ceiling mount, and the four cannon housings. -->
  <prefab name="Generator" source="ship/generator" />
  <!-- The globe's ceiling mount and cage: three meridian rings and an equator band round the globe. -->
  <group name="GlobeCage">
    <cone pos="0 0 {RH - 25}" rot="90 0 0" radius="40" radiusTop="110" height="50" material="sh_dark" />
    <torus pos="0 0 {GZ}" majorRadius="{GR + 8}" minorRadius="4" majorSegments="48" material="sh_trim" />
    <torus pos="0 0 {GZ}" rot="0 0 60" majorRadius="{GR + 8}" minorRadius="4" majorSegments="48" material="sh_trim" />
    <torus pos="0 0 {GZ}" rot="0 0 120" majorRadius="{GR + 8}" minorRadius="4" majorSegments="48" material="sh_trim" />
    <torus pos="0 0 {GZ}" rot="90 0 0" majorRadius="{GR + 9}" minorRadius="6" majorSegments="48" material="sh_dark" />
  </group>
  <prefab source="ship/cannon_housing" pos="-360 -360 {RH}" />
  <prefab source="ship/cannon_housing" pos="360 -360 {RH}" />
  <prefab source="ship/cannon_housing" pos="-360 360 {RH}" />
  <prefab source="ship/cannon_housing" pos="360 360 {RH}" />

  <!-- Round the walls. -->
  <prefab name="DroneDock" source="ship/drone_dock" pos="120 {HALF} 180" />
  <prefab name="Relay" source="ship/relay" pos="-315 {HALF - 62} 0" />
  <prefab source="ship/console" pos="-200 {-HALF + 31} 0" rot="0 0 180" />
  <prefab name="WallScreen" source="ship/screen" pos="{HALF} 200 320" rot="0 0 -90" />
  <prefab source="ship/console" pos="{HALF - 31} 80 0" rot="0 0 -90" />
  <prefab source="ship/console" pos="{HALF - 31} 320 0" rot="0 0 -90" />
  <prefab name="VaultChamber" source="ship/vault" pos="-720 720 0" rot="0 0 90" />
  <prefab name="ElevatorCage" source="ship/elevator" pos="{EX} {EY} 0" rot="0 0 -135" />
  <prefab source="ship/wall_lamp" pos="-30 {HALF} 720" />
  <prefab source="ship/wall_lamp" pos="{HALF} -420 720" rot="0 0 -90" />
  <prefab source="ship/wall_lamp" pos="0 {-HALF} 720" rot="0 0 180" />
  <prefab source="ship/wall_lamp" pos="{-HALF} -160 720" rot="0 0 90" />
  <!-- Practical fill: the relay's read-outs and the east viewscreen. -->
  <light pos="-315 740 420" color="0.40 0.95 0.90" intensity="0.6" radius="900" castShadows="1" />
  <light pos="{HALF - 120} 200 470" color="0.45 0.65 1.0" intensity="0.35" radius="700" castShadows="1" />

  <!-- The canister stand by the generator; the canister's nozzle points south-south-west at the console. -->
  <prefab name="Stand" source="ship/canister_stand" pos="8 -427 0" />
  <group name="StandCanister">
    <prefab source="props/canister" pos="8 -427 70" rot="0 0 -26" />
  </group>

  <!-- The red sun: lit (default), burnt out, guttering. -->
  <group name="RedOn">
    <sphere pos="0 0 {GZ}" radius="{GR}" rings="24" slices="36" color="1.0 0.18 0.08" unlit="1" castShadow="0" />
    <light pos="0 0 {GZ}" color="1.0 0.22 0.12" intensity="2.2" radius="1500" castShadows="1" />
    <cylinder pos="0 0 62.5" rot="90 0 0" radius="46" height="1" sides="32" color="1.0 0.30 0.14" unlit="1" castShadow="0" />
    <torus pos="0 0 64.1" rot="90 0 0" majorRadius="100" minorRadius="2" majorSegments="48" color="1.0 0.24 0.10" unlit="1" castShadow="0" />
    <cylinder pos="{113.1} {113.1} {(69 + GZ - 98.6) / 2}" rot="90 0 0" radius="1.6" height="{GZ - 98.6 - 69}" color="1.0 0.30 0.14" unlit="1" castShadow="0" />
    <cylinder pos="{-113.1} {113.1} {(69 + GZ - 98.6) / 2}" rot="90 0 0" radius="1.6" height="{GZ - 98.6 - 69}" color="1.0 0.30 0.14" unlit="1" castShadow="0" />
    <cylinder pos="{-113.1} {-113.1} {(69 + GZ - 98.6) / 2}" rot="90 0 0" radius="1.6" height="{GZ - 98.6 - 69}" color="1.0 0.30 0.14" unlit="1" castShadow="0" />
    <cylinder pos="{113.1} {-113.1} {(69 + GZ - 98.6) / 2}" rot="90 0 0" radius="1.6" height="{GZ - 98.6 - 69}" color="1.0 0.30 0.14" unlit="1" castShadow="0" />
  </group>
  <group name="RedOff" pos="{1 * LOT} 0 {PZ}">
    <sphere pos="0 0 {GZ}" radius="{GR}" rings="24" slices="36" material="dead_globe" />
  </group>
  <group name="RedDim" pos="{2 * LOT} 0 {PZ}">
    <sphere pos="0 0 {GZ}" radius="{GR}" rings="24" slices="36" color="0.55 0.10 0.05" unlit="1" castShadow="0" />
    <light pos="0 0 {GZ}" color="1.0 0.30 0.16" intensity="0.8" radius="1100" castShadows="1" />
  </group>
  <!-- Emergency light: the four wall lamps lit. -->
  <group name="Emergency" pos="{3 * LOT} 0 {PZ}">
    <box pos="-30 {HALF - 16.5} 720" size="44 1 14" color="0.85 0.92 1.0" unlit="1" castShadow="0" />
    <box pos="{HALF - 16.5} -420 720" size="1 44 14" color="0.85 0.92 1.0" unlit="1" castShadow="0" />
    <box pos="0 {-HALF + 16.5} 720" size="44 1 14" color="0.85 0.92 1.0" unlit="1" castShadow="0" />
    <box pos="{-HALF + 16.5} -160 720" size="1 44 14" color="0.85 0.92 1.0" unlit="1" castShadow="0" />
    <light pos="-30 {HALF - 110} 660" color="0.80 0.88 1.0" intensity="0.6" radius="1300" castShadows="1" />
    <light pos="{HALF - 110} -420 660" color="0.80 0.88 1.0" intensity="0.6" radius="1300" castShadows="1" />
    <light pos="0 {-HALF + 110} 660" color="0.80 0.88 1.0" intensity="0.5" radius="1300" castShadows="1" />
  </group>

  <!-- Earth on the east viewscreen (display face at x = HALF - 17). -->
  <group name="Earth">
    <sphere pos="{HALF - 18} 200 470" radius="80" scale="0.01 1 1" color="0.20 0.45 0.85" unlit="1" castShadow="0" />
    <sphere pos="{HALF - 19.5} 170 500" radius="40" scale="0.01 1.3 0.9" color="0.32 0.62 0.34" unlit="1" castShadow="0" />
  </group>
  <group name="EarthSmall" pos="{19 * LOT} 0 {PZ}">
    <sphere pos="{HALF - 18} 230 470" radius="26" scale="0.01 1 1" color="0.20 0.45 0.85" unlit="1" castShadow="0" />
  </group>

  <!-- Drones hovering round Superman on their jets (deliberately airborne), one within reach of his
       right hand; the one he holds; the ones that fall and lie broken after the gas. -->
  <group name="Drones" sanityIgnore="1">
    <prefab source="props/drone" pos="-160 -170 300" rot="0 0 20" />
    <prefab source="props/drone" pos="120 -150 330" rot="8 0 -30" />
    <prefab source="props/drone" pos="210 110 290" rot="0 -6 130" />
    <prefab source="props/drone" pos="-230 120 250" rot="0 0 210" />
    <prefab source="props/drone" pos="40 -230 400" rot="-6 0 10" />
    <prefab source="props/drone" pos="-60 190 380" rot="0 8 170" />
  </group>
  <group name="NearDrone" sanityIgnore="1">
    <prefab source="props/drone" pos="80 46 248" rot="0 0 70" />
  </group>
  <group name="HeldDrone" pos="{5 * LOT} 0 {PZ}" sanityIgnore="1">
    <prefab source="props/drone" pos="80 50 238" rot="25 0 70" />
  </group>
  <group name="Falling" pos="{6 * LOT} 0 {PZ}" sanityIgnore="1">
    <prefab source="props/drone" pos="-150 -130 160" rot="40 20 20" />
    <prefab source="props/drone" pos="200 80 120" rot="-30 50 130" />
    <prefab source="props/drone" pos="60 -200 260" rot="70 0 10" />
  </group>
  <group name="Crashed" pos="{26 * LOT} 0 {PZ}">
    <prefab source="props/drone" pos="-210 -300 3.2" rot="0 0 30" />
    <prefab source="props/drone" pos="300 -180 3.2" rot="0 0 80" />
    <prefab source="props/drone" pos="-340 160 3.2" rot="0 0 200" />
    <prefab source="props/drone" pos="150 420 3.2" rot="0 0 140" />
  </group>

  <!-- The purple gush from the nozzle into the drone bank and the east consoles, and the screens'
       flashing nonsense. -->
  <group name="Spew" pos="{7 * LOT} 0 {PZ}">
    <group name="SpewCloud">
      <sphere pos="-9.1 -462.1 150.0" radius="18.0" material="bacteria" castShadow="0" />
      <sphere pos="-28.4 -501.6 166.0" radius="40.0" material="bacteria_light" castShadow="0" />
      <sphere pos="-6.4 -491.6 176.0" radius="24.8" material="bacteria" castShadow="0" />
      <sphere pos="-48.4 -489.6 160.0" radius="23.2" material="bacteria_light" castShadow="0" />
      <sphere pos="-24.4 -519.6 180.0" radius="22.0" material="bacteria" castShadow="0" />
      <sphere pos="-66.9 -580.8 196.0" radius="70.0" material="bacteria_light" castShadow="0" />
      <sphere pos="-28.4 -563.2 213.5" radius="43.4" material="bacteria" castShadow="0" />
      <sphere pos="-101.9 -559.8 185.5" radius="40.6" material="bacteria_light" castShadow="0" />
      <sphere pos="-59.9 -612.2 220.5" radius="38.5" material="bacteria" castShadow="0" />
      <sphere pos="-106.3 -661.7 236.0" radius="90.0" material="bacteria_light" castShadow="0" />
      <sphere pos="-56.8 -639.2 258.5" radius="55.8" material="bacteria" castShadow="0" />
      <sphere pos="-151.3 -634.7 222.5" radius="52.2" material="bacteria_light" castShadow="0" />
      <sphere pos="-97.3 -702.2 267.5" radius="49.5" material="bacteria" castShadow="0" />
      <sphere pos="-132.6 -715.6 280.0" radius="95.0" material="bacteria_light" castShadow="0" />
      <sphere pos="-80.3 -691.8 303.8" radius="58.9" material="bacteria" castShadow="0" />
      <sphere pos="-180.1 -687.1 265.8" radius="55.1" material="bacteria_light" castShadow="0" />
      <sphere pos="-123.1 -758.3 313.2" radius="52.3" material="bacteria" castShadow="0" />
    </group>
    <light pos="-100 -640 330" color="0.70 0.35 0.95" intensity="0.6" radius="700" castShadows="1" />
  </group>
  <group name="Glitch" pos="{8 * LOT} 0 {PZ}">
    <box pos="-188 {-HALF + 31.15} 92.6" rot="25 0 180" size="70 40 1" color="1.0 0.40 0.90" unlit="1" castShadow="0" />
    <box pos="{HALF - 18} 140 400" size="1 180 60" color="1.0 0.40 0.90" unlit="1" castShadow="0" />
    <box pos="{HALF - 18} 280 520" size="1 120 40" color="0.95 0.95 1.0" unlit="1" castShadow="0" />
    <box pos="-385 {HALF - 119.6} 420" size="66 1 50" color="1.0 0.40 0.90" unlit="1" castShadow="0" />
    <box pos="-245 {HALF - 119.6} 420" size="66 1 50" color="0.95 0.95 1.0" unlit="1" castShadow="0" />
    <light pos="{HALF - 100} 200 420" color="0.95 0.60 1.0" intensity="0.6" radius="800" castShadows="1" />
  </group>

  <!-- The vault's lead door: in its doorway, or torn off and thrown down on its back. -->
  <group name="VaultDoor">
    <prefab source="ship/vault_door" pos="-555 720 0" rot="0 0 90" />
  </group>
  <group name="VaultOpen" pos="{9 * LOT} 0 {PZ}">
    <prefab source="ship/vault_door" pos="-440 400 12" rot="-90 0 -75" />
    <light pos="-470 720 140" color="0.40 1.0 0.40" intensity="1.3" radius="900" castShadows="1" />
  </group>

  <!-- The four cannons dropped and firing at the floating Superman (body centre at 0 0 220). -->
  <let name="AIMZ" value="220" />
  <let name="CANZ" value="RH - 51.2 - 40" />
  <let name="CP" value="deg(atan2(CANZ - AIMZ, 360 * sqrt(2)))" />
  <let name="BD" value="sqrt(2 * 360 * 360 + (CANZ - AIMZ) * (CANZ - AIMZ))" />
  <let name="BLEN" value="BD - 194 - 25" />
  <let name="BF" value="(194 + BLEN / 2) / BD" />
  <group name="CannonsOut" pos="{10 * LOT} 0 {PZ}">
    <prefab source="ship/cannon" pos="-360 -360 {CANZ}" rot="{CP} 0 {deg(atan2(1 * 360, -1 * 360))}" />
    <prefab source="ship/cannon" pos="360 -360 {CANZ}" rot="{CP} 0 {deg(atan2(-1 * 360, -1 * 360))}" />
    <prefab source="ship/cannon" pos="-360 360 {CANZ}" rot="{CP} 0 {deg(atan2(1 * 360, 1 * 360))}" />
    <prefab source="ship/cannon" pos="360 360 {CANZ}" rot="{CP} 0 {deg(atan2(-1 * 360, 1 * 360))}" />
    <!-- Beams from each muzzle (194 cm out along the barrel) to 25 cm short of the aim point. -->
    <cylinder pos="{-1 * 360 * (1 - BF)} {-1 * 360 * (1 - BF)} {CANZ + (AIMZ - CANZ) * BF}" rot="{CP} 0 {deg(atan2(1 * 360, -1 * 360))}" radius="7" height="{BLEN}" color="0.95 0.97 1.0" unlit="1" castShadow="0" />
    <cylinder pos="{1 * 360 * (1 - BF)} {-1 * 360 * (1 - BF)} {CANZ + (AIMZ - CANZ) * BF}" rot="{CP} 0 {deg(atan2(-1 * 360, -1 * 360))}" radius="7" height="{BLEN}" color="0.95 0.97 1.0" unlit="1" castShadow="0" />
    <cylinder pos="{-1 * 360 * (1 - BF)} {1 * 360 * (1 - BF)} {CANZ + (AIMZ - CANZ) * BF}" rot="{CP} 0 {deg(atan2(1 * 360, 1 * 360))}" radius="7" height="{BLEN}" color="0.95 0.97 1.0" unlit="1" castShadow="0" />
    <cylinder pos="{1 * 360 * (1 - BF)} {1 * 360 * (1 - BF)} {CANZ + (AIMZ - CANZ) * BF}" rot="{CP} 0 {deg(atan2(-1 * 360, 1 * 360))}" radius="7" height="{BLEN}" color="0.95 0.97 1.0" unlit="1" castShadow="0" />
    <light pos="0 0 {AIMZ + 80}" color="0.92 0.95 1.0" intensity="1.4" radius="900" castShadows="1" />
  </group>

  <!-- The Red Sun Room's anchors (literal numbers: the book engine reads them without expressions). -->
  <group name="Drone" pos="80 46 248" />
  <group name="Globe" pos="0 0 700" />
  <group name="Stand-Canister" pos="8 -427 110" />
  <group name="Vault" pos="-540 720 130" />
  <group name="Elevator" pos="510 -510 160" />
  <group name="Hull-Wall" pos="-898 -160 380" />

  <!-- ============================== The command deck (floor z = CZ) ============================== -->
  <group name="CommandShell" pos="0 0 {CZ}">
    <floor rot="90 0 0" width="{RS + 2 * WT}" depth="{RS + 2 * WT}" thickness="{FT}" style="squares" tileWidth="120" gap="3" material="sh_rib" colorVariation="0.08" seed="9" groutColor="0.30 0.70 0.62" />
    <wall pos="{(CIN + CWT / 2) * cos(rad(0))} {(CIN + CWT / 2) * sin(rad(0))} 0" rot="90 0 -90" length="{2 * (CIN + CWT) * OCT}" height="{CWH}" thickness="{CWT}" lowerHeight="120" lowerMaterial="sh_rib" upperMaterial="sh_hull" />
    <wall pos="{(CIN + CWT / 2) * cos(rad(45))} {(CIN + CWT / 2) * sin(rad(45))} 0" rot="90 0 -45" length="{2 * (CIN + CWT) * OCT}" height="{CWH}" thickness="{CWT}" lowerHeight="120" lowerMaterial="sh_rib" upperMaterial="sh_hull" />
    <wall pos="{(CIN + CWT / 2) * cos(rad(90))} {(CIN + CWT / 2) * sin(rad(90))} 0" rot="90 0 0" length="{2 * (CIN + CWT) * OCT}" height="{CWH}" thickness="{CWT}" lowerHeight="120" lowerMaterial="sh_rib" upperMaterial="sh_hull" />
    <wall pos="{(CIN + CWT / 2) * cos(rad(135))} {(CIN + CWT / 2) * sin(rad(135))} 0" rot="90 0 45" length="{2 * (CIN + CWT) * OCT}" height="{CWH}" thickness="{CWT}" lowerHeight="120" lowerMaterial="sh_rib" upperMaterial="sh_hull" />
    <wall pos="{(CIN + CWT / 2) * cos(rad(180))} {(CIN + CWT / 2) * sin(rad(180))} 0" rot="90 0 90" length="{2 * (CIN + CWT) * OCT}" height="{CWH}" thickness="{CWT}" lowerHeight="120" lowerMaterial="sh_rib" upperMaterial="sh_hull" />
    <wall pos="{(CIN + CWT / 2) * cos(rad(225))} {(CIN + CWT / 2) * sin(rad(225))} 0" rot="90 0 135" length="{2 * (CIN + CWT) * OCT}" height="{CWH}" thickness="{CWT}" lowerHeight="120" lowerMaterial="sh_rib" upperMaterial="sh_hull" />
    <wall pos="{(CIN + CWT / 2) * cos(rad(270))} {(CIN + CWT / 2) * sin(rad(270))} 0" rot="90 0 180" length="{2 * (CIN + CWT) * OCT}" height="{CWH}" thickness="{CWT}" lowerHeight="120" lowerMaterial="sh_rib" upperMaterial="sh_hull" />
    <wall pos="{(CIN + CWT / 2) * cos(rad(315))} {(CIN + CWT / 2) * sin(rad(315))} 0" rot="90 0 225" length="{2 * (CIN + CWT) * OCT}" height="{CWH}" thickness="{CWT}" lowerHeight="120" lowerMaterial="sh_rib" upperMaterial="sh_hull" />
  </group>
  <lathe name="Dome" shape="dome" segments="8" pos="0 0 {CZ + CWH}" rot="90 0 22.5" material="sh_net" />
  <!-- The Brain-Net core glowing at the dome's apex. -->
  <sphere name="NetCore" pos="0 0 {CZ + CWH + DHI - 36}" radius="36" color="0.80 0.50 1.0" unlit="1" castShadow="0" />
  <light pos="0 0 {CZ + CWH + DHI - 90}" color="0.75 0.50 1.0" intensity="0.5" radius="900" castShadows="1" />

  <!-- The throne on its dais, turned from the viewscreen toward the elevator. -->
  <cylinder name="ThroneDais" pos="{TX} {TY} {CZ + DAIS / 2}" rot="90 0 0" radius="170" height="{DAIS}" sides="8" material="sh_trim" />
  <prefab name="Throne" source="props/throne" pos="{TX} {TY} {CZ + DAIS}" rot="0 0 {BRYAW}" />

  <!-- The great viewscreen over the north consoles; two more consoles on the east wall and the
       deck's computer relay on the west wall. -->
  <prefab name="Viewscreen" source="ship/screen" pos="0 {CIN} {CZ + 140}" scale="1.3 1 1.3" />
  <light pos="0 {CIN - 160} {CZ + 330}" color="0.45 0.65 1.0" intensity="0.7" radius="1000" castShadows="1" />
  <prefab source="ship/console" pos="-230 {CIN - 31} {CZ}" />
  <prefab source="ship/console" pos="0 {CIN - 31} {CZ}" />
  <prefab source="ship/console" pos="230 {CIN - 31} {CZ}" />
  <prefab source="ship/console" pos="{CIN - 31} -150 {CZ}" rot="0 0 -90" />
  <prefab source="ship/console" pos="{CIN - 31} 150 {CZ}" rot="0 0 -90" />
  <prefab name="DeckRelay" source="ship/relay" pos="{-CIN + 62 * 0.85} 0 {CZ}" rot="0 0 90" scale="0.85 0.85 0.85" />
  <group name="DeckEarth">
    <sphere pos="0 {CIN - 22} {CZ + 140 + 195}" radius="130" scale="1 0.01 1" color="0.20 0.45 0.85" unlit="1" castShadow="0" />
    <sphere pos="-40 {CIN - 24.4} {CZ + 140 + 230}" radius="60" scale="1.3 0.01 0.9" color="0.32 0.62 0.34" unlit="1" castShadow="0" />
  </group>
  <group name="PurpleEarth" pos="{14 * LOT} 0 {PZ}">
    <sphere pos="30 {CIN - 26} {CZ + 140 + 210}" radius="90" scale="1.5 0.01 0.7" color="0.70 0.32 0.86" unlit="1" castShadow="0" />
    <sphere pos="-60 {CIN - 27.5} {CZ + 140 + 160}" radius="60" scale="1.4 0.01 0.6" color="0.62 0.26 0.80" unlit="1" castShadow="0" />
  </group>

  <!-- The seeding bay on the north-west wall. Local frame: the wall face at y = 0, the deck toward -y.
       Three tanks with their outlet stubs into the wall; the Bacteria inside (purple, or pale once the
       antidote is in); the middle tank's intake cap, shut or lifted off onto its flange; and the
       cmd-spray moment, measured from the intake mouth at local (0, -214, 140): Superman stands at
       y = -364 holding the sprayer (base at -330, valve at -260, axis 150 high) and the jet crosses to the mouth. -->
  <group name="SeedingBay" pos="{CIN * cos(rad(135))} {CIN * sin(rad(135))} {CZ}" rot="0 0 45">
    <prefab source="ship/seeding_tank" pos="-230 -108 0" />
    <prefab name="MidTank" source="ship/seeding_tank" pos="0 -108 0" />
    <prefab source="ship/seeding_tank" pos="230 -108 0" />
    <light pos="0 -320 220" color="0.70 0.40 1.0" intensity="0.6" radius="800" castShadows="1" />
    <group name="Brew">
      <cylinder pos="-230 -108 180" rot="90 0 0" radius="59" height="300" sides="32" color="0.60 0.26 0.84" unlit="1" castShadow="0" />
      <cylinder pos="0 -108 180" rot="90 0 0" radius="59" height="300" sides="32" color="0.60 0.26 0.84" unlit="1" castShadow="0" />
      <cylinder pos="230 -108 180" rot="90 0 0" radius="59" height="300" sides="32" color="0.60 0.26 0.84" unlit="1" castShadow="0" />
    </group>
    <group name="BrewPale" pos="{11 * LOT} 0 {PZ}">
      <cylinder pos="-230 -108 180" rot="90 0 0" radius="59" height="300" sides="32" material="bacteria_pale" />
      <cylinder pos="0 -108 180" rot="90 0 0" radius="59" height="300" sides="32" material="bacteria_pale" />
      <cylinder pos="230 -108 180" rot="90 0 0" radius="59" height="300" sides="32" material="bacteria_pale" />
    </group>
    <group name="IntakeShut">
      <cylinder pos="0 -217 140" radius="17" height="4" material="sh_trim" />
    </group>
    <group name="IntakeOpen" pos="{12 * LOT} 0 {PZ}">
      <cylinder pos="0 -200 160" rot="90 0 0" radius="17" height="4" material="sh_trim" />
    </group>
    <group name="HeldSprayer" pos="{18 * LOT} 0 {PZ}">
      <prefab source="props/sprayer" pos="0 -330 150" rot="90 0 180" />
    </group>
    <group name="Spray" pos="{13 * LOT} 0 {PZ}">
      <cone pos="0 -237 145" rot="-12 0 0" radius="3" radiusTop="12" height="40" color="0.45 1.0 0.55" unlit="1" castShadow="0" />
      <light pos="0 -250 170" color="0.45 1.0 0.55" intensity="0.5" radius="400" castShadows="1" />
    </group>
  </group>

  <!-- The canister rack on the north-east wall (local frame as the seeding bay's). -->
  <group name="RackBay" pos="{CIN * cos(rad(45))} {CIN * sin(rad(45))} {CZ}" rot="0 0 -45">
    <prefab name="Rack" source="ship/canister_rack" pos="0 -22 0" />
    <light pos="0 -220 300" color="0.50 0.85 0.90" intensity="0.35" radius="600" castShadows="1" />
  </group>

  <!-- The elevator's upper landing, and the light bars that key the deck from the south-west. -->
  <prefab name="DeckElevator" source="ship/elevator" pos="{EX} {EY} {CZ}" rot="0 0 -135" scale="1 1 {CWH / 900}" />
  <prefab source="ship/light_bar" pos="{CIN * cos(rad(225))} {CIN * sin(rad(225))} {CZ + 470}" rot="0 0 135" />
  <prefab source="ship/light_bar" pos="-260 {-CIN} {CZ + 470}" rot="0 0 180" />

  <!-- Moments at the throne: the essence escaping; the purple crust; the empty canister. -->
  <group name="Essence" pos="{16 * LOT} 0 {PZ}">
    <!-- The trail out of his cracked skull, and the knot of his mind rising to the dome. -->
    <cylinder pos="8 119 1305" rot="90 0 0" radius="4" height="270" color="0.92 0.78 1.0" unlit="1" castShadow="0" />
    <sphere pos="16 120 1480" radius="34" color="0.95 0.85 1.0" unlit="1" castShadow="0" />
    <sphere pos="44 108 1500" radius="20" color="0.85 0.68 1.0" unlit="1" castShadow="0" />
    <sphere pos="-10 134 1510" radius="18" color="0.85 0.68 1.0" unlit="1" castShadow="0" />
    <torus pos="16 120 1480" rot="30 0 20" majorRadius="52" minorRadius="3" color="0.92 0.78 1.0" unlit="1" castShadow="0" />
    <torus pos="16 120 1480" rot="-40 0 70" majorRadius="46" minorRadius="2.5" color="0.92 0.78 1.0" unlit="1" castShadow="0" />
    <light pos="16 60 1440" color="0.85 0.70 1.0" intensity="1.1" radius="900" castShadows="1" />
  </group>
  <!-- The crust is a coating wrapped round Brainiac's seated body (joints from the scener joint listing in
       the Throne pose), so it overlaps him by design; the jammed canister is wedged neck-first into
       the crack in his skull. -->
  <group name="Crust" pos="{15 * LOT} 0 {PZ}" sanityIgnore="1">
    <sphere pos="0 119 1134" radius="14" scale="1 1 0.75" material="bacteria" />
    <sphere pos="16 124 1114" radius="10" material="bacteria_light" />
    <sphere pos="-15 114 1114" radius="10" material="bacteria" />
    <sphere pos="0 110 1092" radius="15" scale="1.1 0.8 1.2" material="bacteria_light" />
    <sphere pos="5 92 1062" radius="15" scale="1.5 1.1 0.6" material="bacteria" />
    <sphere pos="34 92 1080" radius="8" material="bacteria_light" />
    <sphere pos="-12 76 1080" radius="8" material="bacteria" />
    <sphere pos="20 76 1052" radius="9" material="bacteria_light" />
    <sphere pos="9 71 1052" radius="9" material="bacteria" />
  </group>
  <group name="JammedCanister" pos="{27 * LOT} 0 {PZ}" sanityIgnore="1">
    <prefab source="props/canister" pos="20.9 81.3 1212" rot="149.1 0 -151" />
  </group>
  <group name="EmptyCanister" pos="{17 * LOT} 0 {PZ}">
    <prefab source="props/canister" pos="150 -150 {CZ + 16.5}" rot="0 90 60" />
  </group>

  <!-- The command deck's anchors (literal numbers: the book engine reads them without expressions).
       Brainiac's chest in the throne; a canister on the rack's upper shelf; the middle tank's intake. -->
  <group name="Brainiac-Throne" pos="0 120 1095" />
  <group name="Canister" pos="567 615 1143" />
  <group name="Seeding-Tanks" pos="-457 457 1120" />

  <!-- ============================== The actors ============================== -->
  <group name="SupermanAt" pos="{SMX} {SMY} {SMZ}" sanityIgnore="1">
    <group name="SupermanYaw" rot="0 0 {SMYAW}">
      <group name="SupermanTilt" rot="-90 0 0">
        <prefab name="Superman" source="characters/superman" pose="Float" />
      </group>
    </group>
  </group>
  <group name="BrainiacAt" pos="{BRX} {BRY} {BRZ}">
    <group name="BrainiacYaw" rot="0 0 {BRYAW}">
      <prefab name="Brainiac" source="characters/brainiac" pose="Throne" />
    </group>
  </group>
</scene>
