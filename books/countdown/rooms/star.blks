    <box name="Slope" pos="0 {-1603 - 3000*cos(rad(8))} {-3000*sin(rad(8)) - 10/cos(rad(8))}" rot="8 0 0" size="12000 6000 20" material="grass" />
    <!-- Forecourt furniture: sign, flags, planters by the doors, lamp posts, trees on the lawns. -->
    <prefab source="star/gate/sign" pos="-1350 -1150 0" rot="0 0 -28" />
    <prefab source="star/gate/flagpole" pos="900 -1150 0" color="0.80 0.14 0.14" />
