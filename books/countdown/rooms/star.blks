  <!-- ================= The entrance, 80 m south: S.T.A.R. Labs on its hill ================= -->
  <!-- Local frame: the glass front runs along x at y=0 and faces south (-Y); the forecourt lies before it. -->
  <group name="Gate" pos="0 -8000 0">
    <let name="GW" value="3600" />   <!-- facade width -->
    <let name="FH" value="380" />    <!-- storey height -->
    <let name="NF" value="5" />      <!-- storeys -->
    <let name="BD" value="1000" />   <!-- building depth -->
    <group name="Building">
      <!-- The glass volume, its storey bands, parapet and mullions. -->
      <box pos="0 {12 + (BD - 12)/2} {NF*FH/2}" size="{GW} {BD - 12} {NF*FH}" material="facade_glass" />
      <box pos="0 5 {FH}" size="{GW + 20} 30 50" material="concrete_light"><array count="{NF - 1}" translation="0 0 {FH}" /></box>
      <box pos="0 10 {NF*FH + 40}" size="{GW + 20} 40 80" material="concrete_light" />
      <box pos="{-GW/2 + 150} 5 {FH + (NF - 1)*FH/2}" size="6 14 {(NF - 1)*FH}" material="mullion"><array count="23" translation="150 0 0" /></box>
      <!-- Ground floor: concrete piers carrying the first band, the bronze entrance doors between the middle pair. -->
      <box pos="-1500 -18 {(FH - 25)/2}" size="60 60 {FH - 25}" material="concrete_light"><array count="6" translation="600 0 0" /></box>
      <box pos="-200 9 120" size="6 6 240" material="bronze"><array count="5" translation="100 0 0" /></box>
      <box pos="0 9 243" size="406 6 6" material="bronze" />
      <box pos="-150 10.5 118" size="92 3 234" material="door_glass"><array count="4" translation="100 0 0" /></box>
      <box pos="-150 8 105" size="60 2 4" material="s7_chrome"><array count="4" translation="100 0 0" /></box>
      <!-- The entrance canopy on two round columns, the S.T.A.R. star on its fascia. -->
      <box pos="0 -210 {FH - 2}" size="900 420 36" material="concrete_light" />
      <cylinder pos="-400 -380 {(FH - 20)/2}" rot="90 0 0" radius="18" height="{FH - 20}" material="concrete_light" />
      <cylinder pos="400 -380 {(FH - 20)/2}" rot="90 0 0" radius="18" height="{FH - 20}" material="concrete_light" />
      <star pos="0 -421.5 {FH - 2}" rot="90 0 0" outerRadius="16" innerRadius="7" points="5" material="s7_chrome"><extrude amount="3" /></star>
    </group>
    <!-- The forecourt paving on the brow of the hill; the lawns round it, and in front the grass slope the
         visitors' path climbs (it falls 8 degrees to the south, from the forecourt edge at y=-1600). -->
    <floor pos="0 -800 0" rot="90 0 0" width="{GW}" depth="1600" style="squares" tileWidth="60" thickness="10" tileDepth="2" gap="0.8" material="paving" colorVariation="0.06" groutColor="0.48 0.46 0.42" seed="5" />
    <group name="Lawns">
