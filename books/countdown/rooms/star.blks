<?xml version='1.0' encoding='UTF-8'?>
<!-- Обратный отсчёт: the S.T.A.R. Computer Complex upstate, a July morning between 9 and 10. Z up, cm, X east,
     Y north. Two sets share this file.

     The Star 7 room (origin at its floor centre): interior 2300 x 1400, ceiling 380, a raised floor of 120 cm
     panels (top z=0) over a 60 cm crawlspace of pedestals and cable trays. Resident story: S.T.A.R.'s systems
     staff run the Star 7 learning computer here around the clock. The chrome C-ring core stands in the middle
     facing south with its orange bench; two operators sit at console banks splayed before it; mainframe
     cabinets line the north wall beside a line printer; reel-to-reel tape drives line the west wall; the duty
     log lies on the operations table by the east windows. Visitors come in through the double door in the
     south wall, next to the low ventilation grille that Brock's gas comes through. Brock's three men crawl in
     under the floor from a maintenance tunnel in the east wall and come up through the three panels south of
     the core (the hole, x -180..180, y -440..-320).

     The entrance set (group Gate, 80 m south): S.T.A.R.'s five-storey glass front on its hill, the entrance
     canopy with two guards at the doors, a paved forecourt with the S.T.A.R. sign and flagpoles.

     One scene shows several moments. Everything that changes between pages lives in a moment group stored
     under the ground at its own depth (STORE_*); each camera brings the moments it shows to z=0 with a
     <transform> and poses the seated staff with <use-pose>. Stored groups are below the ground plane, so
     scener's floating check skips them and their depths keep them clear of one another. -->
<scene up="z" ambient="0.24 0.25 0.28" background="0.62 0.76 0.92">
  <let name="W" value="2300" />      <!-- room interior, west-east -->
  <let name="D" value="1400" />      <!-- room interior, south-north -->
  <let name="H" value="380" />       <!-- floor top to ceiling -->
  <let name="T" value="20" />        <!-- wall thickness -->
  <let name="CS" value="60" />       <!-- crawlspace depth under the panel tops -->
  <let name="P" value="120" />       <!-- floor panel pitch -->
  <let name="PG" value="1" />        <!-- joint between panels -->
  <let name="PT" value="3" />        <!-- panel thickness -->
  <let name="HY" value="-380" />     <!-- row of the three lifted panels -->
  <let name="CORE_X" value="0" />
  <let name="CORE_Y" value="190" />
  <let name="CON_X" value="480" />   <!-- console stations at (+-CON_X, CON_Y), splayed by CON_A -->
  <let name="CON_Y" value="-30" />
  <let name="CON_A" value="24" />
  <let name="OPS_X" value="880" />
  <let name="OPS_Y" value="470" />
  <let name="GRILLE_X" value="150" />
  <let name="DOOR_X" value="-520" />
  <let name="WIN_Y" value="-480" />  <!-- the southern east window, the one Superman leaves by -->
  <!-- Storage depths of the moment groups (and of the floor while X-ray vision looks through it). -->
  <let name="S_ARRIVE" value="-4000" />
  <let name="S_INTERVIEW" value="-4700" />
  <let name="S_WISPS" value="-5400" />
  <let name="S_BLOW" value="-6100" />
  <let name="S_CRAWL" value="-6800" />
  <let name="S_SLEEP" value="-7500" />
  <let name="S_RISING" value="-8200" />
  <let name="S_GAS" value="-8900" />
  <let name="S_OPEN" value="-9600" />
  <let name="S_RAID" value="-10300" />
  <let name="S_CAUGHT" value="-11000" />
  <let name="S_AFTER" value="-11700" />
  <let name="S_GLITCH" value="-12400" />
  <let name="S_LEAVE" value="-13100" />
  <let name="HIDE_FLOOR" value="-13800" />
  <let name="HIDE_PANELS" value="-14500" />
  <let name="HIDE_LOG" value="-15200" />

  <camera name="star-show-gate" comment="The S.T.A.R. entrance on its hill: two guards stop Clark and his crew under the canopy at the glass doors" pos="560 -9300 160" look="-260 -8380 240" fov="56" textRect="0.04 0.035 0.92 0.30" textScale="1" />
  <camera name="star-show-room" comment="The Star 7 room: the chrome core and its consoles, technicians at work, Rafferty showing the WGBS crew round" pos="920 -560 280" look="-260 120 110" fov="58" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Arrive" pos="0 0 {-S_ARRIVE}" />
  </camera>
  <camera name="star-show-vent" comment="The interview: Rafferty talks into Wirth's camera in front of the Star 7, Clark beside the ventilation grille where a purple wisp curls out" pos="-820 -470 230" look="80 -430 100" fov="62" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Interview" pos="0 0 {-S_INTERVIEW}" />
    <transform target="Wisps" pos="0 0 {-S_WISPS}" />
  </camera>
  <camera name="star-xray-floor" comment="X-ray view: the floor panels gone transparent; under them three masked men crawl through the cable trays from the tunnel toward the room" pos="230 -660 300" look="760 -380 -50" fov="62" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Interview" pos="0 0 {-S_INTERVIEW}" />
    <transform target="Floor" pos="0 0 {HIDE_FLOOR}" />
    <transform target="Panels" pos="0 0 {HIDE_PANELS}" />
    <transform target="Crawlers" pos="0 0 {-S_CRAWL}" />
  </camera>
  <camera name="star-gas" comment="Purple gas fills the room; everyone sleeps; three floor panels rise and masked heads come up" pos="760 -600 175" look="-100 -330 40" fov="62" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Sleepers" pos="0 0 {-S_SLEEP}" />
    <transform target="Rising" pos="0 0 {-S_RISING}" />
    <transform target="Gas" pos="0 0 {-S_GAS}" />
    <transform target="Panels" pos="0 0 {HIDE_PANELS}" />
    <use-pose instance="Tech1" name="Sleep" />
    <use-pose instance="Tech2" name="Sleep" />
    <use-pose instance="Tech3" name="Sleep" />
  </camera>
  <camera name="star-blowback" comment="Clark, coughing into his hand, blows the gas back into the grille; the technicians splutter" pos="420 -380 170" look="80 -640 80" fov="58" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Interview" pos="0 0 {-S_INTERVIEW}" />
    <transform target="BlowBack" pos="0 0 {-S_BLOW}" />
    <use-pose instance="Clark" name="Blow" />
  </camera>
  <camera name="star-show-mercs" comment="Brock and his men stand over the open panels, pistols out over the sleepers; Superman faces them; a coil of cable lies by the hole" pos="650 -420 200" look="-60 -380 100" fov="62" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Sleepers" pos="0 0 {-S_SLEEP}" />
    <transform target="Open" pos="0 0 {-S_OPEN}" />
    <transform target="Raid" pos="0 0 {-S_RAID}" />
    <transform target="Panels" pos="0 0 {HIDE_PANELS}" />
    <use-pose instance="Tech1" name="Sleep" />
    <use-pose instance="Tech2" name="Sleep" />
    <use-pose instance="Tech3" name="Sleep" />
  </camera>
  <camera name="star-caught" comment="The three mercenaries stand bound back to back in loops of cable, their pistols in a heap; Superman stands guard" pos="650 -420 200" look="-60 -380 100" fov="62" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Sleepers" pos="0 0 {-S_SLEEP}" />
    <transform target="Open" pos="0 0 {-S_OPEN}" />
    <transform target="Caught" pos="0 0 {-S_CAUGHT}" />
    <transform target="Panels" pos="0 0 {HIDE_PANELS}" />
    <use-pose instance="Tech1" name="Sleep" />
    <use-pose instance="Tech2" name="Sleep" />
    <use-pose instance="Tech3" name="Sleep" />
  </camera>
  <camera name="star-show-sample" comment="Afterwards: everyone awake, Rafferty waving the worthless log book, the Star 7's screens glitching red; a spent gas grenade by the grille, the crew packing up, the east windows open on the hills" pos="-950 -250 210" look="300 -450 110" fov="62" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="After" pos="0 0 {-S_AFTER}" />
    <transform target="Glitch" pos="0 0 {-S_GLITCH}" />
    <transform target="LogBook" pos="0 0 {HIDE_LOG}" />
  </camera>
  <camera name="star-leave-crew" comment="Ending: Clark follows his crew out of the double door while every screen in the room flickers red behind them" pos="-1000 -430 190" look="-200 -470 115" fov="60" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Leave" pos="0 0 {-S_LEAVE}" />
    <transform target="Glitch" pos="0 0 {-S_GLITCH}" />
  </camera>

  <material id="s7_chrome" color="0.82 0.84 0.88" shininess="110" />
  <material id="s7_dark" color="0.12 0.13 0.16" shininess="30" />
  <material id="s7_vinyl" color="0.86 0.38 0.12" shininess="14" />
  <material id="s7_lamp_amber" color="1.0 0.72 0.22" />
  <material id="s7_lamp_green" color="0.40 1.0 0.50" />
  <material id="s7_lamp_red" color="1.0 0.24 0.18" />
  <material id="lamp_amber" color="1.0 0.72 0.22" />
  <material id="lamp_green" color="0.40 1.0 0.50" />
  <material id="lamp_red" color="1.0 0.24 0.18" />
  <material id="screen_glow" color="0.45 0.95 0.70" />
  <material id="glitch_red" color="1.0 0.20 0.16" />
  <material id="beige" color="0.86 0.82 0.72" shininess="14" />
  <material id="beige_dark" color="0.66 0.62 0.54" shininess="12" />
  <material id="laminate" color="0.74 0.72 0.68" shininess="20" />
  <material id="rack_blue" color="0.14 0.28 0.56" shininess="20" />
  <material id="smoked" color="0.18 0.16 0.14" shininess="70" />
  <material id="tape_reel" color="0.30 0.30 0.34" shininess="40" />
  <material id="paper" color="0.94 0.93 0.86" shininess="2" />
  <material id="chrome" color="0.80 0.82 0.86" shininess="120" />
  <material id="dark_metal" color="0.20 0.21 0.24" shininess="40" />
  <material id="grille_metal" color="0.62 0.64 0.66" shininess="40" />
  <material id="duct" color="0.06 0.06 0.07" shininess="4" />
  <material id="chair_cloth" color="0.18 0.24 0.38" shininess="5" />
  <material id="wood" color="0.42 0.28 0.16" shininess="14" />
  <material id="gunmetal" color="0.14 0.14 0.16" shininess="60" />
  <material id="cable" color="0.08 0.08 0.10" shininess="20" />
  <material id="cable_grey" color="0.46 0.48 0.50" shininess="20" />
  <material id="cable_blue" color="0.16 0.30 0.60" shininess="20" />
  <material id="tray" color="0.58 0.60 0.62" shininess="30" />
  <material id="panel" color="0.80 0.78 0.72" shininess="16" />
  <material id="pedestal" color="0.50 0.52 0.54" shininess="40" />
  <material id="slab" color="0.30 0.30 0.30" shininess="4" />
  <material id="wall_upper" color="0.88 0.86 0.80" shininess="6" />
  <material id="wall_lower" color="0.42 0.50 0.58" shininess="8" />
