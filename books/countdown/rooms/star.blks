  <material id="paving" color="0.70 0.66 0.58" shininess="4" />
  <material id="granite" color="0.36 0.34 0.34" shininess="30" />
  <material id="grass" color="0.40 0.56 0.26" shininess="2" />
  <material id="hill" color="0.42 0.56 0.30" shininess="2" />
  <material id="bark" color="0.32 0.24 0.18" shininess="4" />
  <material id="leaves" color="0.26 0.44 0.20" shininess="4" />
  <material id="shrub" color="0.20 0.36 0.18" shininess="4" />
  <material id="soil" color="0.26 0.20 0.14" shininess="2" />
  <material id="flag_pole" color="0.78 0.80 0.82" shininess="80" />
  <material id="gold" color="0.86 0.68 0.24" shininess="80" />
  <material id="extinguisher_red" color="0.78 0.10 0.08" shininess="40" />
  <material id="clock_face" color="0.96 0.95 0.92" shininess="10" />
  <material id="cork" color="0.66 0.48 0.30" shininess="2" />
  <material id="memo_yellow" color="0.96 0.88 0.40" shininess="2" />
  <material id="tape_case" color="0.82 0.30 0.16" shininess="20" />

  <!-- Key light: the morning sun from the east-south-east, entering through the east windows. The room's
       fill is its six ceiling troffers (each prefab owns its light). -->
  <sun dir="-0.78 0.32 -0.62" color="1.0 0.94 0.82" intensity="1.25" castShadows="1" />

  <!-- ================= The Star 7 room ================= -->
  <group name="Shell">
    <!-- Structural slab under the crawlspace; the walls stand on it. -->
    <box pos="0 0 {-CS - 10}" size="{W + 2*T} {D + 2*T} 20" material="slab" />
    <group pos="0 {D/2 + T/2} {-CS}" rot="90 0 0">
      <wall length="{W + 2*T}" height="{H + CS}" thickness="{T}" lowerHeight="{CS + 100}" lowerMaterial="wall_lower" upperMaterial="wall_upper" middleTrimHeight="3" trimMaterial="trim" />
    </group>
    <group pos="0 {-(D/2 + T/2)} {-CS}" rot="90 0 180">
      <wall length="{W + 2*T}" height="{H + CS}" thickness="{T}" lowerHeight="{CS + 100}" lowerMaterial="wall_lower" upperMaterial="wall_upper" middleTrimHeight="3" trimMaterial="trim" />
      <!-- The double door (local x runs west here, so local x = -world x); the west leaf stands open. -->
      <door name="MainDoor" pos="{-DOOR_X - 45} {CS + 110} 0" width="90" height="220" hinge="right" window="rectangular" windowWidth="34" windowHeight="60" windowCenter="160" frameMaterial="trim" leafMaterial="door_leaf" />
      <door name="MainDoor2" pos="{-DOOR_X + 45} {CS + 110} 0" width="90" height="220" hinge="left" openAngle="-62" window="rectangular" windowWidth="34" windowHeight="60" windowCenter="160" frameMaterial="trim" leafMaterial="door_leaf" />
      <prefab source="star/vent_grille" name="Grille" pos="{-GRILLE_X} {CS + 48} 0" />
    </group>
    <group pos="{W/2 + T/2} 0 {-CS}" rot="90 0 -90">
      <wall length="{D}" height="{H + CS}" thickness="{T}" lowerHeight="{CS + 100}" lowerMaterial="wall_lower" upperMaterial="wall_upper" middleTrimHeight="3" trimMaterial="trim" />
      <!-- A ribbon of four open east windows (local x = -world y), sill 90 and head 290 above the floor. -->
      <window preset="cottage" pos="{-WIN_Y} {CS + 190} 0" width="270" height="200" pane="0" frameMaterial="trim" sillProjection="8" />
      <window preset="cottage" pos="160 {CS + 190} 0" width="270" height="200" pane="0" frameMaterial="trim" sillProjection="8" />
      <window preset="cottage" pos="-160 {CS + 190} 0" width="270" height="200" pane="0" frameMaterial="trim" sillProjection="8" />
      <window preset="cottage" pos="-480 {CS + 190} 0" width="270" height="200" pane="0" frameMaterial="trim" sillProjection="8" />
      <!-- The maintenance tunnel mouth below the floor, where Brock's men come in. -->
      <bool-negative-box pos="{-HY} 26 0" size="110 52 40" />
    </group>
    <group pos="{-(W/2 + T/2)} 0 {-CS}" rot="90 0 90">
      <wall length="{D}" height="{H + CS}" thickness="{T}" lowerHeight="{CS + 100}" lowerMaterial="wall_lower" upperMaterial="wall_upper" middleTrimHeight="3" trimMaterial="trim" />
    </group>
    <!-- Suspended ceiling of 60 cm acoustic tiles, laid face down at z=H. -->
    <floor pos="0 0 {H}" rot="-90 0 0" width="{W}" depth="{D}" style="squares" tileWidth="60" thickness="4" tileDepth="1" gap="1.2" material="ceiling_tile" colorVariation="0.03" groutColor="0.80 0.80 0.80" seed="3" />
  </group>

  <!-- Six 2 x 4 ft troffers in two rows. -->
  <group name="Troffers">
    <prefab source="star/troffer" pos="-600 -330 {H}" rot="0 0 90" />
    <prefab source="star/troffer" pos="0 -330 {H}" rot="0 0 90" />
    <prefab source="star/troffer" pos="600 -330 {H}" rot="0 0 90" />
    <prefab source="star/troffer" pos="-600 330 {H}" rot="0 0 90" />
    <prefab source="star/troffer" pos="0 330 {H}" rot="0 0 90" />
    <prefab source="star/troffer" pos="600 330 {H}" rot="0 0 90" />
  </group>

  <!-- The raised floor: 119 cm panels on a 120 grid centred on the hole, cut panels along the walls. -->
  <group name="Floor">
    <box pos="-1080 -620 {-PT/2}" size="{P - PG} {P - PG} {PT}" material="panel"><array count="19" translation="{P} 0 0" /><array count="2" translation="0 {P} 0" /></box>
    <box pos="-1080 {HY} {-PT/2}" size="{P - PG} {P - PG} {PT}" material="panel"><array count="8" translation="{P} 0 0" /></box>
    <box pos="240 {HY} {-PT/2}" size="{P - PG} {P - PG} {PT}" material="panel"><array count="8" translation="{P} 0 0" /></box>
    <box pos="-1080 -260 {-PT/2}" size="{P - PG} {P - PG} {PT}" material="panel"><array count="19" translation="{P} 0 0" /><array count="8" translation="0 {P} 0" /></box>
    <box pos="-1145.25 -620 {-PT/2}" size="9.5 {P - PG} {PT}" material="panel"><array count="11" translation="0 {P} 0" /></box>
    <box pos="1145.25 -620 {-PT/2}" size="9.5 {P - PG} {PT}" material="panel"><array count="11" translation="0 {P} 0" /></box>
    <box pos="-1080 -690.25 {-PT/2}" size="{P - PG} 19.5 {PT}" material="panel"><array count="19" translation="{P} 0 0" /></box>
    <box pos="-1080 670.25 {-PT/2}" size="{P - PG} 59.5 {PT}" material="panel"><array count="19" translation="{P} 0 0" /></box>
    <box pos="-1145.25 -690.25 {-PT/2}" size="9.5 19.5 {PT}" material="panel" />
    <box pos="1145.25 -690.25 {-PT/2}" size="9.5 19.5 {PT}" material="panel" />
    <box pos="-1145.25 670.25 {-PT/2}" size="9.5 59.5 {PT}" material="panel" />
    <box pos="1145.25 670.25 {-PT/2}" size="9.5 59.5 {PT}" material="panel" />
  </group>
  <!-- The three panels Brock's men push up from below. -->
  <group name="Panels">
    <box pos="-120 {HY} {-PT/2}" size="{P - PG} {P - PG} {PT}" material="panel"><array count="3" translation="{P} 0 0" /></box>
  </group>

  <!-- Under the floor: pedestals at every panel corner, three ladder trays of cable along the room. -->
  <group name="Pedestals">
    <box pos="-1140 -680 {-CS + 1}" size="10 10 2" material="pedestal"><array count="20" translation="{P} 0 0" /><array count="12" translation="0 {P} 0" /></box>
    <cylinder pos="-1140 -680 {(-CS + 2 - PT - 3)/2}" rot="90 0 0" radius="2.5" height="{CS - 2 - PT - 3}" material="pedestal"><array count="20" translation="{P} 0 0" /><array count="12" translation="0 0 {-P}" /></cylinder>
    <box pos="-1140 -680 {-PT - 1.5}" size="10 10 3" material="pedestal"><array count="20" translation="{P} 0 0" /><array count="12" translation="0 {P} 0" /></box>
  </group>
  <!-- Cable trays lying on the slab between the pedestal rows, with their cables. -->
  <group name="Trays">
    <box pos="0 -285 {-CS + 4}" size="2280 2 8" material="tray"><array count="2" translation="0 50 0" /></box>
    <box pos="-1125 -260 {-CS + 1}" size="2 48 2" material="tray"><array count="76" translation="30 0 0" /></box>
    <cylinder pos="0 -270 {-CS + 5}" rot="0 0 90" radius="3" height="2270" material="cable" />
    <cylinder pos="0 -262 {-CS + 5.5}" rot="0 0 90" radius="3.5" height="2270" material="cable_grey" />
    <cylinder pos="0 -253 {-CS + 5}" rot="0 0 90" radius="3" height="2270" material="cable_blue" />
    <cylinder pos="0 -246 {-CS + 4.5}" rot="0 0 90" radius="2.5" height="2270" material="cable" />
  </group>
  <group name="Trays2">
    <box pos="0 -45 {-CS + 4}" size="2280 2 8" material="tray"><array count="2" translation="0 50 0" /></box>
    <box pos="-1125 -20 {-CS + 1}" size="2 48 2" material="tray"><array count="76" translation="30 0 0" /></box>
    <cylinder pos="0 -30 {-CS + 5.5}" rot="0 0 90" radius="3.5" height="2270" material="cable_grey" />
    <cylinder pos="0 -20 {-CS + 5}" rot="0 0 90" radius="3" height="2270" material="cable" />
    <cylinder pos="0 -11 {-CS + 5}" rot="0 0 90" radius="3" height="2270" material="cable_blue" />
  </group>
  <group name="Trays3">
    <box pos="0 315 {-CS + 4}" size="2280 2 8" material="tray"><array count="2" translation="0 50 0" /></box>
    <box pos="-1125 340 {-CS + 1}" size="2 48 2" material="tray"><array count="76" translation="30 0 0" /></box>
    <cylinder pos="0 330 {-CS + 5}" rot="0 0 90" radius="3" height="2270" material="cable" />
    <cylinder pos="0 339 {-CS + 5.5}" rot="0 0 90" radius="3.5" height="2270" material="cable_grey" />
    <cylinder pos="0 349 {-CS + 5}" rot="0 0 90" radius="3" height="2270" material="cable" />
  </group>

  <!-- The Star 7 and its two operator stations (console, chair). -->
  <prefab source="props/star7" name="Star7" pos="{CORE_X} {CORE_Y} 0" />
  <group name="WestStation" pos="{-CON_X} {CON_Y} 0" rot="0 0 {CON_A}">
    <prefab source="props/console" />
    <prefab source="props/office_chair" pos="0 -42 0" rot="0 0 180" />
    <prefab source="characters/technician" name="Tech1" pos="0 -42 0" rot="0 0 180" pose="Sit" />
  </group>
  <group name="EastStation" pos="{CON_X} {CON_Y} 0" rot="0 0 {-CON_A}">
    <prefab source="props/console" />
    <prefab source="props/office_chair" pos="0 -42 0" rot="0 0 180" />
    <prefab source="characters/technician" name="Tech2" pos="0 -42 0" rot="0 0 180" pose="Sit" color="0.30 0.26 0.20" />
  </group>

