<?xml version='1.0' encoding='UTF-8'?>
<!-- Обратный отсчёт: the S.T.A.R. Computer Complex upstate, 9:00 to 10:00 A.M. Z up, cm, X east, Y north.
     The Star 7 room on the third floor (after the module's 5-ft grid map): 2300 x 1400, ceiling 380, a
     raised floor of 120 cm panels over a 60 cm crawlspace full of cables. The chrome Star 7 core stands
     in the middle facing south, two console banks splay out before it, diagnostic banks line the north
     wall, the operations table with the log book is in the north-east corner, tape cabinets line the
     west wall, the double door and the ventilation grille are in the south wall, windows look east.
     Brock's men crawl in from a maintenance tunnel to the east and come up through three panels south
     of the core. The building's entrance with its two guards is modelled 80 m south (the gate group).
     Clark and Superman are authored 30 m below the floor; camera transforms give world positions. -->
<scene up="z" ambient="0.30 0.30 0.34" background="0.56 0.72 0.90">
  <camera name="star-show-gate" comment="The S.T.A.R. entrance: two armed guards stop Clark and his crew at the glass doors" pos="-700 -9300 260" look="150 -8100 260" fov="56" textRect="0.04 0.035 0.92 0.32" textScale="1">
    <transform target="Clark" pos="-120 -8380 3000" rot="0 0 165" />
    <use-pose instance="Clark" name="Stand" />
  </camera>
  <camera name="star-show-room" comment="The Star 7 room: the chrome core and its consoles, technicians at work, Rafferty showing the WGBS crew round" pos="1000 -620 330" look="-150 150 130" fov="64" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Clark" pos="-220 -470 3000" rot="0 0 200" />
  </camera>
  <camera name="star-show-vent" comment="The interview: Rafferty talks into Wirth's camera, Clark beside the ventilation grille where a purple wisp curls out" pos="-420 -500 260" look="400 -400 60" fov="62" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Clark" pos="260 -470 3000" rot="0 0 -128" />
    <transform target="Wisps" pos="0 0 3000" />
  </camera>
  <camera name="star-xray-floor" comment="X-ray view: under the floor panels three masked men crawl through the cables toward the room" pos="-420 -500 260" look="400 -400 60" fov="62" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Clark" pos="260 -470 3000" rot="0 0 -128" />
    <transform target="Floor" pos="0 0 -3000" />
    <transform target="Crawlers" pos="0 0 3000" />
  </camera>
  <camera name="star-gas" comment="Purple gas fills the room; everyone sleeps; three floor panels rise and masked heads come up" pos="900 -560 300" look="-100 -300 60" fov="62" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Gas" pos="0 0 3000" />
    <transform target="Clark" pos="-380 -560 3008" rot="88 0 -20" />
    <transform target="Rafferty" pos="-60 30 4" rot="88 0 140" />
    <use-pose instance="Tech1" name="Sleep" />
    <use-pose instance="Tech2" name="Sleep" />
    <transform target="Wirth" pos="0 0 6" rot="88 0 0" />
    <transform target="WirthCamera" pos="0 0 -146" />
    <transform target="Panels" pos="0 0 3000" />
    <transform target="PanelsUp" pos="0 0 3000" />
    <transform target="Rising" pos="0 0 3000" />
  </camera>
  <camera name="star-blowback" comment="Clark, coughing into his hand, blows the gas back into the grille; the technicians splutter" pos="-420 -500 260" look="400 -400 60" fov="62" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Clark" pos="300 -520 3000" rot="0 0 40" />
    <use-pose instance="Clark" name="Blow" />
    <transform target="Wisps" pos="0 0 3000" />
    <transform target="BlowBack" pos="0 0 3000" />
  </camera>
  <camera name="star-show-mercs" comment="Brock and his men stand over the open panels, pistols out over the sleepers; Superman faces them; a coil of cable lies by the hole" pos="-640 -140 250" look="100 -430 100" fov="62" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Superman" pos="-260 -200 3000" rot="0 0 -110" />
    <use-pose instance="Superman" name="HandsOnHips" />
    <transform target="Rafferty" pos="-60 30 4" rot="88 0 140" />
    <use-pose instance="Tech1" name="Sleep" />
    <use-pose instance="Tech2" name="Sleep" />
    <transform target="Wirth" pos="0 0 6" rot="88 0 0" />
    <transform target="WirthCamera" pos="0 0 -146" />
    <transform target="Panels" pos="0 0 3000" />
    <transform target="PanelsUp" pos="0 0 3000" />
    <transform target="Mercs" pos="0 0 3000" />
    <transform target="Coil" pos="0 0 3000" />
  </camera>
  <camera name="star-caught" comment="The three mercenaries sit bound in a loop of cable, their pistols in a heap; Superman stands guard" pos="-640 -140 250" look="100 -430 100" fov="62" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Superman" pos="-180 -280 3000" rot="0 0 -110" />
    <use-pose instance="Superman" name="HandsOnHips" />
    <transform target="Rafferty" pos="-60 30 4" rot="88 0 140" />
    <use-pose instance="Tech1" name="Sleep" />
    <use-pose instance="Tech2" name="Sleep" />
    <transform target="Wirth" pos="0 0 6" rot="88 0 0" />
    <transform target="WirthCamera" pos="0 0 -146" />
    <transform target="Panels" pos="0 0 3000" />
    <transform target="PanelsUp" pos="0 0 3000" />
    <transform target="Bound" pos="0 0 3000" />
  </camera>
  <camera name="star-show-sample" comment="Afterwards: everyone awake, Rafferty waving the worthless log book, the Star 7's screens glitching red; a spent gas grenade by the grille" pos="-620 -320 240" look="320 -520 100" fov="62" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Clark" pos="-80 -520 3000" rot="0 0 -60" />
    <transform target="Rafferty" pos="-120 -160 0" rot="0 0 60" />
    <use-pose instance="Rafferty" name="Panic" />
    <transform target="Glitch" pos="0 0 3000" />
    <transform target="Grenade" pos="0 0 3000" />
  </camera>
  <camera name="star-leave-crew" comment="Ending: Clark follows his crew out of the double door while every screen in the room flickers red behind them" pos="380 -230 255" look="-500 -690 110" fov="60" textRect="0.04 0.035 0.92 0.30" textScale="1">
    <transform target="Rafferty" pos="160 -689 0" />
    <transform target="Clark" pos="-460 -620 3000" rot="0 0 0" />
    <transform target="CrewGroup" pos="-200 -60 0" />
    <transform target="Glitch" pos="0 0 3000" />
  </camera>

  <material id="chrome" color="0.80 0.82 0.86" shininess="120" />
