    <sphere pos="-374 202 2.8" radius="65" scale="1.5 1 0.07" material="gas" castShadow="0"><noise strength="6" seed="53" /></sphere>
    <sphere pos="661 528 2.7" radius="99" scale="1.5 1 0.07" material="gas" castShadow="0"><noise strength="6" seed="54" /></sphere>
    <sphere pos="180 -255 3.0" radius="62" scale="1.5 1 0.07" material="gas" castShadow="0"><noise strength="6" seed="55" /></sphere>
    <sphere pos="728 442 4.4" radius="91" scale="1.5 1 0.07" material="gas" castShadow="0"><noise strength="6" seed="56" /></sphere>
    <sphere pos="-482 -448 2.3" radius="78" scale="1.5 1 0.07" material="gas" castShadow="0"><noise strength="6" seed="57" /></sphere>
    <sphere pos="-618 -128 3.0" radius="86" scale="1.5 1 0.07" material="gas" castShadow="0"><noise strength="6" seed="58" /></sphere>
    <sphere pos="-399 429 2.9" radius="104" scale="1.5 1 0.07" material="gas" castShadow="0"><noise strength="6" seed="59" /></sphere>
    <sphere pos="-919 -629 1.6" radius="99" scale="1.5 1 0.07" material="gas" castShadow="0"><noise strength="6" seed="60" /></sphere>
    <sphere pos="{GRILLE_X} -650 26" radius="44" scale="1.6 0.8 0.5" material="gas" castShadow="0"><noise strength="5" seed="99" /></sphere>
  </group>

  <!-- The hole opened: the three lifted panels dropped in a heap south-east of it. -->
  <group name="Open" pos="0 0 {S_OPEN}">
    <box pos="-330 -600 {PT/2}" rot="0 0 12" size="{P - PG} {P - PG} {PT}" material="panel" />
    <box pos="-318 -591 {PT*1.5}" rot="0 0 -7" size="{P - PG} {P - PG} {PT}" material="panel" />
    <box pos="-335 -596 {PT*2.5}" rot="0 0 27" size="{P - PG} {P - PG} {PT}" material="panel" />
  </group>

  <!-- Brock and his men out of the hole, pistols on the sleepers; Superman faces them; the coil of cable. -->
  <group name="Raid" pos="0 0 {S_RAID}">
    <prefab source="characters/superman" name="Superman" pos="-130 -230 0" rot="0 0 0" pose="HandsOnHips" />
    <prefab source="characters/merc" name="Brock" pos="-60 -540 0" rot="0 0 -167.3" pose="Aim" />
    <prefab source="characters/merc" name="Merc2" pos="90 -560 0" rot="0 0 -146.3" pose="Aim" />
    <prefab source="characters/merc" name="Merc3" pos="240 -480 0" rot="0 0 -124" pose="Aim" />
    <prefab source="props/cable_coil" pos="-250 -250 0" rot="0 0 20" />
    <!-- Revolvers gripped in the men's right hands: a gripped grip sits inside the simple fist, which the
         checker reads as an intersection. -->
    <group name="HeldPistols" sanityIgnore="1">
      <prefab source="props/pistol" pos="-60.3 -482.2 133.4" rot="0 0 -167.3" />
      <prefab source="props/pistol" pos="69.1 -506.1 133.4" rot="0 0 -146.3" />
      <prefab source="props/pistol" pos="200.1 -438.1 133.4" rot="0 0 -124" />
    </group>
  </group>

  <!-- Caught: the three men bound back to back in loops of cable, their pistols in a heap; Superman on guard. -->
  <group name="Caught" pos="0 0 {S_CAUGHT}">
    <prefab source="characters/superman" name="SupermanGuard" pos="-130 -230 0" rot="0 0 0" pose="HandsOnHips" />
    <prefab source="characters/merc" name="Bound1" pos="80.0 -500.0 0" rot="0 0 90.0" />
    <prefab source="characters/merc" name="Bound2" pos="50.0 -482.7 0" rot="0 0 -150.0" />
    <prefab source="characters/merc" name="Bound3" pos="50.0 -517.3 0" rot="0 0 -30.0" />
    <!-- The cable wound tight round the three men at chest and waist: it presses into them by design. -->
    <group name="BoundCable" sanityIgnore="1">
      <torus pos="60 -500 118" rot="90 0 0" majorRadius="43" minorRadius="2.6" material="cable" />
      <torus pos="60 -500 96" rot="90 0 15" majorRadius="42" minorRadius="2.6" material="cable" />
    </group>
    <!-- Their revolvers dropped in a loose heap, lying on their sides. -->
    <prefab source="props/pistol" pos="-60 -640 2.4" rot="0 90 20" />
    <prefab source="props/pistol" pos="-30 -625 2.4" rot="0 90 105" />
    <prefab source="props/pistol" pos="-52 -605 2.4" rot="0 -90 200" />
  </group>

  <!-- Afterwards: everyone up; Rafferty waves the log book; Wirth calls Clark to go; the spent grenade. -->
  <group name="After" pos="0 0 {S_AFTER}">
    <prefab source="characters/rafferty" name="RaffertyAfter" pos="-30 -230 0" rot="0 0 -90" pose="Wave" />
    <!-- The duty log waved in Rafferty's raised hand (gripped, so it overlaps his fist). -->
    <box name="LogBookWaved" pos="-46 -199 170" rot="78 0 -90" size="30 22 3" material="logbook" sanityIgnore="1" />
    <prefab source="characters/person" name="WirthAfter" pos="-460 -355 0" rot="0 0 -80" pose="Wave" color="0.38 0.30 0.52" />
    <prefab source="characters/person" name="ChiangAfter" pos="-300 -300 0" rot="0 0 -110" color="0.86 0.52 0.20" />
    <prefab source="star/tripod" pos="-560 -480 0" rot="0 0 60" />
    <prefab source="props/tv_camera" pos="-560 -480 140" rot="0 0 60" />
    <prefab source="characters/clark" name="ClarkAfter" pos="60 -560 0" rot="0 0 43.4" />
    <prefab source="props/grenade" name="Grenade" pos="{GRILLE_X + 40} -660 0" rot="0 0 30" />
    <prefab source="star/flight_case" pos="-690 -630 0" rot="0 0 8" />
    <prefab source="star/flight_case" pos="-620 -560 0" rot="0 0 -5" />
  </group>

  <!-- Every screen failing red after the gas: overlays in the exact frames of the screens they cover. -->
  <group name="Glitch" pos="0 0 {S_GLITCH}">
    <prefab source="star/star7_glitch" pos="{CORE_X} {CORE_Y} 0" />
    <prefab source="star/console_glitch" pos="{-CON_X} {CON_Y} 0" rot="0 0 {CON_A}" />
    <prefab source="star/console_glitch" pos="{CON_X} {CON_Y} 0" rot="0 0 {-CON_A}" />
  </group>

  <!-- Leaving: Chiang and Wirth go out through the open door with the gear, Clark follows. -->
  <group name="Leave" pos="0 0 {S_LEAVE}">
    <prefab source="characters/person" name="ChiangLeave" pos="-565 -800 0" rot="0 0 0" color="0.86 0.52 0.20" />
    <prefab source="characters/person" name="WirthLeave" pos="-470 -600 0" rot="0 0 -41" color="0.38 0.30 0.52">
      <joint target="pelvis" pos="0 0 -3" />
      <ik limb="left_leg" offset="0 -20 0" />
      <ik limb="right_leg" offset="0 16 2" />
    </prefab>
    <prefab source="characters/clark" name="ClarkLeave" pos="-300 -480 0" rot="0 0 -47.7">
      <joint target="pelvis" pos="0 0 -3" />
      <ik limb="right_leg" offset="0 -20 0" />
      <ik limb="left_leg" offset="0 16 2" />
    </prefab>
  </group>

  <!-- ================= Anchors =================
       Literal numbers on purpose: the book engine (src/scene.c) reads anchor and camera positions straight
       from this file and does not evaluate <let>/{expr}. Keep them in step with the objects they name. -->
  <group name="Guard" pos="-130 -8180 140" />
  <group name="Gate-Door" pos="50 -7992 120" />
  <group name="Vent" pos="150 -697 48" />
  <group name="Floor-Panels" pos="0 -380 0" />
  <group name="Panel-Hole" pos="0 -380 0" />
  <group name="Clark-Spot" pos="60 -590 140" />
  <group name="Rafferty-Spot" pos="60 -300 140" />
  <group name="Mercs-Group" pos="80 -530 130" />
  <group name="Cable" pos="-250 -250 12" />
  <group name="Vial" pos="190 -660 4" />
  <group name="East-Window" pos="1150 -480 190" />
  <group name="Crew" pos="-460 -355 140" />

  <!-- Outside the room: the corridor beyond the double door, the duct-free tunnel mouth, the view east. -->
  <group name="Corridor">
    <box pos="{DOOR_X} -870 -10" size="800 300 20" material="corridor" />
    <box pos="{DOOR_X} -1030 150" size="800 20 300" material="corridor" />
    <box pos="{DOOR_X - 410} -880 150" size="20 320 300" material="corridor" />
    <box pos="{DOOR_X + 410} -880 150" size="20 320 300" material="corridor" />
    <box pos="{DOOR_X} -880 310" size="840 320 20" material="corridor" />
  </group>
  <box pos="{DOOR_X} -870 298" size="60 120 4" material="troffer_glow" unlit="1" castShadow="0" />
  <light pos="{DOOR_X} -870 270" color="0.94 0.97 1.0" intensity="0.6" radius="400" castShadows="0" />
  <box name="Tunnel" pos="{W/2 + T + 160} {HY} {-CS/2 - 4}" size="320 140 76" material="duct" />
  <!-- The view east from the third floor: a painted backdrop of sky, hills and tree line. It neither takes
       nor casts light, so the sun still reaches the windows. -->
  <group name="View">
    <box pos="1800 0 300" size="10 5000 1600" material="sky" unlit="1" castShadow="0" />
    <box pos="1790 0 60" size="10 5000 140" material="far_hills" unlit="1" castShadow="0" />
    <box pos="1780 0 30" size="10 5000 120" material="far_trees" unlit="1" castShadow="0" />
  </group>

</scene>
