  <material id="tripod_metal" color="0.30 0.30 0.32" shininess="50" />
  <material id="case_alu" color="0.74 0.75 0.76" shininess="70" />
  <material id="camera_body" color="0.12 0.12 0.13" shininess="40" />
  <material id="camera_lens" color="0.05 0.05 0.06" shininess="90" />
  <material id="gas" color="0.70 0.52 0.86" shininess="2" />
  <material id="breath" color="0.88 0.94 1.0" shininess="2" />
  <material id="sky" color="0.70 0.82 0.95" />
  <material id="far_trees" color="0.30 0.42 0.30" />
  <material id="far_hills" color="0.52 0.62 0.56" />
  <material id="corridor" color="0.78 0.76 0.70" shininess="6" />
  <material id="logbook" color="0.14 0.22 0.46" shininess="10" />
  <material id="glass" color="0.62 0.78 0.88" shininess="90" />
  <material id="facade_glass" color="0.56 0.68 0.78" shininess="110" />
  <material id="door_glass" color="0.30 0.38 0.44" shininess="110" />
  <material id="mullion" color="0.24 0.26 0.28" shininess="40" />
  <material id="bronze" color="0.36 0.28 0.18" shininess="50" />
