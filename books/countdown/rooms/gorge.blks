  <!-- The line: ballasted track on both plateaus up to the abutment backwalls (x=-200 / GAP+200). -->
  <prefab source="props/rails" pos="{-700 - 15000} 0 0"><array count="16" translation="1000 0 0" /></prefab>
  <prefab source="props/rails" pos="{GAP + 700} 0 0"><array count="16" translation="1000 0 0" /></prefab>
  <!-- The trestle stubs on the bridge seats; the east one turned to face back over the gorge. -->
  <prefab source="gorge/trestle_stub" name="WestStub" pos="0 0 {SEAT}" />
  <prefab source="gorge/trestle_stub" name="EastStub" pos="{GAP} 0 {SEAT}" rot="0 0 180" />
  <!-- A girder of the lost span, washed onto the west gravel bar by the flood, lying on its flange. -->
  <prefab source="gorge/girder_wreck" pos="485 150 -2400" rot="0 0 90" />

  <!-- The old bridge stringers, stacked on the south side of the track near the west brink. -->
  <prefab source="gorge/timber_pile" name="TimberPile" pos="-1350 -470 {GROUND}" rot="0 0 1.5" />

  <!-- The span Superman builds from those stringers between the two stubs: four timbers on the bare
       girder ends, rails spiked on top. Stored; gorge-hold-span brings it up. -->
  <group name="Span" pos="0 0 {STORE}">
    <prefab source="props/timber" pos="{GAP/2} 89.5 -31" />
    <prefab source="props/timber" pos="{GAP/2} 54.5 -31" />
    <prefab source="props/timber" pos="{GAP/2} -54.5 -31" />
    <prefab source="props/timber" pos="{GAP/2} -89.5 -31" />
    <box pos="{GAP/2} 72 11.5" size="1500 7 15" material="rail" />
    <box pos="{GAP/2} -72 11.5" size="1500 7 15" material="rail" />
  </group>

  <!-- The train: the engine and the first car, then the two rear cars hung from the coupling behind
       the first car (RearCars' origin is that coupling, so a rotation swings them on its pin). -->
  <group name="Train" pos="{ENG} 0 0">
    <group name="Locomotive">
      <prefab source="props/engine" />
      <!-- The crushed nose for gorge-headon: buckled plates over the cab front. Stored. -->
      <group name="EngineNose" pos="0 0 {STORE}">
        <box pos="738 0 210" size="40 300 150" rot="0 -16 4" material="engine_body" />
        <box pos="742 60 300" size="30 150 70" rot="12 28 -10" material="engine_body" />
        <box pos="740 -70 310" size="26 140 60" rot="-14 -22 12" material="engine_body" />
        <box pos="752 0 110" size="34 290 60" rot="0 30 -6" material="engine_frame" />
        <box pos="725 0 352" size="10 230 60" rot="0 -18 0" material="engine_frame" />
        <box pos="748 -20 160" size="20 200 40" rot="8 -40 15" material="engine_frame" />
      </group>
    </group>
    <group name="Car1" pos="{-PITCH} 0 0"><prefab source="props/railcar" /></group>
    <group name="RearCars" pos="{-1.5*PITCH} 0 90">
      <group name="Car2" pos="{-PITCH/2} 0 -90"><prefab source="props/railcar" /></group>
      <group name="Car3" pos="{-PITCH} 0 0">
        <prefab source="props/railcar" pos="{-PITCH/2} 0 -90" />
      </group>
    </group>
  </group>

  <!-- Heat vision for gorge-weld: two beams from Superman's eyes into the coupling pin and the glow of
       the hot metal. Breath for gorge-breath: wind streaks from his mouth to the engine and the gravel
       it tears from the track. Both stored. -->
  <group name="HeatBeams" pos="0 0 {STORE}">
    <cylinder pos="998.4 -80 1100" rot="-7.49 0 -1.21" radius="2.6" height="153.3" material="beam" unlit="1" castShadow="0" />
    <cylinder pos="1001.6 -80 1100" rot="-7.49 0 1.21" radius="2.6" height="153.3" material="beam" unlit="1" castShadow="0" />
