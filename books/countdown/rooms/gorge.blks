<?xml version='1.0' encoding='UTF-8'?>
<!-- Обратный отсчёт: the disused branch line north of Rielly's Field, where the switching station sent the
     runaway 8:00 train. Z up, cm; X east along the track (y=0), Y north. The rail head on both rims is z=0.
     Resident story: the line crossed a narrow rock gorge on a steel trestle that replaced an older wooden
     bridge; the railway stacked the old bridge's stringers on the west rim and never took them away.
     A spring flood took the trestle years ago: the stubs of its girders and first bents still stand on
     both rims, a fallen girder lies on the gravel bar 24 m below, and the line has been closed since.
     Moments: the train is authored where gorge-show-train sees it; each other camera moves it, the
     timbers, the span and Superman with camera-scoped transforms and poses.
     Storage: actors and effects not in a shot wait 60 m under the set (z = STORE), below the ground plane
     where nothing is drawn or supported; each shot's transform brings them up by -STORE.
     Camera pos/look and anchor positions stay literal numbers: the C engine reads them without Scener's
     expression evaluator. The terrain blocks are written in terms of GAP, DEPTH and GROUND. -->
<scene up="z" ambient="0.27 0.29 0.33" background="0.60 0.74 0.90">
  <let name="GAP" value="1600" />      <!-- rim to rim at the crossing: west edge x=0, east edge x=GAP -->
  <let name="DEPTH" value="2400" />    <!-- rail head to the gravel of the riverbed -->
  <let name="GROUND" value="-45" />    <!-- both rims: plateau grass under the ballast (props/rails baseline) -->
  <let name="BED" value="-DEPTH" />
  <let name="SEAT" value="-181" />     <!-- abutment bridge seat: rail head minus the stub's 181 cm deck -->
  <let name="DROP" value="600" />      <!-- seat to the rock shelf under each stub's first bent -->
  <let name="CAR" value="1500" />      <!-- engine and car body length -->
  <let name="PITCH" value="CAR + 60" /><!-- coupler to coupler -->
  <let name="ENG" value="-2200" />     <!-- engine centre where the train runs at the gap (gorge-show-train) -->
  <let name="STORE" value="-6000" />   <!-- off-stage storage under the set -->
  <let name="SUP_Y" value="-3000" />   <!-- Superman's storage slot, clear of the stored effects -->

  <camera name="gorge-xray-bridge" comment="X-ray from the cab, the train seen through: the rails run out onto the broken trestle stub over the gorge, the far stub across the gap, the old timber pile on the rim beside the track" pos="-1900 0 900" look="900 -60 -900" fov="52" textRect="0.04 0.035 0.92 0.3" textScale="1">
    <transform target="Train" pos="0 0 {STORE}" />
  </camera>
  <camera name="gorge-show-train" comment="The runaway train racing along the rim toward the broken trestle stub at the brink, Superman flying alongside just ahead of the engine; the old timber pile beside the track near the brink" pos="0 -2600 800" look="-1600 100 100" fov="58" textRect="0.04 0.035 0.92 0.3" textScale="1">
    <transform target="Superman" pos="{-850} {-520 - SUP_Y} {330 - STORE}" rot="90 20 90" />
    <use-pose instance="Superman" name="Fly" />
  </camera>
  <camera name="gorge-lift-coupling" comment="Superman holds the engine and first car high over the east rim; behind the first car the coupling has snapped to one bent pin and the two rear cars hang down into the gorge" pos="1900 -3300 1500" look="1500 0 700" fov="56" textRect="0.04 0.035 0.92 0.3" textScale="1">
    <transform target="Train" pos="{3340 - ENG} 0 1000" />
    <transform target="RearCars" rot="0 -80 0" />
    <transform target="Car3" rot="0 -4 0" />
    <transform target="Superman" pos="{2560} {-10 - SUP_Y} {875 - STORE}" />
    <use-pose instance="Superman" name="Lift" />
  </camera>
  <camera name="gorge-weld" comment="Close on the coupling over the gorge: Superman's heat vision welds the bent pin; the rear cars hang level with the first car again" pos="250 -950 780" look="1000 -60 1380" fov="48" textRect="0.04 0.035 0.92 0.3" textScale="1">
    <transform target="Train" pos="{3340 - ENG} 0 1000" />
    <transform target="Superman" pos="{1000} {-170 - SUP_Y} {940 - STORE}" rot="0 0 180" />
    <use-pose instance="Superman" name="Hold" />
    <transform target="HeatBeams" pos="0 0 {-STORE}" />
  </camera>
  <camera name="gorge-hold-span" comment="Looking up from low in the gorge: Superman holds the span of old timbers on his hands while the engine rolls across it between the two broken trestle stubs" pos="1200 -1300 -1900" look="600 150 600" fov="56" textRect="0.04 0.035 0.92 0.3" textScale="1">
    <transform target="Span" pos="0 0 {-STORE}" />
    <transform target="TimberPile" pos="0 0 {STORE}" />
    <transform target="Train" pos="{1100 - ENG} 0 19" />
    <transform target="Superman" pos="{800} {-SUP_Y} {-31 - 200 - STORE}" />
    <use-pose instance="Superman" name="Lift" />
  </camera>
  <camera name="gorge-breath" comment="Superman hangs in the air over the gap and blows; the wind tears at the engine and gravel flies; the train stops with its front wheels past the last rail of the stub" pos="1300 -1500 450" look="0 0 220" fov="52" textRect="0.04 0.035 0.92 0.3" textScale="1">
    <transform target="Train" pos="{-525 - ENG} 0 0" />
    <transform target="Superman" pos="{620} {-SUP_Y} {140 - STORE}" rot="0 0 -90" />
    <use-pose instance="Superman" name="Blow" />
    <transform target="Breath" pos="0 0 {-STORE}" />
  </camera>
  <camera name="gorge-headon" comment="Ending: Superman braced on the brink has stopped the train with his body; the engine's nose is crushed and the cars behind have jumped the rails" pos="900 -1200 350" look="-900 0 200" fov="54" textRect="0.04 0.035 0.92 0.3" textScale="1">
    <transform target="Train" pos="{-850 - ENG} 0 0" />
    <transform target="EngineNose" pos="0 0 {-STORE}" />
    <transform target="Car1" pos="0 -70 -12" rot="2 0 6" />
    <transform target="RearCars" pos="0 40 -20" rot="-3 0 -11" />
    <transform target="Superman" pos="{-850 + 750 + 40} {-SUP_Y} {-STORE}" rot="0 0 -90" />
    <use-pose instance="Superman" name="Push" />
  </camera>
  <camera name="gorge-saved" comment="Across the gorge: the whole train stands safe on the east rim beyond the far stub; Superman has landed by the last car near the brink and waves to the passengers at the windows" pos="-100 -1300 350" look="2600 0 -150" fov="54" textRect="0.04 0.035 0.92 0.3" textScale="1">
    <transform target="Train" pos="{7400 - ENG} 0 0" />
    <transform target="Superman" pos="{2350} {-330 - SUP_Y} {-STORE}" rot="0 0 -40" />
    <use-pose instance="Superman" name="Wave" />
  </camera>

  <material id="engine_body" color="0.74 0.16 0.12" shininess="22" />
  <material id="engine_frame" color="0.15 0.15 0.17" shininess="30" />
  <material id="engine_stripe" color="0.96 0.84 0.34" shininess="20" />
  <material id="grille" color="0.30 0.30 0.32" shininess="10" />
  <material id="glass" color="0.30 0.42 0.52" shininess="90" />
  <material id="lamp" color="1.0 0.95 0.76" shininess="10" />
  <material id="car_body" color="0.76 0.78 0.80" shininess="50" />
  <material id="car_roof" color="0.48 0.50 0.52" shininess="30" />
  <material id="car_door" color="0.62 0.64 0.66" shininess="40" />
  <material id="steel" color="0.30 0.32 0.35" shininess="30" />
  <material id="rust" color="0.46 0.24 0.12" shininess="6" />
  <material id="concrete" color="0.58 0.56 0.52" shininess="4" />
  <material id="ballast" color="0.44 0.41 0.38" shininess="2" />
  <material id="ballast_top" color="0.52 0.49 0.45" shininess="2" />
  <material id="sleeper" color="0.30 0.22 0.16" shininess="2" />
  <material id="rail" color="0.42 0.36 0.32" shininess="50" />
  <material id="timber" color="0.50 0.42 0.32" shininess="4" />
  <material id="timber_dark" color="0.34 0.27 0.20" shininess="4" />
  <material id="grass" color="0.45 0.56 0.27" shininess="2" />
  <material id="gravel" color="0.58 0.54 0.48" shininess="3" />
  <material id="rock" color="0.58 0.52 0.45" shininess="5" />
  <material id="rock_warm" color="0.64 0.52 0.40" shininess="5" />
  <material id="rock_dark" color="0.44 0.40 0.36" shininess="5" />
  <material id="rock_rim" color="0.50 0.47 0.41" shininess="4" />
  <material id="masonry" color="0.66 0.62 0.55" shininess="4" />
  <material id="masonry_cap" color="0.74 0.71 0.64" shininess="4" />
  <material id="water" color="0.22 0.40 0.46" shininess="90" />
  <material id="hill" color="0.30 0.42 0.24" shininess="2" />
  <material id="hill_far" color="0.40 0.50 0.42" shininess="2" />
  <material id="bark" color="0.34 0.26 0.20" shininess="2" />
  <material id="leaf" color="0.24 0.40 0.18" shininess="2" />
  <material id="leaf_light" color="0.36 0.50 0.22" shininess="2" />
  <material id="pine" color="0.16 0.30 0.18" shininess="2" />
  <material id="beam" color="1.0 0.18 0.06" shininess="1" />
  <material id="glow" color="1.0 0.82 0.42" shininess="1" />
  <material id="wind" color="0.90 0.96 1.0" shininess="1" />

  <!-- July mid-morning sun high in the south-east: it lights the south faces of the train and the west
       wall of the gorge; a cool shadowless skylight from the north-west fills the shade. -->
  <sun dir="-0.3 0.6 -0.9" color="1.0 0.95 0.84" intensity="1.2" castShadows="1" />
  <sun dir="0.45 -0.35 -0.6" color="0.62 0.72 0.92" intensity="0.42" castShadows="0" />

  <!-- Land: plateaus, the two faceted rock walls in four strata, the masonry abutments built into the
       rims with the rock shelves under the first bents, the gravel bed, the river and its boulders, and
       the far hills. One interlocking natural assembly. -->
  <group name="Land">
    <!-- Plateau slabs: grass tops at GROUND, edges stepping with the bends of the rim. -->
    <box pos="-7380 -12500 {(GROUND + BED - 150)/2}" size="17240 7000 {GROUND - BED + 150}" material="grass" />
    <box pos="{GAP + 10380} -12500 {(GROUND + BED - 150)/2}" size="11240 7000 {GROUND - BED + 150}" material="grass" />
    <box pos="-7980 -7000 {(GROUND + BED - 150)/2}" size="16040 4000 {GROUND - BED + 150}" material="grass" />
    <box pos="{GAP + 9330} -7000 {(GROUND + BED - 150)/2}" size="13340 4000 {GROUND - BED + 150}" material="grass" />
    <box pos="-8251 -3750 {(GROUND + BED - 150)/2}" size="15498 2500 {GROUND - BED + 150}" material="grass" />
    <box pos="{GAP + 8730} -3750 {(GROUND + BED - 150)/2}" size="14540 2500 {GROUND - BED + 150}" material="grass" />
    <box pos="-8251 -1550 {(GROUND + BED - 150)/2}" size="15498 1900 {GROUND - BED + 150}" material="grass" />
    <box pos="{GAP + 8251} -1550 {(GROUND + BED - 150)/2}" size="15498 1900 {GROUND - BED + 150}" material="grass" />
    <box pos="-8160 0 {(GROUND + BED - 150)/2}" size="15680 1200 {GROUND - BED + 150}" material="grass" />
    <box pos="{GAP + 8160} 0 {(GROUND + BED - 150)/2}" size="15680 1200 {GROUND - BED + 150}" material="grass" />
    <box pos="-8251 1550 {(GROUND + BED - 150)/2}" size="15498 1900 {GROUND - BED + 150}" material="grass" />
    <box pos="{GAP + 8251} 1550 {(GROUND + BED - 150)/2}" size="15498 1900 {GROUND - BED + 150}" material="grass" />
    <box pos="-9292.5 3750 {(GROUND + BED - 150)/2}" size="13415 2500 {GROUND - BED + 150}" material="grass" />
    <box pos="{GAP + 8251} 3750 {(GROUND + BED - 150)/2}" size="15498 2500 {GROUND - BED + 150}" material="grass" />
    <box pos="-10792.5 7000 {(GROUND + BED - 150)/2}" size="10415 4000 {GROUND - BED + 150}" material="grass" />
    <box pos="{GAP + 7417.5} 7000 {(GROUND + BED - 150)/2}" size="17165 4000 {GROUND - BED + 150}" material="grass" />
    <box pos="-13417.5 12500 {(GROUND + BED - 150)/2}" size="5165 7000 {GROUND - BED + 150}" material="grass" />
    <box pos="{GAP + 5917.5} 12500 {(GROUND + BED - 150)/2}" size="20165 7000 {GROUND - BED + 150}" material="grass" />
    <!-- The gorge floor: a gravel bed under both walls. -->
    <box pos="{GAP/2} 0 {BED - 150}" size="34200 32600 300" material="gravel" />
    <!-- Rock walls: tilted, overlapping blocks in four strata, faces jittered into ledges. -->
    <box pos="{2259.9} -15209.9 {(GROUND - 524) / 2}" size="2039.9 1580.2 {GROUND + 524}" material="grass" />
    <box pos="{3280.9} -15220 {GROUND + -267.1}" rot="0.2 5.9 5.3" size="220 1659.7 505.2" material="rock_rim" />
    <box pos="{2313.9} -15347.4 {-DEPTH * 0.4360}" rot="1.4 -10 6.8" size="2375.5 1663.2 732" material="rock_warm" />
    <box pos="{3360.1} -15519.8 {-DEPTH * 0.3589}" rot="0 -6.8 7.4" size="320 756 532.3" material="rock" />
    <box pos="{2347.9} -15353.2 {-DEPTH * 0.6735}" rot="-1.1 -7.7 6.8" size="2456.8 1695.8 756" material="rock" />
    <box pos="{2383.2} -15343.2 {-DEPTH * 0.9518}" rot="2.7 -8.1 6.1" size="2526.8 1678.1 816" material="rock_dark" />
    <box pos="{3524} -14782.2 {-DEPTH * 0.8517}" rot="0 -6.1 -5" size="320 881.6 566.4" material="rock" />
    <box pos="{2035.8} -13688.5 {(GROUND - 524) / 2}" size="1591.7 1462.6 {GROUND + 524}" material="grass" />
    <box pos="{2832.4} -13677.1 {GROUND + -267}" rot="0.8 3 -6" size="220 1527.3 516.4" material="rock_rim" />
    <box pos="{2045.7} -13614.3 {-DEPTH * 0.3815}" rot="-0.7 -4.6 -4.5" size="1879.5 1592.3 732" material="rock_warm" />
    <box pos="{2876.1} -13424 {-DEPTH * 0.3240}" rot="0 -6.3 -3.7" size="320 776 560" material="rock" />
    <box pos="{2130.9} -13833.4 {-DEPTH * 0.6457}" rot="-2.1 -5.5 8.2" size="2031.5 1536.7 756" material="rock" />
    <box pos="{3035.9} -13854.8 {-DEPTH * 0.6573}" rot="0 -4.7 -5.8" size="320 724.1 511.6" material="rock_dark" />
    <box pos="{2172.7} -13751.3 {-DEPTH * 0.9404}" rot="0.1 -8.2 3.4" size="2120.1 1572 816" material="rock_dark" />
