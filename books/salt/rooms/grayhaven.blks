<?xml version='1.0' encoding='UTF-8'?>
<!-- The Salt Ledger. Projection rig for the placeholder plates: Z up, centimetres, X east,
     Y north. Every camera of a location stands at the same spot, eyes 160 cm, looking north
     with a 60 degree vertical field; its anchors lie on a plane 4 m ahead, as children of the
     location's group. On that plane the 3:2 frame is 693 cm wide and 462 cm tall, centred
     on the eye: an anchor at x 0 z 0 is the middle of the picture, x 346 the right edge,
     z 231 the top. A camera's comment is its brief: what the finished plate shows, and what
     `make placeholders` prints on the placeholder. -->
<scene up="z" ambient="0.15 0.16 0.18" background="0.08 0.09 0.10">
  <!-- office -->
  <camera name="visit" comment="Edith Voss in the client&apos;s chair across the desk, gloves in her lap, the green lamp between you" pos="0 0 160" look="0 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="office" comment="The desk: the folder on the blotter, the black telephone, the green glass lamp" pos="0 0 160" look="0 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="office-window" comment="The window side: rain on the glass, the streetlamp across the street, the client&apos;s chair empty" pos="0 0 160" look="0 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="office-door" comment="The door side: frosted glass lettered CROWE backwards, the hat on its hook" pos="0 0 160" look="0 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="office-file" comment="Close: the open folder, typed particulars, her pencil in the margin, a photograph clipped inside" pos="0 0 160" look="0 100 160" fov="60" textRect="0.08 0.08 0.80 0.70" textScale="1" />
  <camera name="phone" comment="Close: the black telephone, the receiver in your hand" pos="0 0 160" look="0 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="lamp-glass" comment="Close: the green glass lamp over a dry blotter" pos="0 0 160" look="0 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="window" comment="Through the wet glass: the streetlamp, and under it a man in an olive coat" pos="0 0 160" look="0 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="chair" comment="Close: the client&apos;s chair, still warm" pos="0 0 160" look="0 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="morning" comment="Grey morning: the folder still on the desk" pos="0 0 160" look="0 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="midnight" comment="Midnight, from the door: Edith back in the chair, the folder on the blotter, the window black with rain" pos="0 0 160" look="0 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="midnight-edith" comment="Edith close, in the chair, the locket at her throat" pos="0 0 160" look="0 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="locket" comment="Close: the locket open in her palm; Thomas, younger, dry" pos="0 0 160" look="0 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <!-- town -->
  <camera name="town-map" comment="The plan of Grayhaven on the office wall: the hill and the office, Bakery Row, the sluice, the harbour office, berth four" pos="3000 0 160" look="3000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <!-- wharf -->
  <camera name="wharf" comment="Berth four at night: the Patience at her pilings with Marsh on deck, the shack with its lit window and padlocked door, black water in front" pos="6000 0 160" look="6000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="pier-head" comment="The pier head looking back: the harbour office with one lit window, the lane climbing into fog" pos="6000 0 160" look="6000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="water" comment="Kneeling at the dock edge: black water between the pilings, something pale under it" pos="6000 0 160" look="6000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="marsh" comment="Caleb Marsh on the deck of the Patience: oilskin, knit cap, one clouded eye, the shack over his shoulder" pos="6000 0 160" look="6000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="padlock" comment="Close: a brass padlock through the hasp of the shack door" pos="6000 0 160" look="6000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="street" comment="The lane into the fog, a step behind yours" pos="6000 0 160" look="6000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="corner" comment="Where the hill starts: a hill lamp in fog, a man in a wet olive coat a few planks ahead" pos="6000 0 160" look="6000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="coat" comment="The man ahead has turned: the face from the folder, changed" pos="6000 0 160" look="6000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <!-- shack -->
  <camera name="shack" comment="Inside the shack: lamp, table, the ledger blotched with tidewater, a rope ring in the floorboards" pos="9000 0 160" look="9000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="shack-bare" comment="The same table without the ledger: lamp, rope ring in the floor" pos="9000 0 160" look="9000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="shack-door" comment="The shack door, and beside it a clerk&apos;s coat on a hook" pos="9000 0 160" look="9000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="shack-ledger" comment="Close: the ledger open, the ink taken by the tide" pos="9000 0 160" look="9000 100 160" fov="60" textRect="0.08 0.08 0.80 0.70" textScale="1" />
  <camera name="coat-hook" comment="Close: an olive clerk&apos;s coat with brass buttons, dry, his hat under it" pos="9000 0 160" look="9000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="below" comment="The trapdoor open: black water, a face rising" pos="9000 0 160" look="9000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <!-- tide -->
  <camera name="tide-office" comment="The harbour office at night: a high desk with the tide book open, a candlestick telephone, a window over the berths" pos="12000 0 160" look="12000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="tide-wall" comment="The harbour office wall: the duty roster under a nail, the door to the pier" pos="12000 0 160" look="12000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="tide-book" comment="Close: tonight&apos;s page of the tide book in Thomas&apos;s hand" pos="12000 0 160" look="12000 100 160" fov="60" textRect="0.08 0.08 0.80 0.70" textScale="1" />
  <camera name="tide-roster" comment="Close: the duty roster" pos="12000 0 160" look="12000 100 160" fov="60" textRect="0.08 0.08 0.80 0.70" textScale="1" />
  <camera name="receiver" comment="Close: the harbour office receiver at your ear" pos="12000 0 160" look="12000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="harbour-view" comment="From the harbour office window: berth four below, Marsh on deck, the shack lit" pos="12000 0 160" look="12000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <!-- alley -->
  <camera name="alley" comment="Bakery Row looking up: the tide board under a porch, Penry in his lit doorway, the footbridge chained at the end" pos="15000 0 160" look="15000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="alley-down" comment="Bakery Row looking down: the bakery window behind a blind, the lane falling to the harbour" pos="15000 0 160" look="15000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="board" comment="Close: the tide board, a wash of chalk, pegs for the boats" pos="15000 0 160" look="15000 100 160" fov="60" textRect="0.08 0.08 0.80 0.70" textScale="1" />
  <camera name="penry" comment="Abel Penry in his lit doorway: grey beard, no cap, a towel over his shoulder" pos="15000 0 160" look="15000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="bakery" comment="The bakery door open a hand&apos;s width, Ruth Kell behind it" pos="15000 0 160" look="15000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="chain" comment="Close: a chain across the bridgehead, padlocked to the rail" pos="15000 0 160" look="15000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <!-- sluice -->
  <camera name="sluice" comment="The footbridge over the black sluice: the iron grating below, the stair beyond, Bakery Row behind" pos="18000 0 160" look="18000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="grate" comment="Close: a board peg cut VOSS wedged in the grating" pos="18000 0 160" look="18000 100 160" fov="60" textRect="0.08 0.08 0.80 0.70" textScale="1" />
  <!-- landing -->
  <camera name="landing" comment="The top of the stair: the streetlamp, the office door behind it, the dark window opposite, the stair down" pos="21000 0 160" look="21000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="lamp" comment="Thomas under the streetlamp, olive coat, turning" pos="21000 0 160" look="21000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="opposite" comment="Close: a dark window, the curtain drawn back a hand&apos;s width" pos="21000 0 160" look="21000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <camera name="hall" comment="The hall: wet prints, green light under the office door" pos="21000 0 160" look="21000 100 160" fov="60" textRect="0.06 0.62 0.70 0.30" textScale="1" />
  <group name="office-rig" pos="0 400 160">
    <group name="office-folder" pos="-55 0 -46" />
    <group name="office-phone" pos="139 0 18" />
