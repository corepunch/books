<?xml version='1.0' encoding='UTF-8'?>
<!-- Painters' reference for Мира и лунный зайчик: Mira and Бублик at rest and in their key poses,
     beside the stool and the mirror for scale. Not book pages. Z up, centimetres. -->
<scene up="z" ambient="0.30 0.30 0.32" background="neutral">
  <camera name="sheet-lineup" comment="Scale line-up: stool, Mira, Бублик standing, mirror" pos="0 -260 70" look="0 0 30" fov="40" />
  <camera name="sheet-three-quarter" comment="Three-quarter view of both characters" pos="-170 -190 110" look="0 0 25" fov="38" />
  <camera name="sheet-back" comment="Back view" pos="40 230 80" look="0 0 25" fov="40" />
  <camera name="sheet-dog-poses" comment="Бублик asleep, one eye open and sitting" pos="1015 -340 110" look="1015 0 20" fov="42"><use-pose instance="DogSleep" name="DogSleep" /><use-pose instance="DogOneEye" name="DogOneEye" /><use-pose instance="DogSit" name="DogSit" /></camera>
  <camera name="sheet-mirror" comment="Grandmother's mirror close up, glass toward the camera" pos="140 -60 30" look="95 0 16" fov="30" />
  <pose name="DogSleep">
    <joint target="spine" pos="0 0 -27" />
    <joint target="neck" aim="0 18" />
    <joint target="head" aim="0 -8" />
    <joint target="left_shoulder" aim="0 -20" />
    <joint target="left_forearm" aim="0 -65" />
    <joint target="right_shoulder" aim="0 -20" />
    <joint target="right_forearm" aim="0 -65" />
    <joint target="left_hip" aim="20 -15" />
    <joint target="left_hock" aim="180 -60" />
    <joint target="right_hip" aim="-20 -15" />
    <joint target="right_hock" aim="180 -60" />
    <joint target="tail" aim="125 -5" />
  </pose>
  <pose name="DogOneEye">
    <joint target="spine" pos="0 0 -27" />
    <joint target="neck" aim="0 32" />
    <joint target="head" aim="0 -2" />
    <joint target="left_shoulder" aim="0 -20" />
    <joint target="left_forearm" aim="0 -65" />
    <joint target="right_shoulder" aim="0 -20" />
    <joint target="right_forearm" aim="0 -65" />
    <joint target="left_hip" aim="20 -15" />
    <joint target="left_hock" aim="180 -60" />
    <joint target="right_hip" aim="-20 -15" />
    <joint target="right_hock" aim="180 -60" />
    <joint target="tail" aim="125 -5" />
  </pose>
  <pose name="DogSit">
    <joint target="spine" pos="0 0 -27" aim="0 40" />
    <ik tip="left_front_paw" plant="1" pole="0 1 0" keepOrientation="1" />
    <ik tip="right_front_paw" plant="1" pole="0 1 0" keepOrientation="1" />
    <joint target="neck" aim="0 30" />
    <joint target="head" aim="0 -30" />
    <joint target="left_hip" aim="10 -40" />
    <joint target="left_hock" aim="180 -60" />
    <joint target="right_hip" aim="-10 -40" />
    <joint target="right_hock" aim="180 -60" />
    <joint target="tail" aim="170 -75" />
  </pose>
  <material id="pine" color="0.70 0.54 0.36" shininess="10" />
  <material id="dark_wood" color="0.36 0.25 0.18" shininess="10" />
  <material id="brass" color="0.72 0.52 0.22" shininess="40" />
  <material id="mirror_glass" color="0.86 0.90 0.98" shininess="120" />
  <material id="mira_fur" color="0.56 0.56 0.58" shininess="4" />
  <material id="mira_white" color="0.90 0.88 0.85" shininess="4" />
  <material id="mira_ear" color="0.82 0.56 0.56" shininess="4" />
  <material id="mira_eye" color="0.14 0.18 0.10" shininess="60" />
  <material id="mira_nose" color="0.82 0.44 0.48" shininess="20" />
  <material id="dog_fur" color="0.74 0.60 0.40" shininess="3" />
  <material id="dog_muzzle" color="0.30 0.22 0.16" shininess="3" />
  <material id="dog_nose" color="0.08 0.06 0.05" shininess="30" />
  <material id="dog_eye" color="0.06 0.05 0.04" shininess="60" />
  <sun dir="-0.5 0.7 -1" color="1 0.97 0.92" intensity="1.1" castShadows="1" />
  <box pos="500 0 -1" size="1600 600 2" color="0.62 0.62 0.60" />
  <prefab source="furniture/stool" pos="-95 0 0" />
  <prefab source="characters/mira" name="Mira" pos="-45 0 0" rot="0 0 -30" />
  <prefab source="characters/bublik" name="Dog" pos="40 -5 0" rot="0 0 -70" />
  <prefab source="items/mirror" pos="95 0 0" rot="0 0 -30" />
  <prefab source="characters/bublik" name="DogSleep" pos="890 0 0" rot="0 0 -90" />
  <prefab source="characters/bublik" name="DogOneEye" pos="1020 0 0" rot="0 0 -90" />
  <prefab source="characters/bublik" name="DogSit" pos="1140 0 0" rot="0 0 -90" />
</scene>
