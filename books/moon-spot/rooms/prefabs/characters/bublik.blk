<!-- Бублик, grandmother's old shaggy mongrel, as a bone skeleton. Body frame Z up, faces local -Y,
     his left is +X. About 48 cm at the shoulder standing, 85 cm nose to rump. The left ear stands,
     the right ear flops, so both are authored rather than mirrored. -->
<prefab>
  <bone name="spine" aim="0 0" aimEnd="0 6" segments="2" length="44" radius="13 14" material="dog_fur">
    <bone name="neck" aim="0 50" length="14" radius="8.5" material="dog_fur">
      <bone name="head" aim="0 0" length="13" radius="10 9" material="dog_fur">
        <bone name="muzzle" aim="0 -14" length="12" radius="5.5 5" taper="0.8" material="dog_muzzle">
          <sphere on="0 0" at="1" radius="2.3" material="dog_nose" />
        </bone>
        <bone name="left_ear" at="0.3" from="60 55" aim="35 70" length="9" radius="4.2 1.5" taper="0.3" material="dog_muzzle" />
        <bone name="right_ear" at="0.3" from="-60 55" aim="-100 -45" length="11" radius="4.6 1.5" taper="0.6" material="dog_muzzle" />
        <sphere on="32 22" at="0.72" radius="1.6" material="dog_eye" />
        <sphere on="-32 22" at="0.72" radius="1.6" material="dog_eye" />
      </bone>
    </bone>
    <bone name="left_shoulder" at="0.88" from="90 -50" aim="0 -85" length="15" radius="5 5.5" mirror="1" material="dog_fur">
      <bone name="left_forearm" aim="0 -90" length="14" radius="3.6" material="dog_fur">
        <bone name="left_front_paw" foot="1" aim="0 -8" length="6" radius="3.6 2.2" material="dog_muzzle" />
      </bone>
    </bone>
    <bone name="left_hip" at="0.1" from="90 -50" aim="0 -60" length="17" radius="7 7.5" mirror="1" material="dog_fur">
      <bone name="left_hock" aim="180 -70" length="16.75" radius="3.6" material="dog_fur">
        <bone name="left_hind_paw" foot="1" aim="0 -8" length="6.5" radius="3.6 2.2" material="dog_muzzle" />
      </bone>
    </bone>
    <bone name="tail" at="0" from="180 30" aim="180 25" aimEnd="180 -35" segments="3" length="30" radius="4.2" taper="0.5" material="dog_fur" />
  </bone>
</prefab>
