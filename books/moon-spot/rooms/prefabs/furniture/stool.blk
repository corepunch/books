<!-- Kitchen stool (табурет). Z up; seat 34 x 34 cm, seat top at z=45, baseline z=0.
     Square and symmetric; no front. -->
<prefab>
  <attach name="seat" pos="0 0 45" />
  <box pos="0 0 43" size="34 34 4" material="pine" />
  <box pos="-13 -13 20.5" size="3.5 3.5 41" material="dark_wood" />
  <box pos="13 -13 20.5" size="3.5 3.5 41" material="dark_wood" />
  <box pos="-13 13 20.5" size="3.5 3.5 41" material="dark_wood" />
  <box pos="13 13 20.5" size="3.5 3.5 41" material="dark_wood" />
  <box pos="0 -13 12" size="22.5 2 3" material="dark_wood" />
  <box pos="0 13 12" size="22.5 2 3" material="dark_wood" />
  <box pos="-13 0 18" size="2 22.5 3" material="dark_wood" />
  <box pos="13 0 18" size="2 22.5 3" material="dark_wood" />
</prefab>
