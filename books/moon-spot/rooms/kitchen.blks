<?xml version='1.0' encoding='UTF-8'?>
<!-- Grandmother's village kitchen at midnight. Z up, X east, Y north, centimetres.
     Interior x -200..200, y -170..170, floor z=0, ceiling z=240.
     Grandmother drank her tea at the window table, unpinned her hair at her round mirror and
     went to bed; Бублик sleeps on his mat by the banked stove, Mira's basket stands by the dresser.
     Route: floor -> stool seat (45) -> table top (75). The moon-spot is the story object: the
     mirror on the table throws it onto the dresser door, later onto the mat or into the basket. -->
<scene up="z" ambient="0.28 0.28 0.34" background="midnight">
  <camera name="floor-show-kitchen" comment="Wide: Mira watches the spot on the dresser; Бублик asleep by the stove; stool, table and window behind" pos="165 -163 160" look="-50 40 30" fov="62" textRect="0.03 0.76 0.42 0.19" textScale="0.72"><transform target="Mira" pos="-15 -45 0" rot="0 0 -124" /><use-pose instance="Mira" name="Watch" /><use-pose instance="Dog" name="DogSleep" /></camera>
  <camera name="floor-pounce-spot" comment="Mira rears against the dresser door where the spot trembles" pos="-70 -35 45" look="-150 48 38" fov="55" textRect="0.62 0.06 0.35 0.14" textScale="0.74"><transform target="Mira" pos="-140 50 0" rot="0 0 -90" /><use-pose instance="Mira" name="PounceDoor" /><use-pose instance="Dog" name="DogSleep" /></camera>
  <camera name="floor-wake-bublik" comment="Mira touches the sleeping dog's ear; he opens one eye" pos="150 -70 55" look="75 5 20" fov="55" textRect="0.03 0.81 0.38 0.14" textScale="0.74"><transform target="Mira" pos="63 -10 0" rot="0 0 90" /><use-pose instance="Mira" name="PawDog" /><use-pose instance="Dog" name="DogOneEye" /></camera>
  <camera name="floor-climb-stool" comment="Hind paws on the stool seat, front paws on the table edge" pos="-10 -10 70" look="40 80 64" fov="44" textRect="0.03 0.03 0.40 0.11" textScale="0.74"><transform target="Mira" pos="40 72 45" rot="0 0 180" /><use-pose instance="Mira" name="ClimbTable" /><use-pose instance="Dog" name="DogSleep" /></camera>
  <camera name="table-show-mirror" comment="High view from the table corner: mirror, Mira, curtain, stool and the whole floor with the spot on the dresser" pos="70 -130 195" look="0 100 55" fov="62" textRect="0.03 0.80 0.44 0.16" textScale="0.72"><transform target="Mira" pos="45 116 75" rot="0 0 100" /><use-pose instance="Mira" name="LookMirror" /><use-pose instance="Dog" name="DogSleep" /></camera>
  <camera name="table-push-mirror" comment="Mira paws the mirror; across the kitchen the spot sits on Бублик's nose and he sits up" pos="-20 0 105" look="85 70 80" fov="60" textRect="0.40 0.03 0.32 0.20" textScale="0.74"><transform target="MoonSpot" pos="0 0 -1000" /><transform target="SpotNose" pos="0 0 1000" /><transform target="Mirror" rot="0 0 70" /><transform target="Mira" pos="72 147 75" rot="0 0 10" /><use-pose instance="Mira" name="PawMirror" /><use-pose instance="Dog" name="DogSit" /></camera>
  <camera name="table-show-turned" comment="The same high view after the push: the spot lies on Бублик's mat and he sits up" pos="70 -130 195" look="0 100 55" fov="62" textRect="0.03 0.80 0.44 0.16" textScale="0.72"><transform target="MoonSpot" pos="0 0 -1000" /><transform target="SpotMat" pos="0 0 1000" /><transform target="Mirror" rot="0 0 70" /><transform target="Mira" pos="45 116 75" rot="0 0 100" /><use-pose instance="Mira" name="LookMirror" /><use-pose instance="Dog" name="DogSit" /></camera>
  <camera name="table-catch-curtain" comment="Mira, up on the sill board, hangs from the edge of the west curtain" pos="60 95 110" look="-10 160 118" fov="55" textRect="0.03 0.05 0.36 0.17" textScale="0.74"><transform target="Mira" pos="-2 160 100" rot="0 0 -90" /><use-pose instance="Mira" name="HangCurtain" /><use-pose instance="Dog" name="DogSleep" /></camera>
  <camera name="table-go-floor" comment="Mira at the table edge looks down at the stool" pos="-25 15 55" look="40 92 70" fov="55" textRect="0.03 0.03 0.38 0.11" textScale="0.74"><transform target="Mira" pos="40 100 75" rot="0 0 0" /><use-pose instance="Mira" name="LookDown" /><use-pose instance="Dog" name="DogSleep" /></camera>
  <camera name="floor-show-awake" comment="The wide view after the push: Бублик sits on his mat beside the spot" pos="165 -163 160" look="-50 40 30" fov="62" textRect="0.03 0.82 0.42 0.13" textScale="0.72"><transform target="MoonSpot" pos="0 0 -1000" /><transform target="SpotMat" pos="0 0 1000" /><transform target="Mirror" rot="0 0 70" /><transform target="Mira" pos="30 0 0" rot="0 0 70" /><use-pose instance="Mira" name="Watch" /><use-pose instance="Dog" name="DogSit" /></camera>
  <camera name="floor-talk-bublik" comment="Mira looks up at the sitting dog; the spot lies by his side; the stove glows" pos="15 -85 45" look="90 30 38" fov="55" textRect="0.70 0.05 0.27 0.19" textScale="0.72"><transform target="MoonSpot" pos="0 0 -1000" /><transform target="SpotMat" pos="0 0 1000" /><transform target="Mirror" rot="0 0 70" /><transform target="Mira" pos="52 22 0" rot="0 0 90" /><use-pose instance="Mira" name="LookUp" /><use-pose instance="Dog" name="DogSit" /></camera>
  <camera name="kitchen-sleep-basket" comment="Mira asleep in her basket inside the moon-spot; Бублик asleep again" pos="-30 20 95" look="-150 -90 12" fov="55" textRect="0.10 0.04 0.52 0.22" textScale="0.72"><transform target="MoonSpot" pos="0 0 -1000" /><transform target="SpotBasket" pos="0 0 1000" /><transform target="Mirror" rot="0 0 25" /><transform target="Mira" pos="-150 -95 8" rot="0 0 30" /><use-pose instance="Mira" name="Curl" /><use-pose instance="Dog" name="DogSleep" /></camera>
  <camera name="kitchen-sleep-bublik" comment="Mira curled against Бублик's side on the mat, both inside the moon-spot" pos="-20 -60 70" look="90 50 15" fov="55" textRect="0.03 0.80 0.54 0.16" textScale="0.72"><transform target="MoonSpot" pos="0 0 -1000" /><transform target="SpotMat" pos="0 0 1000" /><transform target="Mirror" rot="0 0 70" /><transform target="Mira" pos="78 30 0" rot="0 0 -30" /><use-pose instance="Mira" name="Curl" /><use-pose instance="Dog" name="DogSleep" /></camera>
  <pose name="Watch">
    <joint target="spine" pos="0 0 -2" aim="0 20" />
    <ik tip="left_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <ik tip="right_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <joint target="neck" aim="0 10" />
    <joint target="head" aim="0 15" />
    <joint target="tail" aim="160 20" />
  </pose>
  <camera name="cover" comment="Cover: Mira watches the moon-spot on the dresser, Бублик asleep by the stove; the ceiling and upper wall hold the title" pos="130 -150 65" look="-60 40 75" fov="62"><transform target="Mira" pos="15 -55 0" rot="0 0 -120" /><use-pose instance="Mira" name="Watch" /><use-pose instance="Dog" name="DogSleep" /></camera>
  <pose name="PounceDoor">
    <joint target="spine" pos="0 0 -2" aim="0 60" />
    <ik tip="left_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <ik tip="right_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <ik tip="left_front_paw" target="-151.4 46 32" pole="1 0 0" keepOrientation="1" />
    <ik tip="right_front_paw" target="-151.4 54 35" pole="1 0 0" keepOrientation="1" />
    <joint target="neck" aim="0 -10" />
    <joint target="head" aim="0 10" />
    <joint target="tail" aim="170 40" />
  </pose>
  <pose name="PawDog">
    <ik tip="left_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <ik tip="right_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <ik tip="left_front_paw" target="85 -8 23" pole="0 0 1" />
    <joint target="head" aim="-20 20" />
    <joint target="tail" aim="160 45" />
  </pose>
  <pose name="LookUp">
    <joint target="spine" pos="0 0 -2" aim="0 18" />
    <ik tip="left_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <ik tip="right_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <joint target="neck" aim="0 20" />
    <joint target="head" aim="0 35" />
    <joint target="tail" aim="170 50" />
  </pose>
  <pose name="ClimbTable">
    <joint target="spine" pos="0 0 -3" aim="0 62" />
    <joint target="neck" aim="0 20" />
    <joint target="head" aim="0 -5" />
    <ik tip="left_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <ik tip="right_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <ik tip="left_front_paw" target="45 86.5 75.3" pole="0 1 0" keepOrientation="1" />
    <ik tip="right_front_paw" target="35 86.5 75.3" pole="0 1 0" keepOrientation="1" />
  </pose>
  <pose name="LookDown">
    <joint target="neck" aim="0 -10" />
    <joint target="head" aim="0 -40" />
  </pose>
  <pose name="LookMirror">
    <joint target="head" aim="0 -5" />
    <joint target="tail" aim="160 45" />
  </pose>
  <pose name="PawMirror">
    <ik tip="left_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <ik tip="right_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <ik tip="left_front_paw" target="76 136 96" pole="0 0 1" />
    <joint target="head" aim="0 5" />
    <joint target="tail" aim="160 50" />
  </pose>
  <pose name="HangCurtain">
    <joint target="spine" pos="0 0 -2" aim="0 70" />
    <ik tip="left_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <ik tip="right_hind_paw" plant="1" pole="0 -1 0" keepOrientation="1" />
    <ik tip="left_front_paw" target="-9 158 124" pole="1 0 0" />
    <ik tip="right_front_paw" target="-9 163 120" pole="1 0 0" />
    <joint target="neck" aim="0 -15" />
    <joint target="head" aim="0 15" />
    <joint target="tail" aim="180 -40" />
  </pose>
  <pose name="Curl">
    <joint target="spine" pos="0 0 -6" />
    <joint target="neck" aim="-40 -10" />
    <joint target="head" aim="-60 -25" />
    <joint target="tail" aim="120 -10" />
    <joint target="tail_2" aim="90 0" />
  </pose>
  <pose name="DogSleep">
    <joint target="spine" pos="0 0 -27" />
    <joint target="neck" aim="0 18" />
    <joint target="head" aim="0 -8" />
    <joint target="left_shoulder" aim="0 -20" />
    <joint target="left_forearm" aim="0 -65" />
    <joint target="right_shoulder" aim="0 -20" />
    <joint target="right_forearm" aim="0 -65" />
    <joint target="left_hip" aim="20 -15" />
    <joint target="left_hock" aim="180 -60" />
    <joint target="right_hip" aim="-20 -15" />
    <joint target="right_hock" aim="180 -60" />
    <joint target="tail" aim="125 -5" />
  </pose>
  <pose name="DogOneEye">
    <joint target="spine" pos="0 0 -27" />
    <joint target="neck" aim="0 32" />
    <joint target="head" aim="0 -2" />
    <joint target="left_shoulder" aim="0 -20" />
    <joint target="left_forearm" aim="0 -65" />
    <joint target="right_shoulder" aim="0 -20" />
    <joint target="right_forearm" aim="0 -65" />
    <joint target="left_hip" aim="20 -15" />
    <joint target="left_hock" aim="180 -60" />
    <joint target="right_hip" aim="-20 -15" />
    <joint target="right_hock" aim="180 -60" />
    <joint target="tail" aim="125 -5" />
  </pose>
  <pose name="DogSit">
    <joint target="spine" pos="0 0 -27" aim="0 40" />
    <ik tip="left_front_paw" plant="1" pole="0 1 0" keepOrientation="1" />
    <ik tip="right_front_paw" plant="1" pole="0 1 0" keepOrientation="1" />
    <joint target="neck" aim="0 30" />
    <joint target="head" aim="0 -30" />
    <joint target="left_hip" aim="10 -40" />
    <joint target="left_hock" aim="180 -60" />
    <joint target="right_hip" aim="-10 -40" />
    <joint target="right_hock" aim="180 -60" />
    <joint target="tail" aim="170 -75" />
  </pose>

  <material id="whitewash" color="0.72 0.72 0.74" shininess="2" />
  <material id="dark_wood" color="0.36 0.25 0.18" shininess="10" />
  <material id="pine" color="0.70 0.54 0.36" shininess="10" />
  <material id="floorboards" color="0.46 0.30 0.22" shininess="6" />
  <material id="brass" color="0.72 0.52 0.22" shininess="40" />
  <material id="iron" color="0.16 0.16 0.17" shininess="20" />
  <material id="dresser_green" color="0.33 0.45 0.36" shininess="8" />
  <material id="dresser_panel" color="0.38 0.50 0.40" shininess="8" />
  <material id="plate" color="0.86 0.86 0.84" shininess="30" />
  <material id="jar" color="0.52 0.40 0.30" shininess="20" />
  <material id="enamel" color="0.88 0.88 0.86" shininess="40" />
  <material id="enamel_blue" color="0.30 0.42 0.62" shininess="40" />
  <material id="curtain" color="0.52 0.62 0.78" shininess="3" />
  <material id="mat_felt" color="0.50 0.36 0.26" shininess="2" />
  <material id="photo" color="0.62 0.58 0.50" shininess="4" />
  <material id="mirror_glass" color="0.86 0.90 0.98" shininess="120" />
  <material id="wicker" color="0.66 0.50 0.30" shininess="4" />
  <material id="wicker_dark" color="0.50 0.36 0.20" shininess="4" />
  <material id="cushion" color="0.62 0.26 0.24" shininess="3" />
  <material id="yarn" color="0.30 0.52 0.62" shininess="3" />
  <material id="mira_fur" color="0.56 0.56 0.58" shininess="4" />
  <material id="mira_white" color="0.90 0.88 0.85" shininess="4" />
  <material id="mira_ear" color="0.82 0.56 0.56" shininess="4" />
  <material id="mira_eye" color="0.14 0.18 0.10" shininess="60" />
  <material id="mira_nose" color="0.82 0.44 0.48" shininess="20" />
  <material id="dog_fur" color="0.74 0.60 0.40" shininess="3" />
  <material id="dog_muzzle" color="0.30 0.22 0.16" shininess="3" />
  <material id="dog_nose" color="0.08 0.06 0.05" shininess="30" />
  <material id="dog_eye" color="0.06 0.05 0.04" shininess="60" />
  <!-- The moon-spot is reflected light: unlit silver, casts nothing. -->
  <material id="moon_spot" color="0.90 0.94 1.0" shininess="1" />

  <!-- A low moon through the north window, about 43 degrees down and 22 degrees off the wall axis.
       It lights the table top and the mirror. -->
  <sun dir="-0.4 -1 -1" color="0.62 0.72 1.0" intensity="1.3" castShadows="1" />

  <!-- Shell: floor, ceiling with two beams, four walls. -->
  <box pos="0 0 -5" size="432 372 10" material="floorboards" />
  <box pos="0 0 248" size="432 372 16" material="whitewash" />
  <box pos="-70 0 233" size="14 340 14" material="dark_wood" />
  <box pos="90 0 233" size="14 340 14" material="dark_wood" />
  <group pos="0 178 0" rot="90 0 0">
    <wall length="432" height="240" thickness="16" material="whitewash" bottomTrimHeight="10" trimMaterial="dark_wood" />
    <window preset="cottage" pos="40 155 0" width="100" height="110" pane="0" sill="0" frameMaterial="pine" />
  </group>
  <group pos="-208 0 0" rot="90 0 90">
    <wall length="340" height="240" thickness="16" material="whitewash" bottomTrimHeight="10" trimMaterial="dark_wood" />
  </group>
  <group pos="208 0 0" rot="90 0 -90">
    <wall length="340" height="240" thickness="16" material="whitewash" bottomTrimHeight="10" trimMaterial="dark_wood" />
  </group>
  <!-- The door to the hall and grandmother's room stays shut. -->
  <group pos="0 -178 0" rot="90 0 180">
    <wall length="432" height="240" thickness="16" material="whitewash" bottomTrimHeight="10" trimMaterial="dark_wood" />
    <door preset="rectangular" pos="60 100 0" width="90" height="200" hinge="left" frameMaterial="dark_wood" leafMaterial="pine" hardwareMaterial="brass" />
  </group>

  <!-- Window: sill board, curtain rod on two brackets, two short checked curtains. -->
  <box pos="40 160 98" size="116 20 4" material="pine" />
  <cylinder pos="40 165 218" rot="0 0 90" radius="1.2" height="150" material="brass" />
  <box pos="-32 166 218" size="3 8 3" material="brass" />
  <box pos="112 166 218" size="3 8 3" material="brass" />
  <box pos="98 165 160.3" size="24 4 113" material="curtain" />
  <!-- The photograph by the window: grandmother and puppy Бублик chasing a sun-spot (painted). -->
  <box pos="150 169 150" size="30 2 24" material="dark_wood" />
  <box pos="150 167.9 150" size="24 0.2 18" material="photo" />

  <!-- The table under the window, the stool pulled out, the switched-off lamp above. -->
  <prefab source="furniture/kitchen_table" pos="40 120 0" />
  <prefab source="furniture/stool" pos="40 62 0" rot="0 0 6" />
  <cylinder pos="40 120 211" rot="90 0 0" radius="0.5" height="58" material="iron" />
  <cylinder pos="40 120 180" rot="90 0 0" radius="4" height="6" material="enamel" />
  <cylinder pos="40 120 172" rot="90 0 0" radius="15" height="10" tube="0.8" material="enamel" />
  <!-- Grandmother's tea things. -->
  <cylinder pos="84 100 75.5" rot="90 0 0" radius="7" height="1" material="plate" />
  <cylinder pos="84 100 79.5" rot="90 0 0" radius="4" height="7" material="plate" />
  <cylinder pos="88 114 80" rot="90 0 0" radius="5" height="9" material="enamel_blue" />

  <!-- The dresser against the west wall, doors facing east. -->
  <prefab source="furniture/dresser" pos="-177.5 20 0" rot="0 0 90" />

  <!-- The stove against the east wall, fire door facing west, Бублик's mat in front of it. -->
  <prefab source="fixtures/stove" pos="170 40 0" rot="0 0 -90" />
  <ellipse pos="100 25 0.5" size="65 100" material="mat_felt"><extrude amount="1" /></ellipse>

  <!-- Mira's corner: her basket south of the dresser, her yarn ball. -->
  <prefab source="items/basket" pos="-150 -95 0" />
  <sphere pos="-115 -70 4.5" radius="4.5" material="yarn" />

  <!-- Story objects. The mirror turns per state; its group is the anchor at the glass centre. -->
  <group name="Mirror" pos="78 132 93" rot="0 0 -70"><prefab source="items/mirror" pos="0 0 -18" /></group>
  <group name="Curtain" pos="-18 165 160.3"><box size="24 4 113" material="curtain" /></group>
  <group name="MoonSpot" pos="-152.8 50 45"><ellipse rot="0 90 0" size="15 20" material="moon_spot" unlit="1" castShadow="0"><extrude amount="0.2" /></ellipse></group>
  <!-- Later spot states are authored 1000 cm below the floor and raised by the cameras that show them
       (story states, not supports). -->
  <group name="SpotMat" pos="76 36 -998.9"><ellipse rot="0 0 40" size="22 16" material="moon_spot" unlit="1" castShadow="0"><extrude amount="0.2" /></ellipse></group>
  <group name="SpotBasket" pos="-150 -95 -989.7"><ellipse rot="0 0 40" size="24 18" material="moon_spot" unlit="1" castShadow="0"><extrude amount="0.2" /></ellipse></group>

  <!-- The spot on Бублик's nose in the push beat; raised only by that camera. -->
  <group name="SpotNose" pos="100 4 -953"><sphere scale="1 1 0.6" radius="4" material="moon_spot" unlit="1" castShadow="0" /></group>

  <!-- Characters; every camera places and poses them. -->
  <prefab source="characters/mira" name="Mira" />
  <prefab source="characters/bublik" name="Dog" pos="100 62 0" rot="0 0 0" />

  <!-- Anchors for the interaction circles. -->
  <group name="Stool" pos="40 62 45" />
  <group name="Bublik" pos="100 30 24" />
</scene>
