  <pose name="PickGold">
    <joint target="head" rot="0 0 -17" />
    <ik root="near_shoulder" mid="near_elbow" tip="near_hand" target="-121 4.5 85" pole="0 0 1" keepOrientation="1" />
    <ik root="far_shoulder" mid="far_elbow" tip="far_hand" target="-121 4.5 79" pole="0 0 -1" keepOrientation="1" />
  </pose>
  <pose name="PickCopper">
