  <!-- The sea, at low tide. -->
  <group name="Sea"><box pos="1000 3000 -45" size="16000 16000 50" material="sea" /></group>

  <!-- Village land, beach and the spit to the fork. -->
  <box pos="0 -1250 -80" size="8000 2500 240" material="grass" />
