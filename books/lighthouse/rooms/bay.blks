  <box pos="-1000 450 50" size="160 1100 10" material="wood" />
  <cylinder pos="-1070 200 -20" rot="90 0 0" radius="8" height="140" material="dark_wood" />
  <cylinder pos="-930 200 -20" rot="90 0 0" radius="8" height="140" material="dark_wood" />
