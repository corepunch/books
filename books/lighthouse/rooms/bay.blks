  <box pos="1500 5050 -80" size="4600 700 240" material="grass" />
  <box pos="1330 5560 50" size="120 520 8" material="wood" />
  <cylinder pos="1280 5780 0" rot="90 0 0" radius="8" height="120" material="dark_wood" />
  <cylinder pos="1380 5780 0" rot="90 0 0" radius="8" height="120" material="dark_wood" />
  <cylinder pos="1900 5480 -30" rot="90 0 0" radius="48" height="60" material="stone" />
  <cylinder pos="1900 5660 -30" rot="90 0 0" radius="42" height="60" material="stone" />
  <cylinder pos="1900 5840 -30" rot="90 0 0" radius="48" height="60" material="stone" />
