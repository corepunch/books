  <camera name="cover" comment="Cover: Varya at the fork with the whole bay and the lighthouse ahead; sky for the title" pos="1500 -520 300" look="1250 2500 700" fov="58"><transform target="Varya" pos="1180 120 40" rot="0 0 170" /><use-pose instance="Varya" name="Walk" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /></camera>
