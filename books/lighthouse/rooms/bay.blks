<?xml version='1.0' encoding='UTF-8'?>
<!-- Огонь на маяке: the bay. Every outdoor page is a camera here, so the lighthouse, the island and
     the shores stay in the same places on every page. Z up, X east, Y north, centimetres,
     storybook-compressed: the village is 70 m from the island.
     Village and beach: y < 250, land top z=40. The spit and the fork: x -400..1400, y 250..700.
     Cliff plateau: x -600..1300, y 700..4300, top z=600, cut by the gully at y 2900..3300 (rope bridge
     at x=500). The flats: x 1300..3500, sand at z=5, wreck of the Chaika at (2300, 2650), the sandbar
     that stays dry at z=30. North shore y 4700..5400 with the ferry landing. The channel y 5400..6600,
     stepping stones at x=900. The island rock and the lighthouse at (800, 7200).
     The Sea group sits at low tide; cameras raise it for the tide. -->
<scene up="z" ambient="0.30 0.30 0.36" background="0.36 0.36 0.46">
  <camera name="harbour-show-timka" comment="The harbour: Timka mends nets on the pier, Varya runs up; boats on the shingle; the lighthouse far across the bay" pos="-720 60 150" look="-1010 700 110" fov="58" textRect="0.04 0.035 0.92 0.32" textScale="1" textRect2="0.04 0.47 0.92 0.37" textScale2="1"><transform target="Varya" pos="-1000 300 55" rot="0 0 180" /><use-pose instance="Varya" name="Run" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /></camera>
  <camera name="harbour-show-fork" comment="The fork by the old signpost: the path up to the cliffs on the left, the sand path to the flats on the right, the lighthouse ahead" pos="1400 -250 260" look="875 1367 300" fov="66" textRect="0.04 0.035 0.92 0.32" textScale="1" textRect2="0.04 0.58 0.92 0.36" textScale2="1"><transform target="Varya" pos="1130 250 40" rot="0 0 165" /><use-pose instance="Varya" name="Walk" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /></camera>
  <camera name="flats-show-wreck" comment="The tidal flats: the wreck of the Chaika, the seal on its rock, the path up the cliff face behind, the lighthouse far north" pos="2150 950 260" look="1800 2700 120" fov="66" textRect="0.04 0.035 0.92 0.32" textScale="1" textRect2="0.04 0.48 0.92 0.36" textScale2="1"><transform target="Varya" pos="1900 1500 5" rot="0 0 150" /><use-pose instance="Varya" name="LookUp" /></camera>
  <camera name="flats-climb-wreck" comment="Varya climbs out through the hole in the wreck; water already round the hull" pos="2700 2300 130" look="2330 2650 80" fov="55" textRect="0.04 0.035 0.92 0.32" textScale="1" textRect2="0.04 0.50 0.92 0.34" textScale2="1"><transform target="Varya" pos="2400 2560 5" rot="0 0 150" /><use-pose instance="Varya" name="Climb" /><transform target="Sea" pos="0 0 28" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /></camera>
  <camera name="flats-show-tide" comment="The tide comes in round the wreck: knee-deep water to the north shore, the dry deck above" pos="2800 2300 220" look="2150 3500 60" fov="62" textRect="0.04 0.035 0.92 0.32" textScale="1" textRect2="0.04 0.60 0.92 0.34" textScale2="1"><transform target="Varya" pos="2250 2950 5" rot="0 0 170" /><use-pose instance="Varya" name="LookUp" /><transform target="Sea" pos="0 0 30" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /></camera>
  <camera name="flats-night-wreck" comment="Ending: Varya hugs her knees on the deck, the sea all round, the lighthouse dark" pos="2550 2380 240" look="2230 2700 120" fov="58" textRect="0.04 0.035 0.92 0.32" textScale="1" textRect2="0.04 0.49 0.92 0.35" textScale2="1"><transform target="Varya" pos="2220 2700 118" rot="0 0 200" /><use-pose instance="Varya" name="SitHug" /><transform target="Sea" pos="0 0 70" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /></camera>
  <camera name="flats-run-stones" comment="Varya splashes through the rising water toward the north shore" pos="2450 3750 160" look="2000 4900 60" fov="58" textRect="0.04 0.035 0.92 0.32" textScale="1" textRect2="0.04 0.50 0.92 0.34" textScale2="1"><transform target="Varya" pos="2150 4300 5" rot="0 0 170" /><use-pose instance="Varya" name="Run" /><transform target="Sea" pos="0 0 38" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /></camera>
  <camera name="flats-follow-seal" comment="The secret sandbar: Varya walks the dry strip while the seal swims beside her" pos="2650 3450 230" look="2000 4300 30" fov="58" textRect="0.04 0.035 0.92 0.32" textScale="1" textRect2="0.04 0.40 0.92 0.44" textScale2="1"><transform target="Varya" pos="2080 3950 30" rot="0 0 200" /><use-pose instance="Varya" name="Walk" /><transform target="Sea" pos="0 0 28" /><transform target="SealActor" pos="1215 -1204 -65" rot="0 0 50" /><use-pose instance="SealActor" name="SealSwim" /></camera>
  <camera name="cliffs-show-hut" comment="The cliff top: Agafya at her hut and goat pen, the rope bridge over the gully beyond, the path down to the flats" pos="-150 1150 820" look="650 2700 640" fov="62" textRect="0.04 0.035 0.92 0.32" textScale="1" textRect2="0.04 0.48 0.92 0.36" textScale2="1"><transform target="Varya" pos="100 1560 600" rot="0 0 110" /><use-pose instance="Varya" name="LookUp" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /></camera>
  <camera name="cliffs-cross-bridge" comment="On the rope bridge: Varya on the second plank before the rotten third one, the stream far below" pos="720 2930 660" look="500 3000 605" fov="60" textRect="0.04 0.035 0.92 0.32" textScale="1" textRect2="0.04 0.60 0.92 0.34" textScale2="1"><transform target="Varya" pos="500 2948 600" rot="0 0 180" /><use-pose instance="Varya" name="Balance" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /></camera>
  <camera name="cliffs-hang-bridge" comment="Ending: the third plank has broken; Varya hangs from the ropes and Agafya runs up" pos="780 2800 560" look="480 3000 520" fov="60" textRect="0.05 0.04 0.90 0.14" textScale="1.65" textRect2="0.05 0.29 0.90 0.55" textScale2="1"><transform target="Varya" pos="500 2982 425" rot="0 0 180" /><use-pose instance="Varya" name="Hang" /><transform target="AgafyaActor" pos="-734 909 0" rot="0 0 230" /><use-pose instance="AgafyaActor" name="Wave" /><transform target="BrokenPlank" pos="0 0 1000" /><transform target="RottenPlank" pos="0 0 -1000" rot="0 0 0" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /></camera>
  <camera name="cliffs-past-bridge" comment="Varya steps off the far end of the bridge; the path runs down to the channel" pos="150 3600 720" look="550 3100 620" fov="55" textRect="0.04 0.035 0.92 0.32" textScale="1" textRect2="0.04 0.50 0.92 0.34" textScale2="1"><transform target="Varya" pos="500 3330 600" rot="0 0 180" /><use-pose instance="Varya" name="Walk" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /></camera>
  <camera name="cliffs-walk-agafya" comment="Agafya leads Varya round the gully by the sheep track at sunset" pos="-950 2250 760" look="-500 2800 640" fov="58" textRect="0.04 0.035 0.92 0.34" textScale="1" textRect2="0.04 0.50 0.92 0.34" textScale2="1"><transform target="Varya" pos="-520 2520 600" rot="0 0 180" /><use-pose instance="Varya" name="Walk" /><transform target="AgafyaActor" pos="-1182 93 0" rot="0 0 240" /><use-pose instance="AgafyaActor" name="Point" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /></camera>
  <camera name="channel-show-ferry" comment="The landing: Savely smokes by his hut, his boat at the jetty, the stepping stones running across to the island" pos="1000 4700 300" look="1600 6300 150" fov="62" textRect="0.04 0.035 0.92 0.35" textScale="1" textRect2="0.04 0.60 0.92 0.34" textScale2="1"><transform target="Varya" pos="1250 5000 40" rot="0 0 180" /><use-pose instance="Varya" name="LookUp" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /><transform target="Sea" pos="0 0 8" /></camera>
