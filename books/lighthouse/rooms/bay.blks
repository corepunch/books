  <cylinder pos="1900 6380 -30" rot="90 0 0" radius="42" height="60" material="stone" />

  <!-- The island and the lighthouse. -->
  <ellipsoid pos="1800 7250 -120" radii="1000 700 380" material="rock" />
  <box pos="1800 7200 235" size="700 700 30" material="rock" />
  <prefab source="terrain/lighthouse" pos="1800 7200 250" />
  <!-- The beam, shown only when the lamp is lit (tower.blks shows the lamp room itself). -->
  <group name="Beam" pos="1800 7200 -5000"><cone pos="-400 -1500 1850" rot="0 0 165" radius="40" radiusTop="420" height="3000" color="1.0 0.92 0.60" unlit="1" castShadow="0" /></group>

  <!-- The village: cottages facing the bay, boats on the shingle, the pier. -->
  <prefab source="terrain/house" pos="-1500 -700 40" rot="0 0 180" />
  <prefab source="terrain/house" pos="-900 -760 40" rot="0 0 184" />
  <prefab source="terrain/house" pos="-300 -700 40" rot="0 0 178" />
