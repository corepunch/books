  <camera name="channel-hut-night" comment="Ending: inside the ferry hut, Varya warms herself at the stove under Savely's coat" pos="883 4969 175" look="985 5273 75" fov="56" textRect="0.04 0.035 0.44 0.70" textScale="1" textRect2="0.54 0.07 0.42 0.70" textScale2="1"><transform target="Varya" pos="980 5253 40" rot="0 0 165" /><use-pose instance="Varya" name="Sit" /><transform target="Savely" pos="363 -131 0" rot="0 0 260" /><transform target="SealActor" pos="0 0 -3000" rot="0 0 0" /><transform target="Sea" pos="0 0 8" /></camera>
