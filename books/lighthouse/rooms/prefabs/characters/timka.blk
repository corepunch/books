<!-- Timka, eleven, the fisherman's son: blue cap, grey jacket, rubber boots.
     One shared human skeleton: body frame Z up, faces local -Y, left is +X; about
     139 cm tall. Every human uses the same bone names (spine, hem, neck, head, left_/right_ arm,
     forearm, hand, thigh, shin, foot) so the scene poses work on all of them. -->
<prefab>
  <bone name="spine" aim="0 90" segments="2" length="39.1" radius="11.3 8.8" material="timka_coat">
    <bone name="hem" at="0.12" from="0 -90" sink="10.3" aim="0 -90" length="12.4" radius="11.8 9.3" taper="1.25" material="timka_coat" />
    <bone name="neck" aim="0 90" length="5.2" radius="4.1" material="timka_skin">
      <bone name="head" aim="0 90" length="19.5" radius="9.7 10.0" material="timka_skin">
        <sphere on="0 85" at="0.66" radius="10.3" scale="1 1 0.55" material="timka_hat" />
        <sphere on="0 20" at="0.85" radius="8.0" scale="1 1 0.25" material="timka_hat" />
        <sphere on="18 10" at="0.45" radius="1.3" material="timka_eye" />
        <sphere on="-18 10" at="0.45" radius="1.3" material="timka_eye" />
        <sphere on="0 -5" at="0.38" radius="1.4" material="timka_skin" />
      </bone>
    </bone>
    <bone name="left_arm" at="0.92" from="90 0" aim="10 -85" length="21.6" radius="4.3 4.1" mirror="1" material="timka_coat">
      <bone name="left_forearm" aim="0 -90" length="19.6" radius="3.7" material="timka_coat">
        <bone name="left_hand" aim="0 -90" length="7.2" radius="3.1 2.1" material="timka_skin" />
      </bone>
    </bone>
    <bone name="left_thigh" at="0.02" from="90 -40" aim="0 -90" length="31.9" radius="6.2 6.7" mirror="1" material="timka_legs">
      <bone name="left_shin" aim="0 -90" length="30.9" radius="4.4" material="timka_boots">
        <bone name="left_foot" foot="1" aim="0 -6" length="13.4" radius="3.7 2.9" material="timka_boots" />
      </bone>
    </bone>
  </bone>
</prefab>
